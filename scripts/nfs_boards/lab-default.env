# Example board profile for nfs_share_autonomy.sh --board-profile lab-default
# Copy this file and edit IPs for each board.

# Board SSH target pieces (script builds FIREFLY_HOST=BOARD_USER@BOARD_IP)
BOARD_USER=firefly
BOARD_IP=192.168.234.1

# Or set full target instead:
# FIREFLY_HOST=firefly@192.168.234.1

# This PC's address as seen by the board (leave empty to auto-detect)
# HOST_IP=192.168.234.50

# NFS allow list (must cover the board)
CLIENT_NET=192.168.234.0/24

# Paths on the board
MOUNT_POINT=/home/firefly/autonomy
WS_LOCAL=/home/firefly/autonomy_ws

# Optional SSH key
# FIREFLY_SSH_KEY=/home/you/.ssh/id_ed25519
