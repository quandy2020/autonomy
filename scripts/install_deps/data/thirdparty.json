{
  "scripts": [
    "install_gtest.sh",
    "install_glog.sh",
    "install_gflags.sh",
    "install_protobuf.sh",
    "install_grpc.sh",
    "install_gperftools.sh",
    "install_opencv.sh",
    "install_ceres_solver.sh",
    "install_g2o.sh",
    "install_fbow.sh",
    "install_nlohmann.sh",
    "install_osqp.sh",
    "install_behaviortree_cpp.sh",
    "install_python_modules.sh",
    "install_adolc.sh",
    "install_ipopt.sh",
    "install_taskflow.sh",
    "install_assimp.sh",
    "install_ogre.sh"
  ],
  "force_scripts": [
    "install_gtest.sh",
    "install_glog.sh",
    "install_gflags.sh",
    "install_protobuf.sh",
    "install_grpc.sh",
    "install_ceres_solver.sh",
    "install_nlohmann.sh",
    "install_osqp.sh",
    "install_g2o.sh",
    "install_fbow.sh",
    "install_behaviortree_cpp.sh"
  ],
  "skip_checks": {
    "install_gtest.sh": {
      "paths": ["/usr/local/lib/libgtest.a"],
      "force": true
    },
    "install_glog.sh": {
      "paths": ["/usr/local/lib/libglog.so"],
      "force": true
    },
    "install_gflags.sh": {
      "paths": ["/usr/local/lib/libgflags.so"],
      "force": true
    },
    "install_protobuf.sh": {
      "force": true,
      "protoc_version": {
        "protoc": "/usr/local/bin/protoc",
        "lib_dir": "/usr/local/lib",
        "lib_glob": "libprotobuf*.so*",
        "version_contains": "3.19."
      }
    },
    "install_grpc.sh": {
      "paths": ["/usr/local/lib/libgrpc++.so"],
      "executable": "grpc_cpp_plugin",
      "force": true
    },
    "install_gperftools.sh": {
      "paths": [
        "/usr/local/lib/libtcmalloc.so",
        "/usr/lib/libtcmalloc.so",
        "/usr/lib/aarch64-linux-gnu/libtcmalloc.so"
      ]
    },
    "install_opencv.sh": {
      "paths": [
        "/usr/local/lib/libopencv_core.so",
        "/usr/lib/aarch64-linux-gnu/libopencv_core.so",
        "/usr/lib/x86_64-linux-gnu/libopencv_core.so"
      ]
    },
    "install_ceres_solver.sh": {
      "paths": ["/usr/local/lib/libceres.so"],
      "force": true
    },
    "install_g2o.sh": {
      "paths": ["/usr/local/lib/cmake/g2o/g2oConfig.cmake"],
      "force": true
    },
    "install_fbow.sh": {
      "paths": ["/usr/local/lib/libfbow.so"],
      "force": true
    },
    "install_nlohmann.sh": {
      "paths": [
        "/usr/local/include/nlohmann/json.hpp",
        "/usr/include/nlohmann/json.hpp"
      ],
      "force": true
    },
    "install_osqp.sh": {
      "paths": [
        "/usr/local/lib/libosqp.so",
        "/usr/local/lib64/libosqp.so"
      ],
      "force": true
    },
    "install_behaviortree_cpp.sh": {
      "paths": ["/usr/local/lib/libbehaviortree_cpp.so"],
      "force": true
    },
    "install_taskflow.sh": {
      "paths": [
        "/usr/local/include/taskflow/taskflow.hpp",
        "/usr/local/share/cmake/Taskflow/TaskflowConfig.cmake"
      ]
    },
    "install_adolc.sh": {
      "paths": [
        "/usr/include/adolc/adolc.h",
        "/usr/local/include/adolc/adolc.h"
      ]
    },
    "install_ipopt.sh": {
      "paths": [
        "/usr/include/coin/IpIpoptApplication.hpp",
        "/usr/include/coin-or/IpIpoptApplication.hpp"
      ]
    },
    "install_assimp.sh": {
      "paths": [
        "/usr/local/lib/libassimp.so",
        "/usr/lib/x86_64-linux-gnu/libassimp.so"
      ]
    },
    "install_ogre.sh": {
      "paths": [
        "/usr/local/lib/libOgreMain.so",
        "/usr/lib/x86_64-linux-gnu/libOgreMain.so"
      ]
    }
  }
}
