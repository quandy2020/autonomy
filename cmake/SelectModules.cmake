include_guard(GLOBAL)

function(autonomy_resolve_modules requested available defaults)
  set(projects automsgs autolink autodriver automanip autoviz)
  set(deps_autodriver automsgs autolink)
  set(deps_automanip automsgs autolink)
  if(NOT DEFINED AUTOMANIP_BUILD_PLANNING OR AUTOMANIP_BUILD_PLANNING)
    list(APPEND deps_automanip autonomy/transform)
  endif()
  set(deps_autoviz automsgs autolink)
  if(AUTONOMY_BUILD_COVERAGE)
    list(APPEND deps_autoviz autonomy/task)
  endif()

  # autonomy_proto is shared. Keep its full schema even for a single domain.
  set(deps_common automsgs autolink)
  set(deps_map autonomy/transform)
  set(deps_control autonomy/map)
  set(deps_localization autonomy/transform)
  set(deps_perception autonomy/map)
  set(deps_planning autonomy/map)
  set(deps_sensor autonomy/control)
  set(deps_task autonomy/planning autonomy/control)
  set(deps_system autonomy/task)
  set(deps_bridge autonomy/system)

  set(pending ${requested})
  set(domain_modules ${available})
  list(TRANSFORM domain_modules PREPEND "autonomy/")
  set(resolved "")
  set(selected_projects "")
  set(selected_domains "")
  while(pending)
    list(POP_FRONT pending module)
    if(module IN_LIST resolved)
      continue()
    endif()
    list(APPEND resolved "${module}")
    if(module STREQUAL "autonomy")
      foreach(domain IN LISTS defaults)
        if(NOT domain STREQUAL "bridge" OR BUILD_GRPC)
          list(APPEND pending "autonomy/${domain}")
        endif()
      endforeach()
    elseif(module IN_LIST projects)
      list(APPEND selected_projects "${module}")
      list(APPEND pending ${deps_${module}})
    elseif(module IN_LIST domain_modules)
      string(REPLACE "autonomy/" "" domain "${module}")
      if(domain STREQUAL "bridge" AND NOT BUILD_GRPC)
        message(FATAL_ERROR "autonomy/bridge requires BUILD_GRPC=ON")
      endif()
      list(APPEND selected_domains "${domain}")
      if(NOT domain STREQUAL "common")
        list(APPEND pending autonomy/common)
      endif()
      list(APPEND pending ${deps_${domain}})
    else()
      message(FATAL_ERROR "Unknown build module '${module}'. Supported modules: ${projects};autonomy;${domain_modules}")
    endif()
  endwhile()
  list(SORT selected_domains)
  set(AUTONOMY_ENABLED_MODULES "${selected_domains}" PARENT_SCOPE)
  set(AUTONOMY_SELECTED_PROJECTS "${selected_projects}" PARENT_SCOPE)
endfunction()
