  <!-- IMU Drivers -->
  <!-- MPU6050 Driver -->
  <class name="autonomy_driver/imu/mpu6050" 
         type="autonomy::driver::sensor::imu::Mpu6050Driver" 
         base_class="autonomy::driver::sensor::imu::ImuBase">
    <description>MPU6050 IMU driver plugin</description>
  </class>
</library>
