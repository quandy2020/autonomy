  <!-- RealSense D435i Driver -->
  <class name="autonomy_driver/camera/realsense_d435i" 
         type="autonomy::driver::sensor::camera::RealSenseD435iDriver" 
         base_class="autonomy::driver::sensor::camera::CameraBase">
    <description>RealSense D435i camera driver plugin</description>
