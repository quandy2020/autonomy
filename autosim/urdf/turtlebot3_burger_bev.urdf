<?xml version="1.0"?>
<!--
  TurtleBot3 Burger with a 6-camera BEV rig for autosim.

  Camera joints are fixed to base_link. xyz is meters (x forward, y left,
  z up). rpy yaw is about +Z, left positive. bev.yaml reads these mounts;
  it does not repeat them.

  Geometry and frames follow ROBOTIS turtlebot3_description (Humble):
  https://github.com/ROBOTIS-GIT/turtlebot3/tree/humble/turtlebot3_description

  Uses primitive shapes instead of package:// meshes so Habitat / CI can load
  without downloading STL assets. Swap in official meshes if needed for visuals.
-->
<robot name="turtlebot3_burger_bev">

  <!-- ===================== Links ===================== -->

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.14"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.14 0.14 0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.028"/>
      <inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="2.0e-05"/>
    </inertial>
  </link>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.028"/>
      <inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="2.0e-05"/>
    </inertial>
  </link>

  <link name="caster_back_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06"/>
    </inertial>
  </link>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1.0e-07" ixy="0.0" ixz="0.0" iyy="1.0e-07" iyz="0.0" izz="1.0e-07"/>
    </inertial>
  </link>

  <!-- LDS-01 2D lidar; frame matches common /scan conventions -->
  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.035"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.011" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.114"/>
      <inertia ixx="1.0e-04" ixy="0.0" ixz="0.0" iyy="1.0e-04" iyz="0.0" izz="1.0e-04"/>
    </inertial>
  </link>

  <!-- Alias frame for autosim default laser_link -->
  <link name="laser_link"/>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="1.0e-04" ixy="0.0" ixz="0.0" iyy="1.0e-04" iyz="0.0" izz="1.0e-04"/>
    </inertial>
  </link>

  <!-- ===================== Joints ===================== -->

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <!-- Wheel separation 0.160 m, radius 0.033 m (ROBOTIS Burger) -->
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.08 0.023" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.08 0.023" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.068" rpy="0 0 0"/>
  </joint>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.032 0 0.5" rpy="0 0 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_scan"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- 6-camera ring, radius 0.4 m, height 1.2 m, 60° spacing. -->
  <link name="cam_front"/>
  <link name="cam_front_left"/>
  <link name="cam_rear_left"/>
  <link name="cam_rear"/>
  <link name="cam_rear_right"/>
  <link name="cam_front_right"/>

  <joint name="cam_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_front"/>
    <origin xyz="0.40 0 1.20" rpy="0 0 0"/>
  </joint>
  <joint name="cam_front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_front_left"/>
    <origin xyz="0.20 0.34641016151 1.20" rpy="0 0 1.0471975512"/>
  </joint>
  <joint name="cam_rear_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_rear_left"/>
    <origin xyz="-0.20 0.34641016151 1.20" rpy="0 0 2.09439510239"/>
  </joint>
  <joint name="cam_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_rear"/>
    <origin xyz="-0.40 0 1.20" rpy="0 0 3.14159265359"/>
  </joint>
  <joint name="cam_rear_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_rear_right"/>
    <origin xyz="-0.20 -0.34641016151 1.20" rpy="0 0 4.18879020479"/>
  </joint>
  <joint name="cam_front_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_front_right"/>
    <origin xyz="0.20 -0.34641016151 1.20" rpy="0 0 5.23598775598"/>
  </joint>

</robot>
