<?xml version="1.0"?>
<!--
  TurtleBot3 Burger — autosim URDF with ROBOTIS visual meshes.

  Geometry / frames follow turtlebot3_description (Humble, Apache-2.0):
  https://github.com/ROBOTIS-GIT/turtlebot3/tree/humble/turtlebot3_description

  Visuals: meshes/*.stl (mm units → scale 0.001). Collisions stay primitives
  for fast Habitat / PhysX. BEV variant: six cam_* mounts for surround. Extra camera_link for autosim RGB-D.
-->
<robot name="turtlebot3_burger_bev">

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="light_black">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="-0.032 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/bases/burger_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>
    <collision>
      <origin xyz="-0.032 0 0.070" rpy="0 0 0"/>
      <geometry>
        <box size="0.140 0.140 0.143"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.82573504"/>
      <inertia ixx="0.0022124416" ixy="-1.2294101e-05" ixz="3.4938785e-05"
               iyy="0.0021193702" iyz="-5.0120904e-06" izz="0.0020064271"/>
    </inertial>
  </link>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02849894"/>
      <inertia ixx="1.117558e-05" ixy="0" ixz="0" iyy="1.1192413e-05" iyz="0" izz="2.0712558e-05"/>
    </inertial>
  </link>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02849894"/>
      <inertia ixx="1.117558e-05" ixy="0" ixz="0" iyy="1.1192413e-05" iyz="0" izz="2.0712558e-05"/>
    </inertial>
  </link>

  <link name="caster_back_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06"/>
    </inertial>
  </link>

  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1.0e-07" ixy="0.0" ixz="0.0" iyy="1.0e-07" iyz="0.0" izz="1.0e-07"/>
    </inertial>
  </link>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.114"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <link name="laser_link"/>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="1.0e-04" ixy="0.0" ixz="0.0" iyy="1.0e-04" iyz="0.0" izz="1.0e-04"/>
    </inertial>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.010" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.08 0.023" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.08 0.023" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <joint name="caster_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_link"/>
    <origin xyz="-0.081 0 -0.004" rpy="-1.57079632679 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.032 0 0.068" rpy="0 0 0"/>
  </joint>

  <!-- Official LDS height (was incorrectly 0.5 m) -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.032 0 0.172" rpy="0 0 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_scan"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0 0.20" rpy="0 0 0"/>
  </joint>


  <!-- 6-camera ring, radius 0.4 m, height 1.2 m, 60° spacing. -->
  <link name="cam_front"/>
  <link name="cam_front_left"/>
  <link name="cam_rear_left"/>
  <link name="cam_rear"/>
  <link name="cam_rear_right"/>
  <link name="cam_front_right"/>

  <joint name="cam_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_front"/>
    <origin xyz="0.40 0 1.20" rpy="0 0 0"/>
  </joint>
  <joint name="cam_front_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_front_left"/>
    <origin xyz="0.20 0.34641016151 1.20" rpy="0 0 1.0471975512"/>
  </joint>
  <joint name="cam_rear_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_rear_left"/>
    <origin xyz="-0.20 0.34641016151 1.20" rpy="0 0 2.09439510239"/>
  </joint>
  <joint name="cam_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_rear"/>
    <origin xyz="-0.40 0 1.20" rpy="0 0 3.14159265359"/>
  </joint>
  <joint name="cam_rear_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_rear_right"/>
    <origin xyz="-0.20 -0.34641016151 1.20" rpy="0 0 4.18879020479"/>
  </joint>
  <joint name="cam_front_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cam_front_right"/>
    <origin xyz="0.20 -0.34641016151 1.20" rpy="0 0 5.23598775598"/>
  </joint>

</robot>
