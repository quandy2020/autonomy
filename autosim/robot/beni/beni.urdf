<?xml version="1.0" encoding="utf-8"?>
<!--
  BENI — wheeled-biped balance robot for autosim.

  Geometry / meshes from Open Beni (MIT):
  https://github.com/open-beni/open-beni (assets/beni_base)

  Visual OBJ meshes are Y-up exports; origins bake the standing pose
  (L1/R1≈0.3, L2/R2≈0.5, base≈0.11 m). Autosim motion uses planar
  /cmd_vel (unicycle) with wheel_separation≈0.16 m; full RL balancing
  lives in open-beni and is optional via habitat.policy ONNX.

  Autosim additions: base_footprint, camera_link (RGB-D), imu_link,
  laser_link (nav scan mount on head).
-->
<robot name="beni">

  <material name="mat_beni">
    <color rgba="0.92 0.92 0.92 1"/>
  </material>
  <material name="dark">
    <color rgba="0.15 0.15 0.15 1"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Standing height H_REF ≈ 0.11 m (wheel contact → base_link). -->
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.026830109 -0.00097765393 -0.00069670388" rpy="0 0 0"/>
      <mass value="0.60837039"/>
      <inertia ixx="0.0005842953" ixy="4.5142416e-5" ixz="-1.617345e-5"
               iyy="0.0017198711" iyz="2.7632628e-6" izz="0.0016573369"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.11" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="meshes/VIS_base_link_00_BASE_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="-0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.08 0.07"/>
      </geometry>
    </collision>
  </link>

  <link name="head_intermediate">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>

  <joint name="head_yaw_joint" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="head_intermediate"/>
    <axis xyz="0 0 1"/>
    <limit lower="-5.20" upper="5.20" effort="0.1" velocity="400.0"/>
  </joint>

  <link name="head">
    <inertial>
      <origin xyz="0.0057515429 -3.3763402e-5 0.030715794" rpy="0 0 0"/>
      <mass value="0.22713973"/>
      <inertia ixx="0.00021585924" ixy="-1.4175017e-7" ixz="-8.9132373e-7"
               iyy="0.00023532522" iyz="1.6379191e-7" izz="0.00035076542"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.1469" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="meshes/VIS_head_00_HEAD_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.12 0.07"/>
      </geometry>
    </collision>
  </link>

  <joint name="head_roll_joint" type="revolute">
    <origin xyz="0 0 0.0369" rpy="0 0 0"/>
    <parent link="head_intermediate"/>
    <child link="head"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.05" upper="0.05" effort="1000.0" velocity="1000.0"/>
  </joint>

  <link name="L1_Link">
    <inertial>
      <origin xyz="-0.0082306816 -0.0057820163 0.00085013488" rpy="0 0 0"/>
      <mass value="0.26100817"/>
      <inertia ixx="0.00010581644" ixy="3.2467542e-5" ixz="6.1594071e-6"
               iyy="0.00016271403" iyz="-1.2252857e-5" izz="0.00018314794"/>
    </inertial>
    <visual>
      <origin xyz="-0.0325072227328 -0.048 -0.105087013804" rpy="1.57079632679 0.3 0"/>
      <geometry>
        <mesh filename="meshes/VIS_L1_Link_00_L1_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="-0.03 0.02 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.03 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="L1" type="revolute">
    <origin xyz="0 0.048 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="L1_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.5307" upper="6.8940" effort="1.375" velocity="209"/>
  </joint>

  <link name="L2_Link">
    <inertial>
      <origin xyz="0.00016609656 0.0051969298 -0.062290378" rpy="0 0 0"/>
      <mass value="0.08287119"/>
      <inertia ixx="7.0858589e-5" ixy="9.7216964e-8" ixz="-5.9912454e-7"
               iyy="7.5826249e-5" iyz="8.7535112e-6" izz="1.3020969e-5"/>
    </inertial>
    <visual>
      <origin xyz="-0.0174783906666 -0.072 -0.110197525731" rpy="1.57079632679 0.8 0"/>
      <geometry>
        <mesh filename="meshes/VIS_L2_Link_00_L1_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="0 -0.0035 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.065"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.075" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="L2" type="revolute">
    <origin xyz="-0.07 0.024 0" rpy="0 0 0"/>
    <parent link="L1_Link"/>
    <child link="L2_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.7853981633974483" upper="1.1344640137963142" effort="3.6" velocity="149"/>
  </joint>

  <link name="LW_Link">
    <inertial>
      <origin xyz="2.2944409e-5 0.01067511 0.00017766532" rpy="0 0 0"/>
      <mass value="0.076978199"/>
      <inertia ixx="2.4617683e-5" ixy="-1.6383694e-8" ixz="7.8264342e-9"
               iyy="3.9531034e-5" iyz="-1.4443679e-7" izz="2.4625466e-5"/>
    </inertial>
    <visual>
      <origin xyz="-0.0174783906667 -0.08 -0.0351975257305" rpy="1.57079632679 0.8 0"/>
      <geometry>
        <mesh filename="meshes/VIS_LW_Link_00_LW_VIS.obj"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0.013 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.021" radius="0.038"/>
      </geometry>
    </collision>
  </link>

  <joint name="LW" type="continuous">
    <origin xyz="0 0.008 -0.075" rpy="0 0 0"/>
    <parent link="L2_Link"/>
    <child link="LW_Link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="0.6" velocity="400"/>
  </joint>

  <link name="R1_Link">
    <inertial>
      <origin xyz="-0.0082306816 0.0057820163 0.00085013488" rpy="0 0 0"/>
      <mass value="0.26100817"/>
      <inertia ixx="0.00010581644" ixy="-3.2467542e-5" ixz="6.1594071e-6"
               iyy="0.00016271403" iyz="1.2252857e-5" izz="0.00018314794"/>
    </inertial>
    <visual>
      <origin xyz="-0.0325072227328 0.048 -0.105087013804" rpy="1.57079632679 0.3 0"/>
      <geometry>
        <mesh filename="meshes/VIS_R1_Link_00_R1_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="-0.03 -0.02 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.03 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="R1" type="revolute">
    <origin xyz="0 -0.048 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="R1_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.5307" upper="6.8940" effort="1.375" velocity="209"/>
  </joint>

  <link name="R2_Link">
    <inertial>
      <origin xyz="0.00016609656 -0.0051969298 -0.062290378" rpy="0 0 0"/>
      <mass value="0.08287119"/>
      <inertia ixx="7.0858589e-5" ixy="-9.7216964e-8" ixz="-5.9912454e-7"
               iyy="7.5826249e-5" iyz="-8.7535112e-6" izz="1.3020969e-5"/>
    </inertial>
    <visual>
      <origin xyz="-0.0174783906666 0.072 -0.110197525731" rpy="1.57079632679 0.8 0"/>
      <geometry>
        <mesh filename="meshes/VIS_R2_Link_00_R2_VIS.obj"/>
      </geometry>
      <material name="mat_beni"/>
    </visual>
    <collision>
      <origin xyz="0 0.0035 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.01 0.065"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 -0.075" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="R2" type="revolute">
    <origin xyz="-0.07 -0.024 0" rpy="0 0 0"/>
    <parent link="R1_Link"/>
    <child link="R2_Link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-0.7853981633974483" upper="1.1344640137963142" effort="3.6" velocity="149"/>
  </joint>

  <link name="RW_Link">
    <inertial>
      <origin xyz="2.2944409e-5 -0.01067511 0.00017766532" rpy="0 0 0"/>
      <mass value="0.076978199"/>
      <inertia ixx="2.4617683e-5" ixy="1.6383694e-8" ixz="7.8264342e-9"
               iyy="3.9531034e-5" iyz="1.4443679e-7" izz="2.4625466e-5"/>
    </inertial>
    <visual>
      <origin xyz="-0.0174783906667 0.08 -0.0351975257305" rpy="1.57079632679 0.8 0"/>
      <geometry>
        <mesh filename="meshes/VIS_RW_Link_00_RW_VIS.obj"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 -0.013 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder length="0.021" radius="0.038"/>
      </geometry>
    </collision>
  </link>

  <joint name="RW" type="continuous">
    <origin xyz="0 -0.008 -0.075" rpy="0 0 0"/>
    <parent link="R2_Link"/>
    <child link="RW_Link"/>
    <axis xyz="0 -1 0"/>
    <limit effort="0.6" velocity="400"/>
  </joint>

  <!-- Autosim sensors (Open Beni MJCF depth_front / imu_site). -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- MJCF depth_front: pos=(0.07, 0.03, -0.016), ~86.5° VFOV @ 80×60. -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.015"/>
      </geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.03 0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.07 0.03 -0.016" rpy="0 0 0"/>
  </joint>

  <!-- Nav 2D scan mount (not in Open Beni; height ≈ head). -->
  <link name="base_scan"/>
  <link name="laser_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.05 0 0.08" rpy="0 0 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_scan"/>
    <child link="laser_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
