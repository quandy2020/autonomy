#  Usage from an external project:
#    In your CMakeLists.txt, add these lines:
#
#    find_package(autonomy REQUIRED)
#    target_link_libraries(MY_TARGET_NAME PUBLIC autonomy)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(AUTONOMY_CMAKE_DIR "@PACKAGE_AUTONOMY_CMAKE_DIR@")

set(CERES_DIR_HINTS @Ceres_DIR@)
set(AUTONOMY_HAS_GRPC @AUTONOMY_HAS_GRPC@)

if (autonomy_FIND_QUIETLY)
   set(QUIET_OR_REQUIRED_OPTION "QUIET")
elseif (autonomy_FIND_REQUIRED)
   set(QUIET_OR_REQUIRED_OPTION "REQUIRED")
else ()
   set(QUIET_OR_REQUIRED_OPTION "")
endif()

set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} ${AUTONOMY_CMAKE_DIR}/modules)

# Protobuf is part of the exported link interface (protobuf::libprotobuf).
# Reuse the same 3.19.x pinning logic as the main project before importing
# AutonomyTargets.cmake so imported targets resolve correctly.
include(EnsureProtobuf319)

if(AUTONOMY_HAS_GRPC)
  find_dependency(gRPC ${QUIET_OR_REQUIRED_OPTION})
endif()

find_dependency(Boost ${QUIET_OR_REQUIRED_OPTION} COMPONENTS iostreams)
find_dependency(PkgConfig ${QUIET_OR_REQUIRED_OPTION})
if(NOT TARGET PkgConfig::CAIRO)
  pkg_check_modules(CAIRO ${QUIET_OR_REQUIRED_OPTION} IMPORTED_TARGET cairo)
endif()
find_dependency(Taskflow ${QUIET_OR_REQUIRED_OPTION} CONFIG)

find_package(Ceres ${QUIET_OR_REQUIRED_OPTION} HINTS ${CERES_DIR_HINTS})

# Find BehaviorTree.CPP dependency
find_package(behaviortree_cpp ${QUIET_OR_REQUIRED_OPTION})

# autolink plugin_manager (INTERFACE dep of autonomy::autonomy)
if(NOT TARGET TinyXML2::TinyXML2)
  include("${AUTONOMY_CMAKE_DIR}/modules/FindTinyXML2.cmake")
endif()
if(NOT TARGET TinyXML2::TinyXML2)
  message(FATAL_ERROR "autonomy: failed to import TinyXML2::TinyXML2")
endif()

# atlas localization dependencies (PUBLIC link interface of autonomy::autonomy)
find_package(FBow ${QUIET_OR_REQUIRED_OPTION})
find_package(G2o ${QUIET_OR_REQUIRED_OPTION})
find_package(SQLite3 ${QUIET_OR_REQUIRED_OPTION})

# Include the exported targets
include("${AUTONOMY_CMAKE_DIR}/AutonomyTargets.cmake")
