@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
@AUTOCMAKE_FIND_DEPENDENCY_CALLS@

@AUTOCMAKE_TARGETS_INCLUDE@

if(TARGET @PROJECT_NAME@::@PROJECT_NAME@ AND NOT TARGET @PROJECT_NAME@::core)
  add_library(@PROJECT_NAME@::core ALIAS @PROJECT_NAME@::@PROJECT_NAME@)
endif()

@AUTOCMAKE_CONFIG_EXTRAS_BLOCK@
