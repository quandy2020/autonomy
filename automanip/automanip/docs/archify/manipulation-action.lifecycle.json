    { "id": "terminal", "label": "终端退出" }
  ],
  "states": [
    { "id": "idle", "type": "start", "label": "Idle", "sublabel": "等待目标", "lane": "main", "col": 0, "step": "01", "tag": "entry" },
    { "id": "accepted", "type": "active", "label": "Accepted", "sublabel": "Goal 已接收", "lane": "main", "col": 1, "step": "02" },
    { "id": "planning", "type": "active", "label": "Planning", "sublabel": "Pipeline::Plan", "lane": "main", "col": 2, "step": "03", "tag": "solve" },
    { "id": "executing", "type": "active", "label": "Executing", "sublabel": "TEM 跟踪", "lane": "main", "col": 3, "step": "04", "tag": "track" },
    { "id": "succeeded", "type": "success", "label": "Succeeded", "sublabel": "完成", "lane": "main", "col": 4, "step": "05", "tag": "done" },
    { "id": "aborted", "type": "failure", "label": "Aborted", "sublabel": "ErrorCode", "lane": "terminal", "col": 0, "tag": "terminal" },
    { "id": "cancelled", "type": "failure", "label": "Cancelled", "sublabel": "PREEMPTED", "lane": "terminal", "col": 1, "tag": "terminal" }
