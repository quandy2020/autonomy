  "transitions": [
    { "id": "t5", "from": "planning", "to": "aborted", "label": "plan fail", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelDy": 48 },
    { "id": "t7", "from": "executing", "to": "cancelled", "label": "preempt", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelDy": 48 }
  ],
  "cards": [
    { "dot": "cyan", "title": "前进", "items": ["Idle → Accepted → Planning → Executing → Succeeded"] },
    { "dot": "rose", "title": "终止", "items": ["规划失败 → Aborted", "Cancel / Preempt → Cancelled"] }
