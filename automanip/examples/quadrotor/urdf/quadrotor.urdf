<?xml version="1.0" ?>
<!--
  Adapted from the OCS2 quadrotor asset (Apache-2.0).
  The visual is examples/quadrotor/meshes/quadrotor.obj. The demo rewrites the
  package:// URI to that file before publishing /robot_description.
  Pose is map to base; there are no intermediate joints.
-->
<robot name="quadrotor">
  <link name="base">
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0023" ixy="0.0" ixz="0.0" iyy="0.0023" iyz="0.0" izz="0.004"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ocs2_robotic_assets/resources/quadrotor/meshes/quadrotor.obj" scale="0.4 0.4 0.4"/>
      </geometry>
      <material name="body">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
  </link>
</robot>
