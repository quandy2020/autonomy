; Height field for the legged example.
; type: flat | stairs | grid
; grid reads heightFile. The file starts with "origin_x origin_y resolution",
; then one row of heights per line (x across, y down the file).
; A String on /legged_robot/terrain can switch this at runtime: flat, stairs, or a height-file path.
terrain
{
  type            stairs
  originX        -1.5
  originY        -1.5
  resolution      0.05
  sizeX           8.0
  sizeY           3.0
  comHeight       0.575
  smoothRadius    0.25
  maxSlope        0.40

  stairs
  {
    x0            1.0
    y0           -1.0
    width         2.0
    tread         0.32
    rise          0.07
    upCount       4
    landing       0.60
    downCount     4
  }
}
