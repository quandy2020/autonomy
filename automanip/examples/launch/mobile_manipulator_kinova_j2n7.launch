<!--
  Kinova Jaco2, 7-DoF arm (j2n7s300). Fixed frame: map.
-->
<autolink>
    <module>
        <name>mobile_manipulator</name>
        <type>binary</type>
        <process_name>mobile_manipulator_demo j2n7</process_name>
        <exception_handler>respawn</exception_handler>
        <respawn_limit>3</respawn_limit>
    </module>
</autolink>
