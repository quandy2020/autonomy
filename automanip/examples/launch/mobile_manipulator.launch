<!--
  Franka Panda. Other robots: mobile_manipulator_{pr2,ridgeback,kinova,kinova_j2n7,mabi}.launch
  Publishes /robot_description, /joint_states, and /tf. Fixed frame: map.
-->
<autolink>
    <module>
        <name>mobile_manipulator</name>
        <type>binary</type>
        <process_name>mobile_manipulator_demo franka</process_name>
        <exception_handler>respawn</exception_handler>
        <respawn_limit>3</respawn_limit>
    </module>
</autolink>
