<!--
  Mabi-Mobile. Wheel-based base. Fixed frame: map.
-->
<autolink>
    <module>
        <name>mobile_manipulator</name>
        <type>binary</type>
        <process_name>mobile_manipulator_demo mabi</process_name>
        <exception_handler>respawn</exception_handler>
        <respawn_limit>3</respawn_limit>
    </module>
</autolink>
