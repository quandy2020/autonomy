<!--
  ballbot_demo. Second argument selects the solver: ddp (default) or slp.
  Publishes /robot_description, /joint_states, and /tf. Fixed frame: map.
-->
<autolink>
    <module>
        <name>ballbot</name>
        <type>binary</type>
        <process_name>ballbot_demo</process_name>
        <exception_handler>respawn</exception_handler>
        <respawn_limit>3</respawn_limit>
    </module>
</autolink>
