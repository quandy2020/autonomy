<!--
  Automanip launch file.

  The process binary loads config/automanip.yaml. Arm control starts when
  arm.enable is true and arm.backend names a registered vendor driver.

  Prerequisites:
    export AUTOMANIP_PATH=$PWD/src/autonomy/automanip
    export AUTOLINK_LAUNCH_PATH=$AUTOMANIP_PATH/launch
    export AUTOLINK_DAG_PATH=$AUTOMANIP_PATH/dag
    export AUTOLINK_LIB_PATH=$PWD/build/autonomy/lib
    export LD_LIBRARY_PATH=$PWD/build/autonomy/lib:$LD_LIBRARY_PATH
    export PATH=$PWD/build/autonomy/bin:$PATH
    autolink launch start automanip.launch
-->
<autolink>
    <module>
        <name>automanip</name>
        <type>binary</type>
        <process_name>automanip</process_name>
        <exception_handler>respawn</exception_handler>
        <respawn_limit>3</respawn_limit>
    </module>
</autolink>
