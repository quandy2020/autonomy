static constexpr const char* kGitCommit = "@BOLZA_GIT_COMMIT@";
static constexpr const char* kGitBranch = "@BOLZA_GIT_BRANCH@";
static constexpr const char* kGitCommitDate = "@BOLZA_GIT_COMMIT_DATE@";
static constexpr const char* kGitDirty = "@BOLZA_GIT_DIRTY@";
static constexpr const char* kBuildDate = "@BOLZA_BUILD_DATE@";
static constexpr const char* kBuildTime = "@BOLZA_BUILD_TIME@";
