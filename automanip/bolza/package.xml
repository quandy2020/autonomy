<?xml version="1.0"?>
<package format="3">
  <name>bolza</name>
  <version>0.1.0</version>
  <description>
    Bolza-form optimal control library (libbolza): DDP, SQP, IPM, SLP, MPC.
    Standalone CMake package; no autonomy / autocmake / autolink dependency.
  </description>
  <maintainer email="quandy2020@126.com">duyongquan</maintainer>
  <license>Apache-2.0</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>cmake</buildtool_depend>

  <build_depend>Eigen3</build_depend>
  <build_depend>Threads</build_depend>
  <build_depend>OpenMP</build_depend>

  <export>
    <build_type>cmake</build_type>
  </export>
</package>
