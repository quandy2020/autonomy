/**
 * @file conf.hpp.in
 * @brief Configure-time package constants (version.json + git via CMake).
 */

#pragma once

namespace automanip {
namespace conf {

static constexpr const char* kPackageName = "@AUTOMANIP_PACKAGE_NAME@";
static constexpr const char* kVersion = "@AUTOMANIP_VERSION@";
static constexpr const char* kFullVersion = "@AUTOMANIP_FULL_VERSION@";
static constexpr const char* kPackageDescription =
    "@AUTOMANIP_PACKAGE_DESCRIPTION@";
static constexpr const char* kGitDescribe = "@AUTOMANIP_GIT_DESCRIBE@";
static constexpr const char* kGitCommit = "@AUTOMANIP_GIT_COMMIT@";
static constexpr const char* kGitBranch = "@AUTOMANIP_GIT_BRANCH@";
static constexpr const char* kGitCommitDate = "@AUTOMANIP_GIT_COMMIT_DATE@";
static constexpr const char* kGitAuthor = "@AUTOMANIP_GIT_AUTHOR@";
static constexpr const char* kGitEmail = "@AUTOMANIP_GIT_EMAIL@";
static constexpr const char* kGitDirty = "@AUTOMANIP_GIT_DIRTY@";
static constexpr const char* kBuildDate = "@AUTOMANIP_BUILD_DATE@";
static constexpr const char* kBuildTime = "@AUTOMANIP_BUILD_TIME@";
static constexpr const char* kDefaultConfigDir = "@AUTOMANIP_DEFAULT_CONFIG_DIR@";
static constexpr const char* kInstallPrefix = "@CMAKE_INSTALL_PREFIX@";
static constexpr const char* kDefaultDistributionHome = "@CMAKE_INSTALL_PREFIX@";

}  // namespace conf
}  // namespace automanip
