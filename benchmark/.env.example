# Workspace root (monorepo)
AUTONOMY_ROOT=/workspace/autonomy

# Default experiment config (relative to benchmark/ or absolute)
BENCHMARK_CONFIG=configs/default.yaml

# Autosim backend config override
AUTOSIM_CONFIG=
ISAACLAB_PATH=/workspace/isaaclab

# Data roots
BENCHMARK_DATA_ROOT=data
BENCHMARK_LOG_DIR=data/logs
BENCHMARK_CHECKPOINT_DIR=data/checkpoints

# Autolink / process
AUTOLINK_IP=
AUTOLINK_DAG=

# Hardware HAL-in-the-loop
HIL_DEVICE=
HIL_SERIAL=
