# Host tools run on the builder; headers, libraries and packages come from target.
set(CMAKE_SYSTEM_NAME Linux)
if(NOT DEFINED CROSS_SYSROOT)
  if(DEFINED ENV{CROSS_SYSROOT})
    set(CROSS_SYSROOT "$ENV{CROSS_SYSROOT}")
  else()
    set(CROSS_SYSROOT "/sysroot")
  endif()
endif()
if(NOT IS_DIRECTORY "${CROSS_SYSROOT}/usr/include")
  message(FATAL_ERROR "Missing target headers in CROSS_SYSROOT=${CROSS_SYSROOT}")
endif()
set(CMAKE_SYSROOT "${CROSS_SYSROOT}")
set(CMAKE_C_COMPILER "${CROSS_TRIPLE}-gcc")
set(CMAKE_CXX_COMPILER "${CROSS_TRIPLE}-g++")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "${CROSS_CPU_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${CROSS_CPU_FLAGS}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CROSS_SYSROOT)
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR}
  "${CMAKE_SYSROOT}/usr/lib/${CROSS_TRIPLE}/pkgconfig:${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
