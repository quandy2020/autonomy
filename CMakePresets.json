{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "autonomy-minimal",
      "displayName": "Autonomy minimal (autocmake)",
      "description": "autocmake package: common/transform/vehicle only.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/autonomy-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FORCE_DEBUG_BUILD": "ON",
        "BUILD_TEST": "ON",
        "BUILD_DOCS": "OFF",
        "BUILD_TOOLS": "OFF",
        "BUILD_GRPC": "OFF",
        "BUILD_PROMETHEUS": "OFF",
        "BUILD_AUTOVIZ": "OFF",
        "AUTOLINK_BUILD_PYTHON": "OFF",
        "AUTOMSGS_BUILD_EXAMPLES": "OFF",
        "AUTOMSGS_BUILD_TOOLS": "OFF",
        "AUTOMSGS_BUILD_PYTHON": "OFF",
        "AUTOMSGS_BUILD_TESTS": "OFF",
        "AUTONOMY_BUILD_COMMON": "ON",
        "AUTONOMY_BUILD_TRANSFORM": "ON",
        "AUTONOMY_BUILD_MAP": "OFF",
        "AUTONOMY_BUILD_VEHICLE": "ON",
        "AUTONOMY_BUILD_PREDICTION": "OFF",
        "AUTONOMY_BUILD_CONTROL": "OFF",
        "AUTONOMY_BUILD_PLANNING": "OFF",
        "AUTONOMY_BUILD_PERCEPTION": "OFF",
        "AUTONOMY_BUILD_LOCALIZATION": "OFF",
        "AUTONOMY_BUILD_SENSOR": "OFF",
        "AUTONOMY_BUILD_TASK": "OFF",
        "AUTONOMY_BUILD_SYSTEM": "OFF",
        "AUTONOMY_BUILD_AUDIO": "OFF",
        "AUTONOMY_BUILD_BRIDGE": "OFF"
      }
    },
    {
      "name": "jdr-board",
      "displayName": "Autonomy aarch64 cross (autocmake, Release)",
      "description": "Cross-compile with aarch64-linux-gnu + SYSROOT_DIR. GUI/docs/ONNX off.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/jdr-board",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "/opt/cross/toolchain.cmake",
        "BUILD_TEST": "OFF",
        "BUILD_DOCS": "OFF",
        "BUILD_TOOLS": "ON",
        "BUILD_GRPC": "ON",
        "BUILD_PROMETHEUS": "OFF",
        "BUILD_AUTOVIZ": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Autonomy Release (autocmake)",
      "description": "Full Release configure via autocmake; companions optional via -D.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_AUTOVIZ": "OFF",
        "BUILD_DOCS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "autonomy-minimal",
      "configurePreset": "autonomy-minimal"
    },
    {
      "name": "jdr-board",
      "configurePreset": "jdr-board"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "autonomy-minimal",
      "configurePreset": "autonomy-minimal",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
