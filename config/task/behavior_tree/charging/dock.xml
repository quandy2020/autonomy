<!--
  Charging: search → navigate to dock pose → connect.
-->
<root BTCPP_format="4" main_tree_to_execute="Dock">
  <BehaviorTree ID="Dock">
    <Retry num_attempts="4" name="DockRetry">
      <Sequence name="DockSequence">
        <DockSearch/>
        <NavTfAvailable/>
        <NavComputePath goal="{dock_pose}" path="{path}" planner_id="{default_planner_id}"
                        error_code_id="{compute_path_error_code}"
                        error_msg="{compute_path_error_msg}"/>
        <NavSmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                       smoother_id="{default_smoother_id}"
                       max_smoothing_duration="1.0" check_for_collisions="false"/>
        <NavPathValid path="{path}"/>
        <NavFollowPath path="{path}" controller_id="{default_controller_id}"
                       error_code_id="{follow_path_error_code}"
                       error_msg="{follow_path_error_msg}"/>
        <ChargerVisible dock_station_id="{dock_station_id}"/>
        <DockConnect battery_target_percent="{battery_target_percent}"/>
      </Sequence>
    </Retry>
  </BehaviorTree>
</root>
