<!--
  Dock: acquire station → approach → confirm → engage.
  Acquire is OR across IrBeacon / DepthCamera / ColorCamera / LaserScan.
-->
<root BTCPP_format="4" main_tree_to_execute="Dock">
  <BehaviorTree ID="Dock">
    <RetryUntilSuccessful num_attempts="4" name="DockRetry">
      <Sequence name="DockAttempt">
        <CancelControl/>
        <ReactiveFallback name="AcquireStation">
          <DockSearch name="IrBeacon"/>
          <DockSearch name="DepthCamera"/>
          <DockSearch name="ColorCamera"/>
          <DockSearch name="LaserScan"/>
        </ReactiveFallback>
        <ReactiveFallback name="ApproachRecover">
          <Sequence name="ApproachDock">
            <TransformValid child="{robot_base_frame}" parent="{global_frame}"/>
            <PlanPath goal="{dock_pose}" path="{path}" planner_id="{default_planner_id}"
                      error_code_id="{compute_path_error_code}"
                      error_msg="{compute_path_error_msg}"/>
            <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                        smoother_id="{default_smoother_id}"
                        max_smoothing_duration="1.0" check_for_collisions="false"/>
            <PathValid path="{path}"/>
            <FollowPath path="{path}" controller_id="{default_controller_id}"
                        error_code_id="{follow_path_error_code}"
                        error_msg="{follow_path_error_msg}"/>
            <GoalReached goal="{dock_pose}" goal_reached_tol="{goal_reached_tol}"
                         robot_base_frame="{robot_base_frame}"/>
          </Sequence>
          <ForceFailure name="Recover">
            <Sequence>
              <ClearCostmap service_name="/global_costmap/clear_entirely_global_costmap"/>
              <Spin spin_dist="1.57" time_allowance="5.0" is_recovery="true"/>
            </Sequence>
          </ForceFailure>
        </ReactiveFallback>
        <ChargerVisible name="StationVisible" dock_station_id="{dock_station_id}"/>
        <DockConnect name="EngageDock" battery_target_percent="{battery_target_percent}"/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
