<!-- Person tracking consumes Shadow's validated local path directly. -->
<root BTCPP_format="4" main_tree_to_execute="FollowPerson">
  <BehaviorTree ID="FollowPerson">
    <RetryUntilSuccessful num_attempts="8" name="PersonFollowRetry">
      <Sequence name="PersonFollowSequence">
        <TargetLocked/>
        <FollowShadowPath controller_id="{default_controller_id}"
                          error_code_id="{follow_path_error_code}"
                          error_msg="{follow_path_error_msg}"/>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
