<!--
  Person tracking: higher retry, skip explicit lock check.
-->
<root BTCPP_format="4" main_tree_to_execute="FollowPerson">
  <BehaviorTree ID="FollowPerson">
    <Retry num_attempts="8" name="PersonFollowRetry">
      <Sequence name="PersonFollowSequence">
        <ComputeFollowGoal goal="{goal}"/>
        <TransformValid/>
        <PlanPath goal="{goal}" path="{path}" planner_id="{default_planner_id}"
                        error_code_id="{compute_path_error_code}"
                        error_msg="{compute_path_error_msg}"/>
        <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                       smoother_id="{default_smoother_id}"
                       max_smoothing_duration="1.0" check_for_collisions="false"/>
        <FollowPath path="{path}" controller_id="{default_controller_id}"
                       error_code_id="{follow_path_error_code}"
                       error_msg="{follow_path_error_msg}"/>
        <GoalReached goal_reached_tol="{goal_reached_tol}"/>
      </Sequence>
    </Retry>
  </BehaviorTree>
</root>
