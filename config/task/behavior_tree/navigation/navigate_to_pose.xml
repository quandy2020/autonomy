<!--
  Navigate to pose: plan once, then follow until goal.

  Continuous RateController replan was removed: it thrashed FollowPath /
  control and left sessions half-finished so later 2D Goals looked dead.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigatePose">
  <BehaviorTree ID="NavigatePose">
    <RetryUntilSuccessful num_attempts="6" name="NavigateRetry">
      <Fallback name="FollowRecover">
        <Sequence name="PlanFollow">
          <PoseReady/>
          <TransformValid child="{robot_base_frame}" parent="{global_frame}"/>
          <ServersReady/>
          <PlanPath goal="{goal}" path="{path}" planner_id="{default_planner_id}"
                    error_code_id="{compute_path_error_code}"
                    error_msg="{compute_path_error_msg}"/>
          <PathValid path="{path}"/>
          <FollowPath path="{path}" controller_id="{default_controller_id}"
                      error_code_id="{follow_path_error_code}"
                      error_msg="{follow_path_error_msg}"/>
        </Sequence>
        <ForceFailure name="Recover">
          <AlwaysSuccess/>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
