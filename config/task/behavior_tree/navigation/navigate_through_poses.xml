<!--
  Navigate through poses: cancel leftover → plan all waypoints → follow; recover then retry.
  Node IDs must match BT registrations in autonomy/task/navigation/plugins.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigationThroughPoses">
  <BehaviorTree ID="NavigationThroughPoses">
    <Retry num_attempts="4" name="ThroughPosesRetry">
      <Sequence name="Attempt">
        <NavControllerCancel/>
        <ReactiveFallback name="ThroughPosesOrRecover">
          <Sequence name="ThroughPosesPipeline">
            <NavInitialPoseReceived/>
            <NavTfAvailable child="{robot_base_frame}" parent="{global_frame}"/>
            <NavServersReady/>
            <NavComputePathThroughPoses goals="{goals}" path="{path}"
                                        planner_id="{default_planner_id}"
                                        error_code_id="{compute_path_error_code}"
                                        error_msg="{compute_path_error_msg}"/>
            <NavSmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                           smoother_id="{default_smoother_id}"
                           max_smoothing_duration="1.0" check_for_collisions="false"/>
            <NavPathValid path="{path}"/>
            <NavFollowPath path="{path}" controller_id="{default_controller_id}"
                           error_code_id="{follow_path_error_code}"
                           error_msg="{follow_path_error_msg}"/>
            <NavGoalReached goal="{goal}" goal_reached_tol="{goal_reached_tol}"
                            robot_base_frame="{robot_base_frame}"/>
          </Sequence>
          <ForceFailure name="Recover">
            <Sequence>
              <NavClearCostmap service_name="global_costmap/clear_entirely_global_costmap"/>
              <NavSpin spin_dist="1.57" time_allowance="5.0" is_recovery="true"/>
              <NavBackUp backup_dist="0.30" backup_speed="0.10" time_allowance="5.0"
                         is_recovery="true"/>
            </Sequence>
          </ForceFailure>
        </ReactiveFallback>
      </Sequence>
    </Retry>
  </BehaviorTree>
</root>
