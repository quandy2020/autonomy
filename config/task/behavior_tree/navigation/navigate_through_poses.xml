<!--
  Navigate through poses: cancel leftover → plan all waypoints → follow; recover then retry.
-->
<root BTCPP_format="4" main_tree_to_execute="NavigationThroughPoses">
  <BehaviorTree ID="NavigationThroughPoses">
    <RetryUntilSuccessful num_attempts="4" name="ThroughPosesRetry">
      <Sequence name="Attempt">
        <CancelControl/>
        <Fallback name="ThroughPosesOrRecover">
          <Sequence name="ThroughPosesPipeline">
            <PoseReady/>
            <TransformValid child="{robot_base_frame}" parent="{global_frame}"/>
            <ServersReady/>
            <PlanPoses goals="{goals}" path="{path}"
                       planner_id="{default_planner_id}"
                       error_code_id="{compute_path_error_code}"
                       error_msg="{compute_path_error_msg}"/>
            <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                        smoother_id="{default_smoother_id}"
                        max_smoothing_duration="1.0" check_for_collisions="false"/>
            <PathValid path="{path}"/>
            <FollowPath path="{path}" controller_id="{default_controller_id}"
                        error_code_id="{follow_path_error_code}"
                        error_msg="{follow_path_error_msg}"/>
            <GoalReached goal="{goal}" goal_reached_tol="{goal_reached_tol}"
                         robot_base_frame="{robot_base_frame}"/>
          </Sequence>
          <ForceFailure name="Recover">
            <Sequence>
              <ClearCostmap service_name="/global_costmap/clear_entirely_global_costmap"/>
              <Spin spin_dist="1.57" time_allowance="5.0" is_recovery="true"/>
              <BackUp backup_dist="0.30" backup_speed="0.10" time_allowance="5.0"
                      is_recovery="true"/>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </Sequence>
    </RetryUntilSuccessful>
  </BehaviorTree>
</root>
