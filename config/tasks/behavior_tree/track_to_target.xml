<!--
  基于 odom 坐标系的人体跟随行为树。

  设计思路：
  - 上游跟踪模块持续在 odom 坐标系下发布目标人体的位姿到黑板变量 {target_pose}
  - 行为树以较高频率重新规划到 {target_pose} 的路径，以实现对移动目标的跟随
  - 控制器沿最新路径跟随，从而在 odom 坐标系下实现“跟随人体”效果
-->

<root BTCPP_format="4" main_tree_to_execute="TrackToTarget">
  <BehaviorTree ID="TrackToTarget">
    <!--
      TrackToTargetPipeline:
      - ControllerSelector：选择用于执行局部轨迹的控制器（默认 FollowPath）
      - PlannerSelector：选择用于生成全局路径的规划器（默认 GridBased）
      - RateController：以固定频率（例如 5Hz）重新规划到最新的人体目标位姿
      - ComputePathToPose：根据 {target_pose} 计算路径 {path}
      - FollowPath：沿最新路径执行跟随
    -->
    <PipelineSequence name="TrackToTargetPipeline">
      <!-- 控制器选择，可通过黑板变量 {selected_controller} 动态切换不同控制器 -->
      <ControllerSelector
        selected_controller="{selected_controller}"
        default_controller="FollowPath"
        topic_name="controller_selector"/>

      <!-- 规划器选择，可通过黑板变量 {selected_planner} 动态切换不同规划器 -->
      <PlannerSelector
        selected_planner="{selected_planner}"
        default_planner="navfn_planner"
        topic_name="planner_selector"/>

      <!--
        以 5Hz 频率重新规划到最新的目标人体位姿。
        约定：
        - {target_pose}：上游模块在 odom 坐标系下写入的人体目标位姿
        - {path}：规划得到的机器人运动路径
      -->
      <RateController hz="5.0">
        <ComputePathToPose
          goal="{target_pose}"
          path="{path}"
          planner_id="{selected_planner}"
          error_code_id="{compute_path_error_code}"
          error_msg="{compute_path_error_msg}"/>
      </RateController>

      <!--
        沿最新路径执行跟随。
        - {selected_controller}：当前选中的控制器 ID
        - {follow_path_error_code}/{follow_path_error_msg}：控制器内部错误信息
      -->
      <FollowPath
        path="{path}"
        controller_id="{selected_controller}"
        error_code_id="{follow_path_error_code}"
        error_msg="{follow_path_error_msg}"/>
    </PipelineSequence>
  </BehaviorTree>
</root>


