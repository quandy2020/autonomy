<!--
  自主探索（ExploreToAnywhere）行为树。

  设计目标：
  - 机器人在环境中持续探索“任意可达区域”
  - 上游探索模块在黑板变量 {explore_goal} 中不断提供下一个探索目标（通常基于前沿/frontier）
  - 行为树负责：
      * 持续规划到最新探索目标
      * 执行路径跟随（控制器内含避障）
      * 发生失败或路径无效时自动进行恢复（清理代价地图、后退、旋转观察）
      * 电量等安全条件不满足时停止探索
-->

<root BTCPP_format="4" main_tree_to_execute="ExploreToAnywhere">
  <BehaviorTree ID="ExploreToAnywhere">

    <!--
      SafeExplore:
      - 最外层使用 RecoveryNode 做导航级恢复
      - 内部 PipelineSequence 负责一次“到某个探索目标”的任务
      - Recovery 分支负责清理代价地图、后退、旋转等安全恢复
    -->
    <RecoveryNode name="SafeExplore" number_of_retries="5">

      <!-- ========== 主探索管线 ========== -->
      <PipelineSequence name="ExplorePipeline">

        <!-- 控制器选择：可通过 {selected_controller} 切换不同控制器 -->
        <ControllerSelector
          selected_controller="{selected_controller}"
          default_controller="FollowPath"
          topic_name="controller_selector"/>

        <!-- 规划器选择：可通过 {selected_planner} 切换不同规划器 -->
        <PlannerSelector
          selected_planner="{selected_planner}"
          default_planner="navfn_planner"
          topic_name="planner_selector"/>

        <!--
          以 0.5 Hz 频率重新规划到最新探索目标 {explore_goal}：
          - {explore_goal}：上游探索模块在地图坐标系（如 map）下写入的目标位姿
          - {path}：规划得到的路径
        -->
        <RateController hz="0.5">
          <ComputePathToPose
            goal="{explore_goal}"
            path="{path}"
            planner_id="{selected_planner}"
            error_code_id="{compute_path_error_code}"
            error_msg="{compute_path_error_msg}"/>
        </RateController>

        <!-- 路径有效性检查（若无效会触发 RecoveryNode 的恢复逻辑） -->
        <IsPathValid path="{path}"/>

        <!-- 沿路径执行自主运动，控制器内执行局部避障 -->
        <FollowPath
          path="{path}"
          controller_id="{selected_controller}"
          error_code_id="{follow_path_error_code}"
          error_msg="{follow_path_error_msg}"/>

      </PipelineSequence>

      <!-- ========== 恢复与安全策略 ========== -->
      <Sequence name="ExploreRecovery">

        <!-- 清理局部与全局代价地图，移除错误/过期障碍信息 -->
        <ClearEntireCostmap service_name="local_costmap/clear_costmap"/>
        <ClearEntireCostmap service_name="global_costmap/clear_costmap"/>

        <!-- 轻微后退，避免陷入障碍或死角 -->
        <BackUp backup_dist="0.3" backup_speed="0.1"/>

        <!-- 原地旋转观察，帮助传感器更新周围环境，利于重新规划 -->
        <Spin spin_dist="1.57"/>
      </Sequence>

    </RecoveryNode>

  </BehaviorTree>
</root>


