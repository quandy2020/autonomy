"""Bazel module for the autonomy workspace (Bzlmod / BCR).

C++ library set follows ``scripts/install_deps``:
  data/thirdparty.json  — source builds (docker/install/install_*.sh)
  data/apt_packages.json — apt ``cmake_libs``

Bazel pulls the same libraries via BCR ``bazel_dep`` (hermetic).
CMake/Docker still install into /usr/local via install_deps.

Version policy
--------------
* Prefer install_* tags when BCR + Bazel 8 accept them.
* protobuf / grpc / abseil / lua: install_deps may use older tags;
  Bazel pins the BCR-compatible set (marked †).

install_deps (C++)              BCR bazel_dep (this file)             Label
------------------------------  ------------------------------------  --------------------------------
install_gtest.sh v1.17.0        googletest 1.17.0.bcr.2               @googletest//:gtest[_main]
install_glog.sh v0.6.0          glog 0.6.0                            @com_github_google_glog//:glog
install_protobuf.sh v3.19.4     protobuf 30.2 †                       @com_google_protobuf//:protobuf
install_grpc.sh v1.48.0         grpc 1.70.1 †                         @com_github_grpc_grpc//:grpc++
install_abseil.sh 20220623.0    abseil-cpp 20250814.1 †               @com_google_absl//absl/...
install_ceres_solver.sh 2.2.0   ceres-solver 2.2.0                    @ceres-solver//:ceres
vendored thirdparty/json        @autolink//:nlohmann_json             header-only
vendored thirdparty/fkYAML      @autolink//:fkYAML                    header-only
install_behaviortree_cpp 4.7.2  behaviortree_cpp 4.7.0.bcr.3          @behaviortree_cpp//:behaviortree_cpp
install_gperftools.sh 2.8       gperftools 2.18.1 †                   @gperftools//:tcmalloc
install_assimp.sh               assimp 6.0.5                          @assimp//:assimp
install_fastdds.sh              fastdds 3.4.2.bcr.1                   @fastdds//:fastdds
install_opencv.sh 4.10          @autonomy_opencv (system) ‡           //:opencv
apt libeigen3-dev               eigen 3.4.1.bcr.1                     @eigen//:eigen
apt liblua5.3-dev               lua 5.4.6 †                           @lua//:lua
apt libflann-dev                flann 1.9.2                           @flann//:flann
apt libtbb-dev                  onetbb 2023.1.0                       @onetbb//:tbb
apt libpcl-dev                  pcl 1.15.1.bcr.4                      @pcl//:common (+ …)
(re2 / grpc-java / pgv)         graph hygiene for Bazel 8             —

† Diverges from install_* — required for a consistent Bazel 8 / BCR graph.
‡ BCR opencv 4.13+/5.x forces eigen 5 + protobuf ≥33 (breaks grpc@1.70).
  Use install_deps tree via module extension (@autonomy_opencv).

Still NOT bazel_dep (no BCR):
  fbow, ipopt, ogre.

Local modules / extensions:
  //:automsgs          ← @automsgs (source, BCR protobuf) via local_path_override
  //:autolink          ← @autolink (source, BCR protobuf) via local_path_override
  //:autonomy_headers  ← generated from autonomy/**/*.proto (BCR protoc)
  //:opencv            ← @autonomy_opencv

CLI:  ./autonomy.sh deps
Lock: bazel mod deps --lockfile_mode=update
"""

module(
    name = "autonomy",
    version = "0.2.0",
    compatibility_level = 1,
)

# Siblings: build from source with BCR protobuf (not CMake 3.19 prefix *.pb.h).
bazel_dep(name = "automsgs", version = "1.0.0")
local_path_override(
    module_name = "automsgs",
    path = "automsgs",
)
bazel_dep(name = "autolink", version = "0.1.0")
local_path_override(
    module_name = "autolink",
    path = "autolink",
)

# --- BCR: build rules / platforms ---
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# --- BCR ← scripts/install_deps thirdparty.json (C++) ---

bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# install_glog.sh → v0.6.0
bazel_dep(
    name = "glog",
    version = "0.6.0",
    repo_name = "com_github_google_glog",
)

# install_protobuf.sh is v3.19.4 (CMake). Use 30.2 for Bazel: protobuf 29.x
# references absl/utility:if_constexpr (never shipped in abseil BCR releases).
# Stay below 33.x — that forces eigen 5 and breaks grpc@1.70.
bazel_dep(
    name = "protobuf",
    version = "30.2",
    repo_name = "com_google_protobuf",
)

# install_grpc.sh is v1.48.0 (CMake). Bazel uses 1.70.1 (BCR + Bazel 8).
# protobuf@30 changes UPB map `_next` to bool(key,val,iter); 1.70 still expects
# the old EntryType* iterator — patch backend_metric_parser (grpc#39568).
bazel_dep(
    name = "grpc",
    version = "1.70.1",
    repo_name = "com_github_grpc_grpc",
)
single_version_override(
    module_name = "grpc",
    version = "1.70.1",
    patch_strip = 1,
    patches = [
        "//tools/patches:grpc_170_upb_map_next.patch",
    ],
)

# Align grpc-java / protoc-gen-validate with grpc@1.70 (avoid 1.66 extension bug).
bazel_dep(name = "grpc-java", version = "1.70.0")
bazel_dep(
    name = "protoc-gen-validate",
    version = "1.2.1.bcr.1",
    repo_name = "com_envoyproxy_protoc_gen_validate",
)

# install_abseil.sh is 20220623.0 (CMake). protobuf 29 needs absl/utility:if_constexpr
# (added after 20250512); pin a BCR release that provides that target.
bazel_dep(
    name = "abseil-cpp",
    version = "20250814.1",
    repo_name = "com_google_absl",
)

# install_ceres_solver.sh → 2.2.0
bazel_dep(name = "ceres-solver", version = "2.2.0")

# install_behaviortree_cpp.sh → 4.7.2; BCR nearest 4.7.0.bcr.3
bazel_dep(name = "behaviortree_cpp", version = "4.7.0.bcr.3")

# install_gperftools.sh → 2.8; BCR nearest modern
bazel_dep(name = "gperftools", version = "2.18.1")

# install_assimp.sh (autoviz / mesh)
bazel_dep(name = "assimp", version = "6.0.5")

# install_fastdds.sh
bazel_dep(name = "fastdds", version = "3.4.2.bcr.1")

# --- BCR ← apt cmake_libs (subset with BCR modules) ---
# 3.4.1 aligns with pcl; still OK for ceres / the rest of //autonomy.
bazel_dep(name = "eigen", version = "3.4.1.bcr.1")

# apt liblua5.3-dev; BCR 5.4.6 is closest maintained pin
bazel_dep(name = "lua", version = "5.4.6")
bazel_dep(name = "flann", version = "1.9.2")
bazel_dep(name = "onetbb", version = "2023.1.0")

# apt libpcl-dev — large Boost graph; keep as optional domain dep in BUILD.
bazel_dep(name = "pcl", version = "1.15.1.bcr.4")

# Resolved with protobuf/grpc graph (Bazel 8).
bazel_dep(name = "re2", version = "2025-08-12.bcr.1")

# --- Local: CMake prefix + system OpenCV (install_deps) ---
autonomy_repositories = use_extension(
    "//tools:repositories.bzl",
    "autonomy_repositories",
)
use_repo(autonomy_repositories, "autonomy_opencv", "autonomy_prefix")
