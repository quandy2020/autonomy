"""
Bazel MODULE file for autonomy project

This is the root MODULE.bazel for the autonomy project workspace.
Since src/autonomy is the workspace root, this file manages all dependencies
for the entire autonomy project and its submodules.
"""

module(
    name = "autonomy",
    version = "1.0.0",
    compatibility_level = 1,
)

# Core Bazel rules
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_python", version = "1.0.0")

# Protocol Buffers
bazel_dep(name = "protobuf", version = "30.1", repo_name = "com_google_protobuf")

