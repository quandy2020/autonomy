<?xml version="1.0" encoding="UTF-8"?>
<!--
  driver 模块无独立进程，通常作为 system 或 mainboard DAG 中的组件运行。
  本 launch 启动 system，从而带起依赖 driver 的管线；若使用 mainboard+DAG 加载 driver 组件，请用 mainboard.launch。
-->
<autolink>
  <module>
    <name>driver</name>
    <type>binary</type>
    <process_name>autonomy.system.launcher --configuration_directory /opt/autonomy/configuration_files --configuration_basename autonomy.lua</process_name>
  </module>
</autolink>
