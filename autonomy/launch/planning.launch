<?xml version="1.0" encoding="UTF-8"?>
<!--
  planning 模块无独立进程，作为 system 的一部分运行（PlannerServer）。
  本 launch 启动 system，从而带起 planning 服务；若后续有 planning 专用二进制可替换 process_name。
-->
<autolink>
  <module>
    <name>planning</name>
    <type>binary</type>
    <process_name>autonomy.system.launcher --configuration_directory /opt/autonomy/configuration_files --configuration_basename autonomy.lua</process_name>
  </module>
</autolink>
