"""
Bazel BUILD file for autonomy/planning

This file defines rules to build the path planning system.
Uses simplified macros from tools/autonomy_module.bzl
"""

load("//autonomy/tools:autonomy_module.bzl", "autonomy_module")

package(
    default_visibility = ["//visibility:public"],
)

# Create complete module with proto and C++ library
# Note: planning has proto files in subdirectories
autonomy_module(
    name = "planning",
    has_proto = True,
    proto_glob_recursive = ["proto/**/*.proto"],
    exclude_patterns = ["proto/**"],
    deps = [
        "//autonomy/common:common",
        "//autonomy/commsgs:commsgs_cc",
    ],
    extra_deps = [
        "//autonomy/map:map",
    ],
)
