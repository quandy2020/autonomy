{
  "name": "orbisview",
  "version": "0.3.0",
  "private": true,
  "description": "OrbisView web frontend (Dreamview-aligned layout, Vite)",
  "main": "src/app.tsx",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup": "bash ./setup.sh",
    "start": "bash ./setup.sh; vite --host 127.0.0.1 --port 5173",
    "dev": "npm run start",
    "dev:all": "bash ../launch/dev.sh",
    "build": "bash ./setup.sh; tsc --noEmit && vite build",
    "build_offline": "bash ./setup.sh; tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-mosaic-component": "^7.1.0",
    "three": "^0.170.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "protobufjs": "^7.4.0",
    "protobufjs-cli": "^1.1.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
