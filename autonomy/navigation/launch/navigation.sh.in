#!/bin/sh
# CMake configures the build and install copies with their own conf location.
set -eu
navigation_bin=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
navigation_conf=${NAVIGATION_CONF_DIR:-'@NAVIGATION_DEFAULT_CONF@'}
case "$navigation_conf" in
  /*) ;;
  *) navigation_conf=$navigation_bin/$navigation_conf ;;
esac

if [ "$#" -ne 1 ]; then
    echo 'usage: navigation_launch simulation|validate|replay' >&2
    exit 2
fi
case "$1" in
  simulation) exec "$navigation_bin/navigation_simulation" "$navigation_conf" ;;
  validate) exec "$navigation_bin/navigation_node" "$navigation_conf" --validate ;;
  replay)
    : "${NAVIGATION_REPLAY_FILE:?set NAVIGATION_REPLAY_FILE to the replay input}"
    exec "$navigation_bin/navigation_replay" "$navigation_conf" < "$NAVIGATION_REPLAY_FILE"
    ;;
  *) echo 'usage: navigation_launch simulation|validate|replay' >&2; exit 2 ;;
esac
