<!-- Replay: inject recorded /navigation/observation; navigation/safety run normally. -->
<autolink>
  <module>
    <name>replay</name>
    <type>binary</type>
    <process_name>navigation_replay</process_name>
  </module>
  <module>
    <name>navigation</name>
    <dag_conf>navigation/dag/navigation.dag</dag_conf>
    <process_name>navigation</process_name>
  </module>
  <module>
    <name>safety</name>
    <dag_conf>navigation/dag/safety.dag</dag_conf>
    <process_name>safety</process_name>
  </module>
</autolink>
