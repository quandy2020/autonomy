<root BTCPP_format="4" main_tree_to_execute="NavigateWithRelocalization">
  <BehaviorTree ID="NavigateWithRelocalization">
    <Fallback>
      <Sequence>
        <CheckPoseHealth/>
        <CheckRelocalization/>
        <CheckModuleHealth/>
        <StartNavigation/>
        <CheckSafetyIntervention/>
        <WaitForGoalReached timeout_s="600"/>
      </Sequence>
      <Sequence>
        <RelocalizationTask/>
        <CheckRelocalization/>
        <StartNavigation/>
      </Sequence>
      <RequestOperatorAssist reason="relocalization_failed"/>
    </Fallback>
  </BehaviorTree>
</root>
