<root BTCPP_format="4" main_tree_to_execute="NavigateWithDoor">
  <BehaviorTree ID="NavigateWithDoor">
    <Fallback>
      <Sequence>
        <CheckPoseHealth/>
        <CheckModuleHealth/>
        <DoorTask approach="{door_approach}" pass="{door_pass}"/>
        <StartNavigation/>
        <CheckGoalReachable/>
        <CheckSafetyIntervention/>
        <WaitForGoalReached timeout_s="600"/>
      </Sequence>
      <RequestOperatorAssist reason="door_interaction_failed"/>
    </Fallback>
  </BehaviorTree>
</root>
