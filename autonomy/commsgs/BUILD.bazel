"""
Bazel BUILD file for autonomy/commsgs

This file defines rules to generate C++ and Python code from Protocol Buffer definitions.
Uses simplified macros from tools/autonomy_module.bzl
"""

load("//autonomy/tools:autonomy_module.bzl", "autonomy_module")

package(
    default_visibility = ["//visibility:public"],
)

# Create proto library and C++ bindings
autonomy_module(
    name = "commsgs",
    has_proto = True,
    proto_glob = ["proto/*.proto"],
    hdrs_glob = [
        "*.hpp",
        "impl/*.hpp",
    ],
    srcs_glob = ["*.cpp"],
    exclude_patterns = ["proto/**"],
    deps = [
        "//autonomy/common:common",
    ],
    cc_library_name = "commsgs_cc",
    py_proto = True,
)
