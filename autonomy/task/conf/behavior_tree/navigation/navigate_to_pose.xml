<!--
  Navigate-to-pose:
  - Replan at 0.25 Hz while FollowPath runs
  - Path via token-matched /plan_result, then SmoothPath (simple_smoother) on the global path
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="SafeNavigate" number_of_retries="3">
      <ReactiveFallback name="NavigateOrArrive">
        <GoalReached goal="{goal}" goal_reached_tol="{goal_reached_tol}" transform_tolerance="0.1"/>

        <Sequence name="GlobalMode">
          <InitialPoseReceived/>
          <TransformAvailable child="{robot_base_frame}" parent="{global_frame}"/>
          <PipelineSequence name="GlobalNavigatePipeline">
            <ControllerSelector
              selected_controller="{selected_controller}"
              default_controller="{default_controller_id}"
              topic_name="controller_selector"/>
            <PlannerSelector
              selected_planner="{selected_planner}"
              default_planner="{default_planner_id}"
              topic_name="planner_selector"/>
            <SmootherSelector
              selected_smoother="{selected_smoother}"
              default_smoother="{default_smoother_id}"
              topic_name="smoother_selector"/>
            <RateController hz="0.25">
              <Sequence name="PlanAndSmooth">
                <ComputePathToPose
                  goal="{goal}"
                  path="{path}"
                  planner_id="{selected_planner}"
                  error_code_id="{compute_path_error_code}"
                  error_msg="{compute_path_error_msg}" path_revision="{path_revision}"/>
                <SmoothPath
                  unsmoothed_path="{path}"
                  smoothed_path="{path}"
                  smoother_id="{selected_smoother}"
                  max_smoothing_duration="1.0"
                  check_for_collisions="true"/>
              </Sequence>
            </RateController>
            <FollowPath
              path="{path}"
              controller_id="{selected_controller}"
              error_code_id="{follow_path_error_code}"
              error_msg="{follow_path_error_msg}" path_revision="{path_revision}"/>
          </PipelineSequence>
        </Sequence>
      </ReactiveFallback>

      <RoundRobin name="NavigationRecovery">
        <BackUp backup_dist="0.55" backup_speed="0.20" time_allowance="5.0"
                disable_collision_checks="true" is_recovery="true"/>
        <ClearEntireCostmap service_name="/global_costmap/clear_entirely_global_costmap"/>
        <Spin spin_dist="0.6" time_allowance="3.0" disable_collision_checks="true"
              is_recovery="true"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
