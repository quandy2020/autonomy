<!--
  Multi-waypoint navigation:
  - Drop passed + in-collision goals before each replan
  - Stitch remaining free goals in order; SmoothPath then follow at 5 Hz replan
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateThroughPoses" number_of_retries="3">
      <PipelineSequence name="NavigateThroughPosesWithReplanning">
        <ControllerSelector
          selected_controller="{selected_controller}"
          default_controller="{default_controller_id}"
          topic_name="controller_selector"/>
        <PlannerSelector
          selected_planner="{selected_planner}"
          default_planner="{default_planner_id}"
          topic_name="planner_selector"/>
        <SmootherSelector
          selected_smoother="{selected_smoother}"
          default_smoother="{default_smoother_id}"
          topic_name="smoother_selector"/>
        <RateController hz="5.0">
          <Sequence name="PruneAndPlanThroughPoses">
            <RemovePassedGoals
              input_goals="{goals}"
              output_goals="{goals}"
              radius="0.6"
              global_frame="{global_frame}"
              robot_base_frame="{robot_base_frame}"/>
            <RemoveInCollisionGoals
              input_goals="{goals}"
              output_goals="{goals}"
              cost_threshold="253"
              consider_unknown_as_obstacle="false"/>
            <ComputePathThroughPoses
              goals="{goals}"
              path="{path}"
              planner_id="{selected_planner}"
              error_code_id="{compute_path_through_poses_error_code}"/>
            <SmoothPath
              unsmoothed_path="{path}"
              smoothed_path="{path}"
              smoother_id="{selected_smoother}"
              max_smoothing_duration="0.15"
              check_for_collisions="false"/>
          </Sequence>
        </RateController>
        <FollowPath
          path="{path}"
          controller_id="{selected_controller}"
          error_code_id="{follow_path_error_code}"
          error_msg="{follow_path_error_msg}"/>
      </PipelineSequence>
      <Sequence name="ThroughPosesRecovery">
        <Sleep msec="1500"/>
        <ClearEntireCostmap service_name="/global_costmap/clear_entirely_global_costmap"/>
      </Sequence>
    </RecoveryNode>
  </BehaviorTree>
</root>
