<!--
  Exploration navigation:
  - Plan once per short exploration goal, then let the native SanD/MPPI
    controller execute the resulting path without resetting it on every BT tick.
  - RecoveryNode keeps the standard bounded retry behavior for planning or
    following failures.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="ExplorationNavigate" number_of_retries="3">
      <Sequence name="PlanAndFollow">
          <ControllerSelector selected_controller="{selected_controller}"
                              default_controller="{default_controller_id}"
                              topic_name="controller_selector"/>
          <PlannerSelector selected_planner="{selected_planner}"
                           default_planner="{default_planner_id}"
                           topic_name="planner_selector"/>
          <SmootherSelector selected_smoother="{selected_smoother}"
                            default_smoother="{default_smoother_id}"
                            topic_name="smoother_selector"/>
          <ComputePathToPose goal="{goal}" path="{path}"
                             planner_id="{selected_planner}"
                             max_path_reuse_age="30.0"
                             error_code_id="{compute_path_error_code}"
                             error_msg="{compute_path_error_msg}"
                             path_revision="{path_revision}"/>
          <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                      smoother_id="{selected_smoother}"
                      max_smoothing_duration="1.0"
                      check_for_collisions="true"/>
          <FollowPath path="{path}" controller_id="{selected_controller}"
                      error_code_id="{follow_path_error_code}"
                      error_msg="{follow_path_error_msg}"
                      path_revision="{path_revision}"/>
      </Sequence>

      <RoundRobin name="ExplorationRecovery">
        <BackUp backup_dist="0.55" backup_speed="0.20" time_allowance="5.0"
                disable_collision_checks="true" is_recovery="true"/>
        <ClearEntireCostmap service_name="/global_costmap/clear_entirely_global_costmap"/>
        <Spin spin_dist="0.6" time_allowance="3.0"
              disable_collision_checks="true" is_recovery="true"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
