<!--
  OpenNav-style docking: optional search, then DockRobot (stage → detect →
  spiral approach → wait for charge, with internal retries).
-->
<root BTCPP_format="4" main_tree_to_execute="Dock">
  <BehaviorTree ID="Dock">
    <Sequence name="DockSequence">
      <DockRobot
        use_dock_id="{use_dock_id}"
        dock_id="{dock_station_id}"
        dock_pose="{dock_pose}"
        dock_type="{dock_type}"
        max_staging_time="{max_staging_time}"
        navigate_to_staging_pose="{navigate_to_staging_pose}"
        error_code_id="{dock_error_code}"
        error_msg="{dock_error_msg}"
        num_retries="{dock_num_retries}"
        success="{dock_success}"/>
    </Sequence>
  </BehaviorTree>
</root>
