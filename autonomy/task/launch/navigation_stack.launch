<!--
  Copyright 2026 The Openbot Authors

  Multi-process navigation stack: planning + control + task (BT orchestration).

  Prerequisites:
    - config/autonomy.lua (planning + controller sections)
    - config/task/task_options.lua (navigation BT profile)
    - Built binaries on PATH: planning, control, task
    - Built BT plugins in build/lib or AUTONOMY_BT_PLUGIN_PATH

  Dev (repo root):
    export PATH=$PWD/build/bin:$PATH
    export AUTONOMY_BT_PLUGIN_PATH=$PWD/build/lib
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/task/launch
    autolink_launch navigation_stack.launch
-->
<autolink>
    <module>
        <name>planning</name>
        <type>binary</type>
        <process_name>planning --configuration_directory=config --configuration_basename=autonomy.lua</process_name>
    </module>
    <module>
        <name>control</name>
        <type>binary</type>
        <process_name>control --configuration_directory=config --configuration_basename=autonomy.lua</process_name>
    </module>
    <module>
        <name>task</name>
        <type>binary</type>
        <process_name>task --config_directory=config</process_name>
    </module>
</autolink>
