<!--
  Copyright 2026 The Openbot Authors

  Recommended Autonomy entry: multi-process stack via autolink_launch.

  Processes:
    autonomy.monitor (same as system/launch/monitor.launch),
    planning, control, task, perception (disabled by default),
    autonomy.bridge (same as bridge/launch/bridge.launch; needs -DBUILD_GRPC=ON),
    autonomy.foxglove_bridge

  Not started here (intentional — use dedicated launches):
    localization_*, autodriver / chassis, replay / sim_fullstack

  Prerequisites:
    - system/conf/autonomy.pb.txt, task/conf/*, system/conf/monitor.pb.txt
    - bridge/conf/bridge.pb.txt when using bridge
    - PATH: build/bin

  Dev (repo root):
    export PATH=$PWD/build/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/system/launch
    autolink_launch autonomy.launch
-->
<autolink>
  <module>
    <name>monitor</name>
    <type>binary</type>
    <process_name>autonomy.monitor --conf=monitor.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>planning</name>
    <type>binary</type>
    <process_name>autonomy.planning --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>control</name>
    <type>binary</type>
    <process_name>autonomy.control --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>task</name>
    <type>binary</type>
    <process_name>autonomy.task</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>perception</name>
    <type>binary</type>
    <process_name>autonomy.perception --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>bridge</name>
    <type>binary</type>
    <process_name>autonomy.bridge --conf=bridge.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>foxglove</name>
    <type>binary</type>
    <process_name>autonomy.foxglove_bridge --foxglove_host=0.0.0.0 --foxglove_port=8765</process_name>
  </module>
</autolink>
