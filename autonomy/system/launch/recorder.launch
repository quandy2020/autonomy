<!--
  Standalone autonomy.recorder (bypass evidence capture).
  Does not start planning/control/task. Pair with autonomy.launch or an
  already-running stack. Tester full dump: recorder_full.launch / --full-dump.

  export PATH=$PWD/build/bin:$PATH
  export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/system/launch
  autolink_launch recorder.launch
-->
<autolink>
  <module>
    <name>recorder</name>
    <type>binary</type>
    <process_name>autonomy.recorder --conf=recorder.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
