<!--
  Copyright 2026 The Openbot Authors

  Example 2 — 导航（A→B / 多点）.

  Processes (同 autonomy.launch，并补上定位):
    autonomy.monitor
    autonomy.localization (Cartographer 加载已有地图)
    autonomy.planning
    autonomy.control
    autonomy.task         (navigate_to_pose / navigate_through_poses)
    autonomy.bridge       (可选远端目标；需 -DBUILD_GRPC=ON)

  Goal 通道:
    /goal_pose、/goal_poses、/cancel_navigation
    或 bridge RPC → NavigationGoal

  Prerequisites:
    - system/conf/autonomy.pb.txt, task/conf/*, system/conf/monitor.pb.txt
    - data/maps/cartographer.pbstream（先跑 examples/slam.launch 建图）
    - PATH: build/bin；map→odom→base_link TF

  Dev (repo root):
    export PATH=$PWD/build/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/system/launch
    autolink_launch examples/navigation.launch

  Do not run together with autonomy.launch / task.launch / exploration.launch.
-->
<autolink>
  <module>
    <name>monitor</name>
    <type>binary</type>
    <process_name>autonomy.monitor --conf=monitor.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>localization</name>
    <type>binary</type>
    <process_name>autonomy.localization --localization_mode=cartographer --configuration_directory=autonomy/localization/conf/cartographer --configuration_basename=autosim_2d.lua --start_trajectory_with_default_topics=true --load_state_filename=data/maps/cartographer.pbstream</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>planning</name>
    <type>binary</type>
    <process_name>autonomy.planning --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>control</name>
    <type>binary</type>
    <process_name>autonomy.control --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>task</name>
    <type>binary</type>
    <process_name>autonomy.task</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>bridge</name>
    <type>binary</type>
    <process_name>autonomy.bridge --conf=bridge.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
