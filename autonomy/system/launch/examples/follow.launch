<!--
  Copyright 2026 The Openbot Authors

  Example 3 — 跟随（目标 / 行人）.

  Processes:
    autonomy.monitor
    autonomy.localization
    autonomy.planning
    autonomy.control
    autonomy.task         (tracking: follow_target.xml / follow_person.xml)
    autonomy.perception   (目标或行人检测 → tracking goal)

  BT 默认见 task/conf/behavior_tree/tracking/；
  切换 follow_person：config/task/task_options.lua 中 tracking 的 alternate XML。

  Prerequisites:
    - system/conf/autonomy.pb.txt, task/conf/*, perception 配置
    - data/maps/cartographer.pbstream（或改用 Argus 定位）
    - PATH: build/bin

  Dev (repo root):
    export PATH=$PWD/build/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/system/launch
    autolink_launch examples/follow.launch

  Do not run together with autonomy.launch / exploration.launch.
-->
<autolink>
  <module>
    <name>monitor</name>
    <type>binary</type>
    <process_name>autonomy.monitor --conf=monitor.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>localization</name>
    <type>binary</type>
    <process_name>autonomy.localization --localization_mode=cartographer --configuration_directory=autonomy/localization/conf/cartographer --configuration_basename=autosim_2d.lua --start_trajectory_with_default_topics=true --load_state_filename=data/maps/cartographer.pbstream</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>planning</name>
    <type>binary</type>
    <process_name>autonomy.planning --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>control</name>
    <type>binary</type>
    <process_name>autonomy.control --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>task</name>
    <type>binary</type>
    <process_name>autonomy.task</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
  <module>
    <name>perception</name>
    <type>binary</type>
    <process_name>autonomy.perception --conf=autonomy.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
