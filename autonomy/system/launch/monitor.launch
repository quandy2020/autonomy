<!--
  Copyright 2026 The Openbot Authors

  Starts autonomy.monitor: periodic /proc+sysfs collection, optional Prometheus
  on :9090 (cmake -DBUILD_PROMETHEUS=ON).

  Binary: build/bin/autonomy.monitor
  Config: system/conf/monitor.pb.txt (share/autonomy/system/conf/monitor.pb.txt)

  Prerequisites:
    - system/conf/monitor.pb.txt
    - PATH includes build/bin (or install prefix bin)

  Dev (repo root):
    export PATH=$PWD/build/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/system/launch
    autolink_launch monitor.launch
    # or: autolink launch start monitor.launch

  Install:
    autolink_launch share/autonomy/system/launch/monitor.launch

  Full stack (includes monitor):
    autonomy/system/launch/autonomy.launch
-->
<autolink>
  <module>
    <name>monitor</name>
    <type>binary</type>
    <process_name>autonomy.monitor --conf=monitor.pb.txt</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
