# Loads the Fathom component in an isolated autolink mainboard process.
# Readers match autodriver Orbbec Gemini topics (see autodriver_orbbec.yaml).
module_config {
  module_library: "libfathom_component.so"
  components {
    class_name: "autonomy::perception::fathom::FathomComponent"
    config {
      name: "fathom"
      config_file_path: "conf/fathom.pb.txt"
      # Reader order must match FathomComponent's RGB, depth, CameraInfo types.
      readers {
        channel: "/camera/color/image_raw"
      }
      readers {
        channel: "/camera/depth/image_raw"
      }
      readers {
        channel: "/camera/color/camera_info"
      }
    }
  }
}
