# Loads the Hestia component in an isolated autolink mainboard process.
module_config {
  module_library: "libhestia_component.so"
  components {
    class_name: "autonomy::perception::hestia::Component"
    config {
      name: "hestia"
      config_file_path: "conf/hestia.pb.txt"
      # Reader order must match Component's RGB, depth, CameraInfo types.
      readers {
        channel: "/camera/rgb/image_raw"
      }
      readers {
        # Optional Fathom refined depth:
        # channel: "/perception/fathom/refined_depth"
        channel: "/camera/depth/image_raw"
      }
      readers {
        channel: "/camera/camera_info"
      }
    }
  }
}
