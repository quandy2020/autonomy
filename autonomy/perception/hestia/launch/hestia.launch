<!--
  Copyright 2026 The Openbot Authors

  Standalone launcher for the Hestia autolink component.

  Runtime search paths:
    AUTOLINK_DAG_PATH  Hestia source or installation root
    AUTOLINK_CONF_PATH Hestia source or installation root
    AUTOLINK_LIB_PATH  Directory containing libhestia_component.so
-->
<autolink>
  <module>
    <name>hestia</name>
    <dag_conf>dag/hestia.dag</dag_conf>
    <process_name>hestia</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
