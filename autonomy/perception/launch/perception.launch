<!--
  Copyright 2026 The Openbot Authors

  Perception stack: Base + Follow loadable components (+ optional binary).

  From src/autonomy (inside SpaceHero, cwd = /workspace/autonomy/src/autonomy):
    export PATH=/workspace/autonomy/build/autonomy/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/perception/launch
    export AUTOLINK_DAG_PATH=$PWD/autonomy:$AUTOLINK_DAG_PATH
    export AUTOLINK_CONF_PATH=$PWD/autonomy/perception:$AUTOLINK_CONF_PATH
    export AUTOLINK_LIB_PATH=/workspace/autonomy/build/autonomy/lib:$AUTOLINK_LIB_PATH
    autolink launch start perception.launch
-->
<autolink>
  <module>
    <name>base</name>
    <dag_conf>perception/base/dag/base.dag</dag_conf>
    <process_name>base</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>

  <module>
    <name>follow</name>
    <dag_conf>perception/follow/dag/follow.dag</dag_conf>
    <process_name>follow</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>

  <!-- Optional exploration / map server; comment out if unused. -->
  <module>
    <name>perception</name>
    <type>binary</type>
    <process_name>autonomy.perception --configuration_directory=config --configuration_basename=exploration_autonomy.lua</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
