<!--
  Copyright 2026 The Openbot Authors

  Starts autonomy.bridge (gRPC AutonomyService / automsgs.rpcs.*).

  Binary: build/bin/autonomy.bridge  (requires -DBUILD_GRPC=ON)
  Config: config/bridge/bridge_options.lua → include bridge/bridge.lua
  Defaults (protobuf text, docs only): share/autonomy/bridge/conf/bridge.pb.txt
  Channel map (docs only): share/autonomy/bridge/dag/bridge.dag

  Prerequisites:
    - config/bridge/bridge.lua (+ bridge_options.lua)
    - Autolink task / navigator channels already running when calling RPCs
    - PATH includes build/bin (or install prefix bin)

  Dev (repo root):
    export PATH=$PWD/build/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/bridge/launch
    autolink_launch bridge.launch
    # or: autolink launch start bridge.launch

  Install:
    autolink_launch share/autonomy/bridge/launch/bridge.launch

  Full stack (includes bridge):
    autonomy/system/launch/autonomy.launch
-->
<autolink>
  <module>
    <name>bridge</name>
    <type>binary</type>
    <process_name>autonomy.bridge --configuration_directory=config --configuration_basename=bridge/bridge_options.lua</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
