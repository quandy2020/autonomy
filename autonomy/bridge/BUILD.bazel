"""
Bazel BUILD file for autonomy/bridge

This file defines rules to build the bridge system for external communication.
Uses simplified macros from tools/autonomy_module.bzl
"""

load("//autonomy/tools:autonomy_module.bzl", "autonomy_module", "autonomy_binary")

package(
    default_visibility = ["//visibility:public"],
)

# Create complete module with proto and C++ library
autonomy_module(
    name = "bridge",
    has_proto = True,
    proto_glob = ["proto/*.proto"],
    exclude_patterns = ["proto/**", "bridge_main.cpp"],
    deps = [
        "//autonomy/common:common",
        "//autonomy/commsgs:commsgs_cc",
    ],
)

# Main executable
autonomy_binary(
    name = "bridge_main",
    srcs = ["bridge_main.cpp"],
    deps = [
        ":bridge",
        "//autonomy/common:common",
    ],
)
