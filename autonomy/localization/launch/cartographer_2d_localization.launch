<!--
  Copyright 2026 The Openbot Authors

  Cartographer pure localization: load a .pbstream map, then track with live sensors.

  Edit --load_state_filename to your map before launching.

  Dev:
    export PATH=$PWD/build/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/localization/launch
    autolink_launch cartographer_2d_localization.launch
-->
<autolink>
    <module>
        <name>cartographer_localization</name>
        <type>binary</type>
        <process_name>localization --configuration_directory=config/localization/cartographer --configuration_basename=backpack_2d_localization.lua --load_state_filename=maps/map.pbstream --load_frozen_state=true --start_trajectory_with_default_topics=true</process_name>
    </module>
    <module>
        <name>cartographer_occupancy_grid</name>
        <type>binary</type>
        <process_name>cartographer_occupancy_grid_node -resolution=0.05 -publish_period_sec=1.0 -include_frozen_submaps=true -include_unfrozen_submaps=false</process_name>
    </module>
</autolink>
