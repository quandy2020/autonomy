<!--
  Copyright 2026 The Openbot Authors

  Atlas LIO — single AtlasSystem (IMU + lidar), LocalEstimator pose authority.
  No vision YAML / vocab. Profile wires calibration + lightning preprocess.

  Expects:
    /imu      Imu
    /points   PointCloud2
    /odom     Odometry (seed T_wb; keeps map→odom stable under teleop)

  Profile: conf/atlas/profiles/lio.yaml
    - calibration_path → conf/atlas/calibration/default.yaml (T_imu_lidar)
    - lidar_config_path → conf/atlas/lightning/default.yaml
    - maps.g2p5 → OccupancyGrid on /atlas/g2p5/occupancy
    - sensors.odom enabled → /odom
    - IVox global cloud → /atlas/cloud_map (frame=map)

  Optional (already on via lio_full.yaml):
    use_lidar_loop: true   # NDT + LidarPoseGraph → SetPose + rebuild IVox

  Run with autosim (IMU + /points):
    cd /workspace/autonomy
    CONFIG=src/autonomy/autosim/config/lio.yaml src/autonomy/autosim/scripts/run.sh sim
    # other TTY: src/autonomy/autosim/scripts/run.sh teleop
    # then:
    cd /workspace/autonomy/src/autonomy
    export PATH=/workspace/autonomy/build/autonomy/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=/workspace/autonomy/src/autonomy/autonomy/localization/launch
    autolink launch start localization_lio.launch

  Stop:
    autolink launch stop localization_lio.launch
-->
<autolink>
  <module>
    <name>localization_lio</name>
    <type>binary</type>
    <process_name>autonomy.localization --localization_mode=lio --atlas_runtime_profile=autonomy/localization/conf/atlas/profiles/lio.yaml --atlas_imu_topic=/imu --atlas_lidar_topic=/points --atlas_lidar_imu_topic=/imu --atlas_wheel_topic=/odom --atlas_enable_lightning_upstream=true</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
