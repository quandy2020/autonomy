<!--
  Copyright 2026 The Openbot Authors

  Cartographer 2D backpack SLAM for the Deutsches Museum record
  (echoes_1 MultiEchoLaserScan + imu). Config: backpack_2d.lua.

  AutoSim Habitat /scan uses localization_cartographer_autosim.launch.

  From /workspace/autonomy/src/autonomy:

    mkdir -p data/maps
    export PATH=/workspace/autonomy/build/autonomy/bin:$PATH
    export AUTOLINK_LAUNCH_PATH=$PWD/autonomy/localization/launch
    autolink launch start localization_cartographer.launch

    autolink recorder play -a -r 1.0 -f \
      data/records/cartographer/cartographer_paper_deutsches_museum.record

    cd /workspace/autonomy
    ./build/autonomy/bin/autoviz \
      --config src/autonomy/autoviz/config/cartographer.autoviz

  Stop:
    autolink launch stop localization_cartographer.launch
-->
<autolink>
  <module>
    <name>localization_cartographer</name>
    <type>binary</type>
    <process_name>autonomy.localization --localization_mode=cartographer --configuration_directory=autonomy/localization/conf/cartographer --configuration_basename=backpack_2d.lua --start_trajectory_with_default_topics=true --save_state_filename=data/maps/cartographer.pbstream</process_name>
    <exception_handler>respawn</exception_handler>
    <respawn_limit>3</respawn_limit>
  </module>
</autolink>
