"""
Bazel BUILD file for autonomy/localization

This file defines rules to build the localization system.
Uses simplified macros from tools/autonomy_module.bzl

Note: cartographer/cloud has its own BUILD.bazel file.
"""

load("//autonomy/tools:autonomy_module.bzl", "autonomy_module")

package(
    default_visibility = ["//visibility:public"],
)

# Create complete module with proto and C++ library
# Note: Excludes cartographer and livo subdirectories which have separate BUILD files
autonomy_module(
    name = "localization",
    has_proto = True,
    proto_glob = ["proto/*.proto"],
    exclude_patterns = [
        "proto/**",
        "cartographer/**",
        "livo/**",
    ],
    deps = [
        "//autonomy/common:common",
        "//autonomy/commsgs:commsgs_cc",
    ],
    extra_deps = [
        "//autonomy/transform:transform",
    ],
)
