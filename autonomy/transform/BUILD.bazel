"""
Bazel BUILD file for autonomy/transform

This file defines rules to build the transform system (TF2).
Uses simplified macros from tools/autonomy_module.bzl
"""

load("//autonomy/tools:autonomy_module.bzl", "autonomy_module")

package(
    default_visibility = ["//visibility:public"],
)

# Create complete module with proto and C++ library
autonomy_module(
    name = "transform",
    has_proto = True,
    proto_glob = ["proto/*.proto"],
    exclude_patterns = [
        "proto/**",
        "urdf/**",
        "launch/**",
    ],
    deps = [
        "//autonomy/common:common",
        "//autonomy/commsgs:commsgs_cc",
    ],
)
