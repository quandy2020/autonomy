load(
    "//tools:package.bzl",
    "autonomy_module_copts",
    "autonomy_cc_library",
)

package(default_visibility = ["//visibility:public"])

autonomy_cc_library(
    name = "autonomy_vehicle",
    srcs = [
        "common/vehicle_inteface.cpp",
        "motion/kinematics_control.cpp",
        "vehicle.cpp",
        "vehicle_server.cpp",
    ],
    hdrs = [
        "common/vehicle_inteface.hpp",
        "motion/kinematics_control.hpp",
        "vehicle.hpp",
        "vehicle_server.hpp",
    ],
    copts = autonomy_module_copts("vehicle"),
    include_prefix = "autonomy/vehicle",
    deps = [
        "//autonomy/common:autonomy_common",
        "//:automsgs",
        "//:autonomy_headers",
        "@eigen//:eigen",
        "@com_github_google_glog//:glog",
        "@com_google_protobuf//:protobuf",
        "//:pthread",
    ],
)

filegroup(
    name = "runtime_data",
    srcs = glob(
        [
            "conf/**",
            "dag/**",
            "launch/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "protos",
    srcs = glob(["**/*.proto"]),
    visibility = ["//visibility:public"],
)
