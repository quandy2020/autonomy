/* panel — feature panel styles (section: <panel> or <panel>.<part>) */

/* @section time.metric_chip */
QFrame#TimeMetricChip {
  background: {{panel-bg}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section time.value_field */
QLineEdit {
  background: transparent;
  color: {{text}};
  border: none;
  padding: 0 {{space-1}}px;
  min-height: 22px;
  font-size: 12px;
  font-weight: 600;
}
/* @end */

/* @section time.check */
QCheckBox {
  color: {{muted}};
  spacing: 6px;
  background: transparent;
  padding: {{space-1}}px {{space-2}}px;
  font-size: 12px;
  font-weight: 600;
}
/* @end */

/* @section add_display.check */
QCheckBox {
  color: {{panel-muted}};
  spacing: 8px;
  background: transparent;
  padding: {{space-1}}px {{space-2}}px;
  font-size: 12px;
}
/* @end */

/* @section add_display.frosted_tree */
QTreeWidget {
  background: transparent;
  color: {{text}};
  border: none;
  outline: none;
  padding: {{space-1}}px {{space-2}}px {{space-1}}px {{space-1}}px;
  font-size: 13px;
  show-decoration-selected: 0;
}
QTreeWidget::item {
  padding: {{space-1}}px {{space-4}}px {{space-1}}px {{space-3}}px;
  min-height: 28px;
  max-height: 28px;
  border: none;
  outline: none;
  background: transparent;
}
QTreeWidget::item:hover,
QTreeWidget::item:selected,
QTreeWidget::item:selected:active,
QTreeWidget::item:focus {
  background: transparent;
  border: none;
  outline: none;
}
QTreeWidget::item:selected {
  color: {{accent}};
  font-weight: 600;
}
QTreeWidget::branch,
QTreeWidget::branch:selected,
QTreeWidget::branch:hover,
QTreeWidget::branch:selected:active {
  background: transparent;
  border: none;
}
/* Scrollbars: owned by ProxyStyle Liquid Glass painting — no QSS chrome. */
/* @end */

/* @section add_display.ghost_button */
QPushButton {
  background: {{panel-bg}};
  color: {{text}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-btn}}px;
  padding: 0 {{space-8}}px;
  min-height: 40px;
  font-weight: 600;
  font-size: 13px;
  outline: none;
}
QPushButton:hover {
  background: {{panel-surface}};
  border-color: {{accent-soft}};
  color: {{accent}};
}
QPushButton:pressed {
  background: {{accent-soft}};
}
QPushButton:focus {
  border: 1.5px solid {{accent-a40}};
  outline: none;
}
/* @end */

/* @section add_display.line_edit */
QLineEdit {
  background: {{panel-bg}};
  color: {{text}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
  padding: 0 36px 0 {{space-7}}px;
  min-height: 40px;
  font-size: 13px;
  font-weight: 500;
  selection-background-color: {{accent-soft}};
}
QLineEdit:focus {
  background: {{panel-surface}};
  border: 1.5px solid {{accent}};
}
/* @end */

/* @section add_display.name_caption */
QLabel {
  background: transparent;
  color: {{panel-muted}};
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
}
/* @end */

/* @section add_display.primary_button */
QPushButton {
  background: {{accent}};
  color: {{on-accent}};
  border: 1px solid {{accent}};
  border-radius: {{r-btn}}px;
  padding: 0 {{space-8}}px;
  min-height: 40px;
  font-weight: 700;
  font-size: 13px;
  outline: none;
}
QPushButton:hover {
  background: {{accent-pressed}};
  border-color: {{accent-pressed}};
}
QPushButton:pressed {
  background: {{accent-pressed}};
}
QPushButton:focus {
  border: 1.5px solid {{accent-pressed}};
  outline: none;
}
QPushButton:disabled {
  background: {{panel-surface}};
  color: {{muted}};
  border-color: {{panel-border}};
}
/* @end */

/* @section add_display.segment_tab_active */
QPushButton {
  background: {{accent}};
  color: {{on-accent}};
  border: 1px solid {{accent}};
  border-radius: {{r-md}}px;
  padding: 0 {{space-6}}px;
  min-height: 34px;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.3px;
}
QPushButton:hover {
  background: {{accent}};
}
/* @end */

/* @section add_display.segment_tab_inactive */
QPushButton {
  background: transparent;
  color: {{panel-muted}};
  border: 1px solid transparent;
  border-radius: {{r-md}}px;
  padding: 0 {{space-6}}px;
  min-height: 34px;
  font-weight: 600;
  font-size: 13px;
}
QPushButton:hover {
  background: {{panel-surface}};
  color: {{accent}};
}
/* @end */

/* @section add_display.segment_track */
QFrame#CreateVizSegmentTrack {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 {{panel-surface}}, stop:1 {{panel-bg}});
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section add_panel.frosted_list */
QListWidget {
  background: transparent;
  color: {{text}};
  border: none;
  outline: none;
  padding: {{space-2}}px;
  font-size: 13px;
  show-decoration-selected: 0;
}
QListWidget::item {
  padding: {{space-4}}px {{space-6}}px;
  min-height: 28px;
  border: none;
  outline: none;
  background: transparent;
}
QListWidget::item:hover,
QListWidget::item:selected,
QListWidget::item:selected:active {
  background: transparent;
  border: none;
  outline: none;
}
QListWidget::item:selected { color: {{accent}}; font-weight: 600; }
/* @end */

/* @section add_panel.ghost_button */
QPushButton {
  background: {{panel-surface}};
  color: {{accent-pressed}};
  border: 1.5px solid {{accent}};
  border-radius: {{r-btn}}px;
  padding: 0 20px;
  min-width: 96px;
  min-height: 38px;
  font-weight: 700;
  font-size: 13px;
}
QPushButton:hover {
  background: {{panel-surface}};
  border-color: {{accent-soft}};
  color: {{accent}};
}
QPushButton:pressed { background: {{accent-soft}}; }
/* @end */

/* @section add_panel.primary_button */
QPushButton {
  background: {{accent}};
  color: {{on-accent}};
  border: 1.5px solid {{accent}};
  border-radius: {{r-btn}}px;
  padding: 0 22px;
  min-width: 108px;
  min-height: 38px;
  font-weight: 700;
  font-size: 13px;
}
QPushButton:hover { background: {{accent}}; border-color: #5EEAD4; }
QPushButton:pressed { background: {{accent}}; }
QPushButton:disabled {
  background: {{accent-soft}};
  color: {{on-accent-muted}};
  border-color: {{accent-a28}};
}
/* @end */

/* @section app_settings */
/* Concat-inspired settings: gray rail, milky detail, rounded group cards. */
QDialog#AutovizAppSettingsDialog {
  background: {{panel-bg}};
}
QListWidget#AutovizSettingsSidebar {
  background: {{panel-cool}};
  border: none;
  border-right: 1px solid {{hairline-faint}};
  outline: none;
  padding: {{space-7}}px {{space-5}}px;
  font-size: 13px;
  font-weight: 600;
}
QListWidget#AutovizSettingsSidebar::item {
  height: 36px;
  margin: {{space-1}}px 0;
  padding: {{space-3}}px {{space-6}}px;
  border-radius: {{r-md}}px;
  color: {{text}};
}
QListWidget#AutovizSettingsSidebar::item:hover {
  background: {{hairline-faint}};
  color: {{text}};
}
QListWidget#AutovizSettingsSidebar::item:selected {
  background: {{hairline}};
  color: {{text}};
}
QWidget#AutovizSettingsDetail {
  background: {{panel-surface}};
}
QLabel#AutovizSettingsPageTitle {
  font-size: 22px; font-weight: 700; color: {{text}};
  background: transparent; border: none; padding: 0;
}
QFrame#AutovizSettingsGroup {
  background: {{panel-surface}};
  border: 1px solid {{hairline-faint}};
  border-radius: {{r-md}}px;
}
QLabel#AutovizSettingsRowLabel {
  color: {{text}}; font-size: 13px; font-weight: 500;
  background: transparent; border: none;
}
QLabel#AutovizSettingsAccentName {
  color: {{muted}}; font-size: 12px; font-weight: 600;
  background: transparent; border: none; padding-left: 4px;
}
QLabel#AutovizSettingsHint {
  color: {{disabled}}; font-size: 11px;
  background: transparent; border: none;
}
QFrame#AutovizSettingsFooter {
  background: {{panel-surface}};
  border: none;
  border-top: 1px solid {{hairline-faint}};
}
QToolButton#AutovizAccentCustom {
  background: {{panel-surface}};
  color: {{muted}};
  border: 1px solid {{hairline}};
  border-radius: {{r-md}}px;
  font-size: 16px;
  font-weight: 700;
  padding: 0;
}
QToolButton#AutovizAccentCustom:hover {
  background: {{accent-soft}};
  color: {{accent}};
  border-color: {{accent-a28}};
}
QCheckBox {
  color: {{text}}; font-size: 13px;
  spacing: 8px; background: transparent; border: none;
}
QComboBox, QSpinBox, QLineEdit {
  background: {{panel-surface}};
  color: {{text}};
  border: 1px solid {{hairline}};
  border-radius: {{r-md}}px;
  padding: 5px {{space-5}}px;
  min-height: 28px;
  min-width: 140px;
}
QComboBox:focus, QSpinBox:focus, QLineEdit:focus {
  border: 1.5px solid {{accent}};
  background: {{panel-surface}};
}
QPushButton {
  background: {{panel-surface}};
  color: {{text}};
  border: 1px solid {{hairline}};
  border-radius: {{r-md}}px;
  padding: {{space-3}}px {{space-7}}px;
  font-size: 13px;
  font-weight: 600;
}
QPushButton:hover { background: {{panel-surface}}; color: {{accent}}; }
QPushButton:default {
  background: {{accent}}; color: {{on-accent}}; border-color: {{accent}}; font-weight: 700;
}
QPushButton:default:hover { background: {{accent-pressed}}; border-color: {{accent-pressed}}; }
QSlider::groove:horizontal {
  height: 4px; background: {{hairline}}; border-radius: {{r-xs}}px;
}
QSlider::handle:horizontal {
  width: 16px; height: 16px; margin: -6px 0;
  background: {{panel-surface}}; border: 1px solid {{hairline-strong}};
  border-radius: {{r-sm}}px;
}
/* @end */

/* @section change_panel */
QWidget {
  background: {{panel-surface}};
  color: {{text}};
  border-radius: {{r-md}}px;
}
QToolButton {
  background: transparent;
  color: {{text}};
  border: none;
  border-radius: {{r-sm}}px;
  padding: {{space-2}}px {{space-4}}px;
  text-align: left;
}
QToolButton:hover,
QToolButton:pressed,
QToolButton:checked {
  background: {{accent-soft}};
  color: {{accent}};
}
/* @end */

/* @section channel_graph.dialog_close */
QPushButton {
  color: {{text}}; background: {{panel-surface}};
  border: 1px solid {{panel-border}}; border-radius: {{r-md}}px;
  padding: 5px {{space-7}}px; font-size: 12px; font-weight: 600;
  outline: none;
}
QPushButton:hover {
  color: {{accent}}; background: {{accent-a10}};
  border-color: {{accent-soft}};
}
/* @end */

/* @section channel_graph.dialog_name */
color: {{text}}; background: transparent; border: none;
/* @end */

/* @section channel_graph.dialog_scroll_body */
background: transparent; border: none;
/* @end */

/* @section channel_graph.entry_row_divider */
QFrame {
  background: transparent; border: none;
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section channel_graph.entry_row_top */
QFrame { background: transparent; border: none; }
/* @end */

/* @section channel_graph.entry_subtitle */
color: {{muted}}; font-size: 11px; background: transparent; border: none;
/* @end */

/* @section channel_graph.entry_title */
color: {{text}}; font-size: 13px; font-weight: 600;
background: transparent; border: none;
/* @end */

/* @section channel_graph.kind_badge */
color: {{on-accent}}; background: {{accent-color}}; border-radius: {{r-md}}px;
padding: {{space-2}}px {{space-5}}px; font-size: 11px; font-weight: 700;
/* @end */

/* @section channel_graph.metric_chip */
QFrame#PropertyMetricChip {
  background: {{panel-surface}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section channel_graph.metric_label */
color: {{muted}}; font-size: 11px; font-weight: 600;
background: transparent; border: none;
/* @end */

/* @section channel_graph.metric_value */
color: {{accent-color}}; font-size: 13px; font-weight: 700;
background: transparent; border: none;
/* @end */

/* @section channel_graph.property_dialog */
QDialog#ChannelGraphPropertyDialog {
  background: {{panel-bg}};
  color: {{text}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
QScrollArea {
  border: none; background: transparent;
}
/* @end */

/* @section channel_graph.property_header */
QFrame#ChannelGraphPropertyHeader {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
    stop:0 {{header-start}}, stop:1 {{panel-surface}});
  border: none;
  border-bottom: 1px solid {{panel-border}};
}
/* @end */

/* @section channel_graph.section_card */
QFrame#PropertySectionCard {
  background: {{panel-surface}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section channel_graph.section_count */
color: {{muted}}; background: {{panel-surface}};
border: 1px solid {{panel-border}}; border-radius: {{r-sm}}px;
padding: {{space-1}}px {{space-4}}px; font-size: 11px; font-weight: 600;
/* @end */

/* @section channel_graph.section_title */
color: {{text}}; font-size: 12px; font-weight: 700;
background: transparent; border: none;
/* @end */

/* @section channel_graph.toolbar_combo */
QComboBox {
  color: {{panel-text}}; background: {{panel-surface}};
  border: 1px solid {{panel-border}}; border-radius: {{r-sm}}px;
  padding: {{space-1}}px {{space-3}}px; min-height: 24px; font-size: 11px;
}
QComboBox:hover { border-color: {{panel-accent}}; }
QComboBox::drop-down { border: none; width: 16px; }
QComboBox QAbstractItemView {
  background: {{panel-surface}}; color: {{panel-text}}; border: 1px solid {{panel-border}};
  selection-background-color: {{accent-a14}};
}
/* @end */

/* @section channel_graph.view */
QGraphicsView { background: {{alt}}; border: none; }
/* @end */

/* @section channels.panel */
QWidget#ChannelsPanelContent {
  background: {{panel-bg}}; color: {{panel-text}};
}
QFrame#ChannelsToolbar {
  background: {{panel-surface}};
  border-bottom: 1px solid {{panel-border}};
}
QFrame#ChannelsTreeCard {
  background: {{panel-surface}};
  border: none;
}
QFrame#ChannelsFooter {
  background: {{panel-bg}};
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section channels.tree */
QTreeWidget#ChannelsTree {
  background: {{panel-surface}}; color: {{panel-text}}; border: none; outline: none;
  font-size: 12px;
}
QTreeWidget#ChannelsTree::item {
  padding: 3px {{space-3}}px; min-height: 26px;
}
QTreeWidget#ChannelsTree::item:selected {
  background: {{accent-a14}}; color: {{panel-text}};
}
QTreeWidget#ChannelsTree::item:hover {
  background: {{hairline-faint}};
}
QTreeWidget#ChannelsTree::branch {
  background: transparent;
}
QHeaderView::section {
  background: {{panel-bg}}; color: {{panel-muted}};
  border: none; border-bottom: 1px solid {{panel-border}};
  padding: 7px {{space-4}}px;
  font-size: 11px; font-weight: 700;
  text-transform: uppercase;
}
/* @end */

/* @section displays.frosted_footer */
QFrame#DisplaysFrostedFooter {
  background: {{panel-surface}};
  border: none;
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section displays.splitter */
/* No ::handle — Qt 6.2 QCss::Selector can SEGV on pseudo-elements during resize. */
QSplitter { background: transparent; }
/* @end */

/* @section image.compact_pick_button */
QPushButton {
  background: {{panel-surface}}; color: {{accent-pressed}};
  border: 1px solid {{accent}}; border-radius: {{r-sm}}px;
  padding: 0 {{space-3}}px; min-height: 0; max-height: 20px;
  font-weight: 600; font-size: 11px;
}
QPushButton:hover {
  background: {{panel-surface}}; color: {{accent}};
  border-color: {{accent-soft}};
}
QPushButton:pressed { background: {{accent-soft}}; }
/* @end */

/* @section image.overlay_card */
QFrame#{{name}} {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section image.settings_check */
QCheckBox { color: {{text}}; font-size: 12px; spacing: 8px; }
QCheckBox:hover { color: {{accent}}; }
/* @end */

/* @section image.floating_chrome */
QWidget#ImageFloatingChrome {
  background: transparent;
}
QWidget#ImageFloatingChrome QToolButton {
  color: {{text}};
  background: transparent;
  border: 1px solid transparent;
  border-radius: {{r-sm}}px;
  padding: 3px {{space-4}}px;
  font-size: 11px;
  font-weight: 600;
}
QWidget#ImageFloatingChrome QToolButton:hover {
  background: {{surface-a90}};
  border-color: {{accent-a70}};
}
QWidget#ImageFloatingChrome QToolButton:checked {
  background: {{sel-bg}};
  border-color: transparent;
  color: {{accent}};
}
QWidget#ImageFloatingChrome QLabel {
  color: {{muted}};
  background: transparent;
  font-size: 11px;
}
QWidget#ImageFloatingChrome QDoubleSpinBox,
QWidget#ImageFloatingChrome QSpinBox {
  color: {{text}};
  background: {{surface-a70}};
  border: 1px solid {{accent-a55}};
  border-radius: {{r-sm}}px;
  padding: 1px {{space-3}}px;
  font-size: 11px;
}
QWidget#ImageFloatingChrome QDoubleSpinBox::up-button,
QWidget#ImageFloatingChrome QDoubleSpinBox::down-button,
QWidget#ImageFloatingChrome QSpinBox::up-button,
QWidget#ImageFloatingChrome QSpinBox::down-button {
  width: 0;
  height: 0;
  border: none;
  background: transparent;
}
QWidget#ImageFloatingChrome QSlider::groove:horizontal {
  height: 4px;
  background: {{accent-a14}};
  border-radius: {{r-xs}}px;
}
QWidget#ImageFloatingChrome QSlider::handle:horizontal {
  width: 12px;
  margin: -5px 0;
  background: {{accent}};
  border-radius: {{r-sm}}px;
}
/* @end */

/* @section image.floating_reveal */
QToolButton#ImageFloatingReveal {
  color: transparent;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  min-width: 40px;
  max-width: 40px;
  min-height: 18px;
  max-height: 18px;
}
QToolButton#ImageFloatingReveal:hover,
QToolButton#ImageFloatingReveal:pressed,
QToolButton#ImageFloatingReveal:checked {
  background: transparent;
  border: none;
}
/* @end */

/* @section log.list_container */
QFrame { background: {{panel-surface}}; }
/* @end */

/* @section log.log_view */
LogViewWidget { background: {{panel-surface}}; }
/* @end */

/* @section log.view_widget */
LogViewWidget { background: {{panel-surface}}; }
/* @end */

/* @section plot.add_series_button */
QPushButton {
  background: {{accent}}; color: white; border: none;
  border-radius: {{r-btn}}px; font-weight: 700; font-size: 13px;
  padding: 0; min-height: 0; max-height: 22px;
}
QPushButton:hover { background: {{accent}}; }
/* @end */

/* @section plot.field_picker.title */
QLabel {
  background: transparent;
  color: {{text}};
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.1px;
  padding: 0;
  margin: 0;
}
/* @end */

/* @section plot.field_picker.caption */
QLabel {
  background: transparent;
  color: {{panel-muted}};
  font-size: 11px;
  font-weight: 600;
  padding: 0;
}
/* @end */

/* @section plot.field_picker.path */
QLabel {
  background: {{sel-bg}};
  color: {{accent}};
  border: none;
  border-radius: {{r-sm}}px;
  padding: {{space-2}}px {{space-4}}px;
  font-size: 11px;
  font-weight: 600;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
/* @end */

/* @section plot.field_picker.rail_caption */
QLabel {
  background: transparent;
  color: {{panel-muted}};
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
  padding: 0 {{space-1}}px 1px {{space-1}}px;
}
/* @end */

/* @section plot.field_picker.line_edit */
QLineEdit {
  background: {{panel-surface}};
  color: {{text}};
  border: 1px solid {{border}};
  border-radius: {{r-ctrl}}px;
  padding: 0 24px 0 {{space-4}}px;
  min-height: 26px;
  max-height: 26px;
  font-size: 11px;
  font-weight: 500;
  selection-background-color: {{sel-bg}};
}
QLineEdit:focus {
  border: 1.5px solid {{accent}};
  background: {{panel-surface}};
}
/* @end */

/* @section plot.field_picker.channel_list */
QListWidget {
  background: transparent;
  color: {{text}};
  border: none;
  outline: none;
  padding: 0;
  font-size: 11px;
  show-decoration-selected: 0;
}
QListWidget::item {
  padding: 0;
  min-height: 22px;
  max-height: 22px;
  border: none;
  outline: none;
  background: transparent;
}
QListWidget::item:hover,
QListWidget::item:selected {
  background: transparent;
}
/* @end */

/* @section plot.field_picker.field_list */
QListWidget {
  background: transparent;
  color: {{text}};
  border: none;
  outline: none;
  padding: 0;
  font-size: 11px;
  show-decoration-selected: 0;
}
QListWidget::item {
  padding: 0;
  min-height: 22px;
  max-height: 22px;
  border: none;
  outline: none;
  background: transparent;
}
QListWidget::item:hover,
QListWidget::item:selected {
  background: transparent;
}
/* @end */

/* @section plot.field_picker.ghost_button */
QPushButton {
  background: {{panel-surface}};
  color: {{text}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-btn}}px;
  padding: 0 {{space-6}}px;
  min-height: 28px;
  max-height: 28px;
  font-weight: 600;
  font-size: 11px;
  outline: none;
}
QPushButton:hover {
  background: {{hover}};
  border-color: transparent;
  color: {{accent}};
}
QPushButton:pressed {
  background: {{sel-bg}};
}
/* @end */

/* @section plot.field_picker.primary_button */
QPushButton {
  background: {{accent}};
  color: {{on-accent}};
  border: 1px solid {{accent}};
  border-radius: {{r-btn}}px;
  padding: 0 {{space-6}}px;
  min-height: 28px;
  max-height: 28px;
  font-weight: 700;
  font-size: 11px;
  outline: none;
}
QPushButton:hover {
  background: {{accent-pressed}};
  border-color: {{accent-pressed}};
  color: {{on-accent}};
}
QPushButton:disabled {
  background: {{panel-surface}};
  color: {{disabled}};
  border-color: {{panel-border}};
}
/* @end */

/* @section plot.color_swatch */
background:{{color}}; border:1px solid palette(mid); border-radius: {{r-xs}}px;
/* @end */

/* @section plot.segmented_toggle_inline */
QWidget#plot_segmented_toggle {
  background: {{surface-a85}}; border: 1px solid {{border}};
  border-radius: {{r-ctrl}}px; padding: 3px;
}
QWidget#plot_segmented_toggle QPushButton {
  border: none; padding: 4px 10px; background: transparent;
  border-radius: {{r-sm}}px; color: {{muted}}; font-weight: 600; font-size: 12px;
  min-height: 22px; max-height: 22px;
}
QWidget#plot_segmented_toggle QPushButton:checked {
  background: {{sel-bg}}; color: {{accent}}; font-weight: 700;
}
QWidget#plot_segmented_toggle QPushButton:hover {
  background: {{hover}}; color: {{accent}};
}
/* @end */

/* @section plot.series_card */
QFrame#plot_series_card {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: {{r-sm}}px;
}
/* @end */

/* @section plot.series_title */
font-weight: 600; font-size: 11px; color: {{accent}};
/* @end */

/* @section publish.action_vline */
background: {{panel-border}};
/* @end */

/* @section publish.advanced_check */
QCheckBox {
  color: {{muted}};
  spacing: 6px;
  background: transparent;
  font-size: 12px;
  font-weight: 600;
}
/* @end */

/* @section publish.field_label */
color: {{muted}}; font-size: 11px; font-weight: 600;
/* @end */

/* @section publish.field_tree */
QTreeWidget {
  background: transparent;
  alternate-background-color: transparent;
  color: {{text}};
  border: none;
  outline: none;
  show-decoration-selected: 0;
}
QTreeWidget::item {
  padding: 3px {{space-4}}px;
  min-height: 26px;
  border: none;
  outline: none;
  background: transparent;
}
QTreeWidget::item:hover {
  background: {{accent-a10}};
  border-radius: {{r-sm}}px;
}
QTreeWidget::item:selected {
  background: {{accent-a16}};
  color: {{accent}};
  border-radius: {{r-sm}}px;
}
QHeaderView::section {
  background: {{panel-bg}};
  color: {{muted}};
  border: none;
  border-bottom: 1px solid {{panel-border}};
  border-right: 1px solid {{panel-border}};
  padding: {{space-3}}px {{space-5}}px;
  font-size: 11px;
  font-weight: 700;
}
/* @end */

/* @section publish.ghost_text_button */
QPushButton {
  color: {{accent}}; background: transparent; border: none;
  border-radius: {{r-sm}}px; padding: 4px 10px; font-weight: 600; font-size: 12px;
  outline: none;
}
QPushButton:hover { background: {{accent-a10}}; color: {{accent-pressed}}; }
QPushButton:disabled { color: {{muted}}; }
/* @end */

/* @section publish.icon_chip_button */
QPushButton {
  background: {{panel-bg}}; color: {{text}};
  border: 1px solid {{panel-border}}; border-radius: {{r-btn}}px;
  font-size: 13px; font-weight: 700; padding: 0;
  outline: none;
}
QPushButton:hover {
  background: {{panel-surface}}; color: {{accent}}; border-color: {{accent-soft}};
}
QPushButton:pressed { background: {{accent-soft}}; }
QPushButton:disabled {
  color: {{muted}}; background: {{panel-bg}}; border-color: {{panel-border}};
}
/* @end */

/* @section publish.json_editor */
QPlainTextEdit {
  background: {{editor-bg}}; color: {{text}};
  border: 1px solid {{panel-border}}; border-radius: {{r-md}}px;
  padding: {{space-4}}px;
  selection-background-color: {{accent-a22}};
}
/* @end */

/* @section publish.panel_chrome */
QWidget#PublishEditorContent {
  background: transparent; color: {{text}};
}
QFrame#PublishToolbar, QFrame#PublishCollectionBar {
  background: {{panel-bg}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
QFrame#PublishTreeCard {
  background: {{panel-bg}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
}
QGroupBox {
  background: {{panel-bg}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
  margin-top: {{space-5}}px;
  padding: {{space-7}}px {{space-5}}px {{space-5}}px {{space-5}}px;
  font-weight: 600;
  color: {{text}};
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 {{space-3}}px;
  color: {{muted}};
}
QTabWidget::pane {
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
  background: {{panel-bg}};
  top: -1px;
}
QTabBar::tab {
  background: transparent;
  color: {{muted}};
  padding: 7px {{space-7}}px;
  margin-right: {{space-1}}px;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: {{accent}};
  border-bottom: 2px solid {{accent}};
}
QTabBar::tab:hover { color: {{text}}; }
/* @end */

/* @section publish.panel_root */
PublishPanel, QWidget#PublishPanelContent {
  background: transparent; color: {{text}};
}
/* @end */

/* @section publish.publish_once_button */
QPushButton {
  background: {{btn-bg}}; color: {{on-accent}};
  border: 1px solid {{btn-bg}}; border-radius: {{r-btn}}px;
  padding: 0 {{space-8}}px; min-height: {{h-btn}}px; font-weight: 700; font-size: 13px;
  outline: none;
}
QPushButton:hover { background: {{btn-hover}}; border-color: {{btn-hover}}; }
QPushButton:pressed { background: {{btn-bg}}; }
QPushButton:disabled {
  background: {{panel-surface}}; color: {{muted}}; border-color: {{panel-border}};
}
/* @end */

/* @section publish.toolbar_combo */
QComboBox {
  background: {{panel-surface}}; color: {{text}};
  border: 1px solid {{panel-border}}; border-radius: {{r-md}}px;
  padding: {{space-1}}px {{space-4}}px; min-height: 28px; max-height: 32px;
  font-size: 12px;
}
QComboBox:hover { border-color: {{accent-soft}}; }
QComboBox:focus {
  border: 1.5px solid {{accent}};
  background: {{surface-a96}};
}
QComboBox::drop-down {
  subcontrol-origin: padding; subcontrol-position: center right;
  border: none; width: 18px;
}
QComboBox QLineEdit {
  background: transparent; border: none; color: {{text}};
  padding: 0px {{space-1}}px; min-height: 0px; max-height: 26px;
  selection-background-color: {{accent-a16}};
  selection-color: {{accent}};
}
QComboBox QAbstractItemView {
  background: {{surface-a96}}; color: {{text}};
  border: 1px solid {{panel-border}};
  selection-background-color: {{accent-a16}};
  selection-color: {{accent}};
  outline: none;
}
/* @end */

/* @section publish.toolbar_spin */
QDoubleSpinBox {
  background: {{panel-surface}}; color: {{text}};
  border: 1px solid {{panel-border}}; border-radius: {{r-md}}px;
  padding: {{space-1}}px {{space-3}}px; min-height: 28px; max-height: 32px;
  font-size: 12px;
}
QDoubleSpinBox:focus {
  border: 1.5px solid {{accent}};
  background: {{surface-a96}};
}
/* @end */

/* @section publish.empty_hint */
QLabel {
  color: {{muted}};
  background: {{panel-bg}};
  border: 1px solid {{panel-border}};
  border-radius: {{r-md}}px;
  padding: {{space-7}}px 18px;
  font-size: 12px;
  font-weight: 500;
}
/* @end */

/* @section raw_messages.panel */
QWidget#RawMessagesPanelContent {
  background: {{panel-bg}}; color: {{panel-text}};
}
QFrame#RawMessagesToolbar {
  background: {{panel-surface}};
  border-bottom: 1px solid {{panel-border}};
}
QFrame#RawMessagesTreeCard {
  background: {{panel-surface}};
  border: none;
}
QFrame#RawMessagesFooter {
  background: {{panel-bg}};
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section raw_messages.tree */
QTreeWidget#RawMessagesTree {
  background: {{panel-surface}}; color: {{panel-text}}; border: none; outline: none;
  font-size: 12px;
}
QTreeWidget#RawMessagesTree::item {
  padding: {{space-1}}px {{space-3}}px; min-height: 24px;
}
QTreeWidget#RawMessagesTree::item:selected {
  background: {{accent-a14}}; color: {{panel-text}};
}
QTreeWidget#RawMessagesTree::item:hover {
  background: {{hairline-faint}};
}
QTreeWidget#RawMessagesTree::branch {
  background: transparent;
}
QHeaderView::section {
  background: {{panel-bg}}; color: {{panel-muted}};
  border: none; border-bottom: 1px solid {{panel-border}};
  padding: 7px {{space-4}}px;
  font-size: 11px; font-weight: 700;
}
/* @end */

/* @section service.call_button */
QPushButton { font-weight: 600; padding: 4px 16px; }
/* @end */

/* @section service.call_button_custom */
QPushButton {
  background: {{btn-bg}}; color: palette(button-text); border: none;
  border-radius: {{r-xs}}px; padding: 6px 12px; font-weight: 600;
}
QPushButton:hover { background: {{btn-hover}}; }
QPushButton:disabled { background: palette(mid); color: palette(midlight); }
/* @end */

/* @section service.call_button_palette */
QPushButton {
  background: palette(highlight); color: palette(highlighted-text);
  border: none; border-radius: {{r-xs}}px; padding: 6px 12px; font-weight: 600;
}
QPushButton:hover { background: palette(highlight); }
QPushButton:disabled { background: palette(mid); color: palette(midlight); }
/* @end */

/* @section service.plain_editor */
QPlainTextEdit { background: palette(alternate-base); }
/* @end */

/* @section teleop.arcade_card */
QFrame#TeleopArcadeCard {
  background: {{surface-a42}};
  border: 1px solid {{border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section teleop.axis_combo */
QComboBox {
  background: {{surface-a85}}; color: {{text}};
  border: 1px solid {{border}}; border-radius: {{r-sm}}px;
  padding: 3px {{space-3}}px; min-height: 22px;
}
QComboBox:focus { border-color: {{accent}}; }
/* @end */

/* @section teleop.axis_name */
color: {{accent}}; font-size: 11px; font-weight: 700;
/* @end */

/* @section teleop.axis_row */
QFrame#TeleopAxisRow {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: {{r-sm}}px;
}
/* @end */

/* @section teleop.axis_spin */
QDoubleSpinBox {
  background: {{surface-a85}}; color: {{text}};
  border: 1px solid {{border}}; border-radius: {{r-sm}}px;
  padding: 3px {{space-3}}px; min-height: 22px;
}
QDoubleSpinBox:focus { border-color: {{accent}}; color: {{accent}}; }
/* @end */

/* @section teleop.control_root */
QWidget#TeleopControlContent {
  background: {{wash}}; color: {{text}};
}
/* @end */

/* @section teleop.estop */
QPushButton {
  background: {{danger-filled}};
  border: 1px solid {{danger-filled}};
  border-radius: {{r-md}}px;
  color: white;
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 1.2px;
  padding: {{space-4}}px {{space-8}}px;
}
QPushButton:hover {
  background: {{danger-filled-hover}}; border-color: {{danger-filled-hover}};
}
QPushButton:pressed {
  background: {{danger-filled-pressed}}; border-color: {{danger-filled-pressed}};
}
/* @end */

/* @section teleop.header */
QFrame#TeleopHeader {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section teleop.hint */
color: {{muted}}; font-size: 11px; font-weight: 600; letter-spacing: 0.2px;
/* @end */

/* @section teleop.mapping_header */
color: {{muted}}; font-size: 11px; font-weight: 700; letter-spacing: 1.0px;
/* @end */

/* @section teleop.mode_segment */
QFrame#TeleopModeSegment {
  background: {{surface-a96}};
  border: 1px solid {{border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section teleop.mode_toggle */
QToolButton {
  background: transparent; color: {{muted}};
  border: none; border-radius: {{r-sm}}px;
  padding: {{space-3}}px {{space-5}}px; font-weight: 700; font-size: 11px;
}
QToolButton:checked {
  background: {{sel-bg}}; color: {{accent}};
}
QToolButton:hover {
  background: {{hover}}; color: {{accent}};
}
/* @end */

/* @section teleop.pad_caption */
color: {{muted}}; font-size: 11px; font-weight: 700; letter-spacing: 0.6px;
/* @end */

/* @section teleop.panel_root */
TeleopPanel, QWidget#TeleopPanelContent {
  background: {{wash}}; color: {{text}};
}
/* @end */

/* @section teleop.settings_form_check */
QCheckBox { color: {{text}}; font-size: 12px; spacing: 8px; }
QCheckBox:hover { color: {{accent}}; }
/* @end */

/* @section teleop.settings_form_label */
color: {{muted}}; font-size: 11px; font-weight: 600;
/* @end */

/* @section teleop.settings_speed_caption */
color: {{muted}}; font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
/* @end */

/* @section teleop.settings_speed_card */
QFrame#TeleopSettingsSpeedCard {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section teleop.settings_speed_spin */
QDoubleSpinBox {
  background: transparent; color: {{text}};
  border: none; padding: 0; font-weight: 600; font-size: 12px;
}
QDoubleSpinBox:focus { color: {{accent}}; }
/* @end */

/* @section teleop.smart_check */
QCheckBox {
  color: {{muted}}; font-size: 11px; font-weight: 700;
  spacing: 6px; padding: 4px 8px;
  background: {{panel-surface}};
  border: 1px solid {{border}}; border-radius: {{r-md}}px;
}
QCheckBox:checked {
  color: {{accent}}; background: {{accent-soft}};
  border-color: {{accent}};
}
/* Indicator painted by ProxyStyle — QSS backgrounds hide the checkmark. */
QCheckBox:disabled { color: {{muted}}; }
/* @end */

/* @section teleop.speed_caption */
color: {{muted}}; font-size: 11px; font-weight: 700; letter-spacing: 1.6px;
/* @end */

/* @section teleop.speed_card */
QFrame#TeleopSpeedCard {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: {{r-md}}px;
}
/* @end */

/* @section teleop.speed_rule */
background: {{border}}; border: none;
/* @end */

/* @section teleop.speed_spin */
QDoubleSpinBox {
  background: transparent; color: {{text}};
  border: none; padding: 0;
  font-weight: 300; font-size: 22px;
  font-family: 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif;
}
QDoubleSpinBox:focus { color: {{accent}}; }
/* @end */

/* @section teleop.speed_unit */
color: {{muted}}; font-size: 11px; font-weight: 600; letter-spacing: 0.6px;
/* @end */

/* @section teleop.step_button */
QToolButton {
  background: rgba(248,250,252,0.95); color: {{muted}};
  border: 1px solid {{border}}; border-radius: {{r-btn}}px;
  font-size: 16px; font-weight: 500;
}
QToolButton:hover {
  background: {{accent}}; color: white; border-color: {{accent}};
}
QToolButton:pressed {
  background: {{panel-accent-pressed}}; color: white; border-color: {{panel-accent-pressed}};
}
/* @end */

