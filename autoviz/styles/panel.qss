/* panel — feature panel styles (section: <panel> or <panel>.<part>) */

/* @section time.metric_chip */
QFrame#TimeMetricChip {
  background: {{glass-fill}};
  border: 1px solid {{glass-rim}};
  border-radius: 10px;
}
/* @end */

/* @section time.value_field */
QLineEdit {
  background: transparent;
  color: {{text}};
  border: none;
  padding: 0 2px;
  min-height: 22px;
  font-size: 12px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
/* @end */

/* @section time.check */
QCheckBox {
  color: {{muted}};
  spacing: 6px;
  background: transparent;
  padding: 2px 4px;
  font-size: 12px;
  font-weight: 600;
}
/* @end */

/* @section add_display.check */
QCheckBox {
  color: {{panel-muted}};
  spacing: 8px;
  background: transparent;
  padding: 2px 4px;
  font-size: 12px;
}
/* @end */

/* @section add_display.frosted_tree */
QTreeWidget {
  background: transparent;
  color: {{text}};
  border: none;
  outline: none;
  padding: 2px 4px 2px 2px;
  font-size: 13px;
  show-decoration-selected: 0;
}
QTreeWidget::item {
  padding: 2px 8px 2px 6px;
  min-height: 28px;
  max-height: 28px;
  border: none;
  outline: none;
  background: transparent;
}
QTreeWidget::item:hover,
QTreeWidget::item:selected,
QTreeWidget::item:selected:active,
QTreeWidget::item:focus {
  background: transparent;
  border: none;
  outline: none;
}
QTreeWidget::item:selected {
  color: {{accent}};
  font-weight: 600;
}
QTreeWidget::branch,
QTreeWidget::branch:selected,
QTreeWidget::branch:hover,
QTreeWidget::branch:selected:active {
  background: transparent;
  border: none;
}
/* Scrollbars: owned by ProxyStyle Liquid Glass painting — no QSS chrome. */
/* @end */

/* @section add_display.ghost_button */
QPushButton {
  background: {{glass-fill}};
  color: {{text}};
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
  padding: 0 16px;
  min-height: 40px;
  font-weight: 600;
  font-size: 13px;
  outline: none;
}
QPushButton:hover {
  background: {{glass-deep}};
  border-color: {{accent-soft}};
  color: {{accent}};
}
QPushButton:pressed {
  background: {{accent-soft}};
}
QPushButton:focus {
  border: 1.5px solid {{accent-a40}};
  outline: none;
}
/* @end */

/* @section add_display.line_edit */
QLineEdit {
  background: {{glass-fill}};
  color: {{text}};
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
  padding: 0 36px 0 14px;
  min-height: 40px;
  font-size: 13px;
  font-weight: 500;
  selection-background-color: {{accent-soft}};
}
QLineEdit:focus {
  background: {{glass-deep}};
  border: 1.5px solid {{accent}};
}
/* @end */

/* @section add_display.name_caption */
QLabel {
  background: transparent;
  color: {{panel-muted}};
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.6px;
}
/* @end */

/* @section add_display.primary_button */
QPushButton {
  background: {{accent}};
  color: #FFFFFF;
  border: 1px solid {{accent}};
  border-radius: 12px;
  padding: 0 16px;
  min-height: 40px;
  font-weight: 700;
  font-size: 13px;
  outline: none;
}
QPushButton:hover {
  background: {{accent-pressed}};
  border-color: {{accent-pressed}};
}
QPushButton:pressed {
  background: {{accent-pressed}};
}
QPushButton:focus {
  border: 1.5px solid {{accent-pressed}};
  outline: none;
}
QPushButton:disabled {
  background: {{glass-deep}};
  color: {{muted}};
  border-color: {{glass-rim}};
}
/* @end */

/* @section add_display.segment_tab_active */
QPushButton {
  background: {{accent}};
  color: #FFFFFF;
  border: 1px solid {{accent}};
  border-radius: 11px;
  padding: 0 12px;
  min-height: 34px;
  font-weight: 700;
  font-size: 13px;
  letter-spacing: 0.3px;
}
QPushButton:hover {
  background: {{accent}};
}
/* @end */

/* @section add_display.segment_tab_inactive */
QPushButton {
  background: transparent;
  color: {{panel-muted}};
  border: 1px solid transparent;
  border-radius: 11px;
  padding: 0 12px;
  min-height: 34px;
  font-weight: 600;
  font-size: 13px;
}
QPushButton:hover {
  background: rgba(255,255,255,0.55);
  color: {{accent}};
}
/* @end */

/* @section add_display.segment_track */
QFrame#CreateVizSegmentTrack {
  background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 rgba(241,245,249,0.90), stop:1 rgba(226,232,240,0.55));
  border: 1px solid {{panel-border}};
  border-radius: 14px;
}
/* @end */

/* @section add_panel.frosted_list */
QListWidget {
  background: transparent;
  color: {{text}};
  border: none;
  outline: none;
  padding: 4px;
  font-size: 13px;
  show-decoration-selected: 0;
}
QListWidget::item {
  padding: 8px 12px;
  min-height: 28px;
  border: none;
  outline: none;
  background: transparent;
}
QListWidget::item:hover,
QListWidget::item:selected,
QListWidget::item:selected:active {
  background: transparent;
  border: none;
  outline: none;
}
QListWidget::item:selected { color: {{accent}}; font-weight: 600; }
/* @end */

/* @section add_panel.ghost_button */
QPushButton {
  background: rgba(255,255,255,0.70);
  color: {{accent-pressed}};
  border: 1.5px solid {{accent}};
  border-radius: 19px;
  padding: 0 20px;
  min-width: 96px;
  min-height: 38px;
  font-weight: 700;
  font-size: 13px;
}
QPushButton:hover {
  background: rgba(255,255,255,0.92);
  border-color: {{accent-soft}};
  color: {{accent}};
}
QPushButton:pressed { background: rgba(224,242,254,0.80); }
/* @end */

/* @section add_panel.primary_button */
QPushButton {
  background: {{accent}};
  color: #FFFFFF;
  border: 1.5px solid {{accent}};
  border-radius: 19px;
  padding: 0 22px;
  min-width: 108px;
  min-height: 38px;
  font-weight: 700;
  font-size: 13px;
}
QPushButton:hover { background: {{accent}}; border-color: #5EEAD4; }
QPushButton:pressed { background: {{accent}}; }
QPushButton:disabled {
  background: {{accent-soft}};
  color: rgba(255,255,255,0.55);
  border-color: {{accent-a28}};
}
/* @end */

/* @section app_settings */
QDialog#AutovizAppSettingsDialog {
  background: #F5F5F7;
}
QListWidget#AutovizSettingsSidebar {
  background: #ECEEF0;
  border: none;
  border-right: 1px solid rgba(0,0,0,0.08);
  outline: none;
  padding: 10px 8px;
  font-size: 13px;
}
QListWidget#AutovizSettingsSidebar::item {
  height: 32px;
  margin: 1px 0;
  padding: 4px 10px;
  border-radius: 8px;
  color: #1D1D1F;
}
QListWidget#AutovizSettingsSidebar::item:hover {
  background: rgba(0,0,0,0.05);
}
QListWidget#AutovizSettingsSidebar::item:selected {
  background: {{accent-soft}};
  color: {{accent}};
}
QWidget#AutovizSettingsDetail {
  background: #F5F5F7;
}
QLabel#AutovizSettingsPageTitle {
  font-size: 22px; font-weight: 700; color: #1D1D1F;
  background: transparent; border: none; padding: 0;
}
QFrame#AutovizSettingsGroup {
  background: #FFFFFF;
  border: 1px solid rgba(0,0,0,0.06);
  border-radius: 10px;
}
QLabel#AutovizSettingsRowLabel {
  color: #1D1D1F; font-size: 13px;
  background: transparent; border: none;
}
QLabel#AutovizSettingsHint {
  color: #86868B; font-size: 11px;
  background: transparent; border: none;
}
QFrame#AutovizSettingsFooter {
  background: #F5F5F7;
  border: none;
  border-top: 1px solid rgba(0,0,0,0.08);
}
QCheckBox {
  color: #1D1D1F; font-size: 13px;
  spacing: 8px; background: transparent; border: none;
}
QComboBox, QSpinBox, QLineEdit {
  background: #FFFFFF;
  color: #1D1D1F;
  border: 1px solid rgba(0,0,0,0.12);
  border-radius: 6px;
  padding: 4px 8px;
  min-height: 24px;
}
QComboBox:focus, QSpinBox:focus, QLineEdit:focus {
  border: 1px solid {{accent-teal}};
}
QPushButton {
  background: #FFFFFF;
  color: #1D1D1F;
  border: 1px solid rgba(0,0,0,0.12);
  border-radius: 6px;
  padding: 5px 12px;
  font-size: 13px;
}
QPushButton:hover { background: #F5F5F7; }
QPushButton:default {
  background: {{accent-teal}}; color: #FFFFFF; border-color: {{accent-teal}}; font-weight: 600;
}
QPushButton:default:hover { background: {{accent}}; }
QSlider::groove:horizontal {
  height: 4px; background: rgba(0,0,0,0.10); border-radius: 2px;
}
QSlider::handle:horizontal {
  width: 16px; height: 16px; margin: -6px 0;
  background: #FFFFFF; border: 1px solid rgba(0,0,0,0.18);
  border-radius: 8px;
}
/* @end */

/* @section change_panel */
QWidget {
  background: rgba(247,250,249,0.96);
  color: {{text}};
  border-radius: 10px;
}
QToolButton {
  background: transparent;
  color: {{text}};
  border: none;
  border-radius: 6px;
  padding: 4px 8px;
  text-align: left;
}
QToolButton:hover,
QToolButton:pressed,
QToolButton:checked {
  background: {{accent-soft}};
  color: {{accent}};
}
/* @end */

/* @section channel_graph.dialog_close */
QPushButton {
  color: {{text}}; background: rgba(255,255,255,0.88);
  border: 1px solid {{glass-rim}}; border-radius: 10px;
  padding: 5px 14px; font-size: 12px; font-weight: 600;
  outline: none;
}
QPushButton:hover {
  color: {{accent}}; background: {{accent-a10}};
  border-color: {{accent-soft}};
}
/* @end */

/* @section channel_graph.dialog_name */
color: {{text}}; background: transparent; border: none;
/* @end */

/* @section channel_graph.dialog_scroll_body */
background: transparent; border: none;
/* @end */

/* @section channel_graph.entry_row_divider */
QFrame {
  background: transparent; border: none;
  border-top: 1px solid {{glass-rim}};
}
/* @end */

/* @section channel_graph.entry_row_top */
QFrame { background: transparent; border: none; }
/* @end */

/* @section channel_graph.entry_subtitle */
color: {{muted}}; font-size: 11px; background: transparent; border: none;
/* @end */

/* @section channel_graph.entry_title */
color: {{text}}; font-size: 13px; font-weight: 600;
background: transparent; border: none;
/* @end */

/* @section channel_graph.kind_badge */
color: #FFFFFF; background: {{accent-color}}; border-radius: 10px;
padding: 4px 10px; font-size: 11px; font-weight: 700;
/* @end */

/* @section channel_graph.metric_chip */
QFrame#PropertyMetricChip {
  background: rgba(255,255,255,0.78);
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
}
/* @end */

/* @section channel_graph.metric_label */
color: {{muted}}; font-size: 11px; font-weight: 600;
background: transparent; border: none;
/* @end */

/* @section channel_graph.metric_value */
color: {{accent-color}}; font-size: 14px; font-weight: 700;
background: transparent; border: none;
/* @end */

/* @section channel_graph.property_dialog */
QDialog#ChannelGraphPropertyDialog {
  background: {{glass-fill}};
  color: {{text}};
  border: 1px solid {{glass-rim}};
  border-radius: 14px;
}
QScrollArea {
  border: none; background: transparent;
}
/* @end */

/* @section channel_graph.property_header */
QFrame#ChannelGraphPropertyHeader {
  background: qlineargradient(x1:0,y1:0,x2:1,y2:1,
    stop:0 {{header-start}}, stop:1 {{glass-deep}});
  border: none;
  border-bottom: 1px solid {{glass-rim}};
}
/* @end */

/* @section channel_graph.section_card */
QFrame#PropertySectionCard {
  background: rgba(255,255,255,0.72);
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
}
/* @end */

/* @section channel_graph.section_count */
color: {{muted}}; background: {{glass-deep}};
border: 1px solid {{glass-rim}}; border-radius: 9px;
padding: 2px 8px; font-size: 11px; font-weight: 600;
/* @end */

/* @section channel_graph.section_title */
color: {{text}}; font-size: 12px; font-weight: 700;
background: transparent; border: none;
/* @end */

/* @section channel_graph.toolbar_combo */
QComboBox {
  color: {{panel-text}}; background: {{panel-surface}};
  border: 1px solid {{panel-border}}; border-radius: 7px;
  padding: 2px 6px; min-height: 24px; font-size: 11px;
}
QComboBox:hover { border-color: {{panel-accent}}; }
QComboBox::drop-down { border: none; width: 16px; }
QComboBox QAbstractItemView {
  background: {{panel-surface}}; color: {{panel-text}}; border: 1px solid {{panel-border}};
  selection-background-color: {{accent-a14}};
}
/* @end */

/* @section channel_graph.view */
QGraphicsView { background: {{alt}}; border: none; }
/* @end */

/* @section channels.panel */
QWidget#ChannelsPanelContent {
  background: {{panel-bg}}; color: {{panel-text}};
}
QFrame#ChannelsToolbar {
  background: {{panel-surface}};
  border-bottom: 1px solid {{panel-border}};
}
QFrame#ChannelsTreeCard {
  background: {{panel-surface}};
  border: none;
}
QFrame#ChannelsFooter {
  background: {{panel-bg}};
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section channels.tree */
QTreeWidget#ChannelsTree {
  background: {{panel-surface}}; color: {{panel-text}}; border: none; outline: none;
  font-size: 12px;
}
QTreeWidget#ChannelsTree::item {
  padding: 3px 6px; min-height: 26px;
}
QTreeWidget#ChannelsTree::item:selected {
  background: {{accent-a14}}; color: {{panel-text}};
}
QTreeWidget#ChannelsTree::item:hover {
  background: rgba(15,23,42,0.04);
}
QTreeWidget#ChannelsTree::branch {
  background: transparent;
}
QHeaderView::section {
  background: {{panel-bg}}; color: {{panel-muted}};
  border: none; border-bottom: 1px solid {{panel-border}};
  padding: 7px 8px;
  font-size: 11px; font-weight: 700;
  text-transform: uppercase;
}
/* @end */

/* @section displays.frosted_footer */
QFrame#DisplaysFrostedFooter {
  background: rgba(255,255,255,0.55);
  border: none;
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section displays.splitter */
/* No ::handle — Qt 6.2 QCss::Selector can SEGV on pseudo-elements during resize. */
QSplitter { background: transparent; }
/* @end */

/* @section image.compact_pick_button */
QPushButton {
  background: rgba(255,255,255,0.70); color: {{accent-pressed}};
  border: 1px solid {{accent}}; border-radius: 6px;
  padding: 0 6px; min-height: 0; max-height: 20px;
  font-weight: 600; font-size: 11px;
}
QPushButton:hover {
  background: rgba(255,255,255,0.92); color: {{accent}};
  border-color: {{accent-soft}};
}
QPushButton:pressed { background: rgba(224,242,254,0.80); }
/* @end */

/* @section image.overlay_card */
QFrame#{{name}} {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: 10px;
}
/* @end */

/* @section image.settings_check */
QCheckBox { color: {{text}}; font-size: 12px; spacing: 8px; }
QCheckBox:hover { color: {{accent}}; }
/* @end */

/* @section image.floating_chrome */
QWidget#ImageFloatingChrome {
  background: transparent;
}
QWidget#ImageFloatingChrome QToolButton {
  color: {{text}};
  background: transparent;
  border: 1px solid transparent;
  border-radius: 7px;
  padding: 3px 8px;
  font-size: 11px;
  font-weight: 600;
}
QWidget#ImageFloatingChrome QToolButton:hover {
  background: rgba(255,255,255,90);
  border-color: {{accent-a70}};
}
QWidget#ImageFloatingChrome QToolButton:checked {
  background: rgba(204,251,241,120);
  border-color: {{accent}};
  color: {{accent}};
}
QWidget#ImageFloatingChrome QLabel {
  color: {{muted}};
  background: transparent;
  font-size: 11px;
}
QWidget#ImageFloatingChrome QDoubleSpinBox,
QWidget#ImageFloatingChrome QSpinBox {
  color: {{text}};
  background: rgba(255,255,255,70);
  border: 1px solid {{accent-a55}};
  border-radius: 6px;
  padding: 1px 6px;
  font-size: 11px;
}
QWidget#ImageFloatingChrome QDoubleSpinBox::up-button,
QWidget#ImageFloatingChrome QDoubleSpinBox::down-button,
QWidget#ImageFloatingChrome QSpinBox::up-button,
QWidget#ImageFloatingChrome QSpinBox::down-button {
  width: 0;
  height: 0;
  border: none;
  background: transparent;
}
QWidget#ImageFloatingChrome QSlider::groove:horizontal {
  height: 4px;
  background: {{accent-a14}};
  border-radius: 2px;
}
QWidget#ImageFloatingChrome QSlider::handle:horizontal {
  width: 12px;
  margin: -5px 0;
  background: {{accent}};
  border-radius: 6px;
}
/* @end */

/* @section image.floating_reveal */
QToolButton#ImageFloatingReveal {
  color: transparent;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  min-width: 40px;
  max-width: 40px;
  min-height: 18px;
  max-height: 18px;
}
QToolButton#ImageFloatingReveal:hover,
QToolButton#ImageFloatingReveal:pressed,
QToolButton#ImageFloatingReveal:checked {
  background: transparent;
  border: none;
}
/* @end */

/* @section log.list_container */
QFrame { background: #ffffff; }
/* @end */

/* @section log.log_view */
LogViewWidget { background: #ffffff; }
/* @end */

/* @section log.view_widget */
LogViewWidget { background: #ffffff; }
/* @end */

/* @section plot.add_series_button */
QPushButton {
  background: {{accent}}; color: white; border: none;
  border-radius: 11px; font-weight: 700; font-size: 14px;
  padding: 0; min-height: 0; max-height: 22px;
}
QPushButton:hover { background: {{accent}}; }
/* @end */

/* @section plot.color_swatch */
background:{{color}}; border:1px solid palette(mid); border-radius:2px;
/* @end */

/* @section plot.segmented_toggle_inline */
QWidget#plot_segmented_toggle {
  background: rgba(241,245,249,0.85); border: 1px solid {{border}};
  border-radius: 8px; padding: 2px;
}
QWidget#plot_segmented_toggle QPushButton {
  border: none; padding: 2px 10px; background: transparent;
  border-radius: 6px; color: {{muted}}; font-weight: 600; font-size: 11px;
  min-height: 18px; max-height: 18px;
}
QWidget#plot_segmented_toggle QPushButton:checked {
  background: {{accent}}; color: #FFFFFF; font-weight: 700;
}
QWidget#plot_segmented_toggle QPushButton:hover {
  background: rgba(255,255,255,0.55); color: {{accent}};
}
/* @end */

/* @section plot.series_card */
QFrame#plot_series_card {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: 8px;
}
/* @end */

/* @section plot.series_title */
font-weight: 600; font-size: 11px; color: {{accent}};
/* @end */

/* @section publish.action_vline */
background: {{glass-rim}};
/* @end */

/* @section publish.advanced_check */
QCheckBox {
  color: {{muted}};
  spacing: 6px;
  background: transparent;
  font-size: 12px;
  font-weight: 600;
}
/* @end */

/* @section publish.field_label */
color: {{muted}}; font-size: 11px; font-weight: 600;
/* @end */

/* @section publish.field_tree */
QTreeWidget {
  background: transparent;
  alternate-background-color: transparent;
  color: {{text}};
  border: none;
  outline: none;
  show-decoration-selected: 0;
}
QTreeWidget::item {
  padding: 3px 8px;
  min-height: 26px;
  border: none;
  outline: none;
  background: transparent;
}
QTreeWidget::item:hover {
  background: {{accent-a10}};
  border-radius: 6px;
}
QTreeWidget::item:selected {
  background: {{accent-a16}};
  color: {{accent}};
  border-radius: 6px;
}
QHeaderView::section {
  background: {{glass-fill}};
  color: {{muted}};
  border: none;
  border-bottom: 1px solid {{glass-rim}};
  border-right: 1px solid {{glass-rim}};
  padding: 6px 10px;
  font-size: 11px;
  font-weight: 700;
}
/* @end */

/* @section publish.ghost_text_button */
QPushButton {
  color: {{accent}}; background: transparent; border: none;
  border-radius: 8px; padding: 4px 10px; font-weight: 600; font-size: 12px;
  outline: none;
}
QPushButton:hover { background: {{accent-a10}}; color: {{accent-pressed}}; }
QPushButton:disabled { color: {{muted}}; }
/* @end */

/* @section publish.icon_chip_button */
QPushButton {
  background: {{glass-fill}}; color: {{text}};
  border: 1px solid {{glass-rim}}; border-radius: 10px;
  font-size: 14px; font-weight: 700; padding: 0;
  outline: none;
}
QPushButton:hover {
  background: {{glass-deep}}; color: {{accent}}; border-color: {{accent-soft}};
}
QPushButton:pressed { background: {{accent-soft}}; }
QPushButton:disabled {
  color: {{muted}}; background: {{glass-fill}}; border-color: {{glass-rim}};
}
/* @end */

/* @section publish.json_editor */
QPlainTextEdit {
  background: {{editor-bg}}; color: {{text}};
  border: 1px solid {{glass-rim}}; border-radius: 10px;
  padding: 8px;
  selection-background-color: {{accent-a22}};
}
/* @end */

/* @section publish.panel_chrome */
QWidget#PublishEditorContent {
  background: transparent; color: {{text}};
}
QFrame#PublishToolbar, QFrame#PublishCollectionBar {
  background: {{glass-fill}};
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
}
QFrame#PublishTreeCard {
  background: {{glass-fill}};
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
}
QGroupBox {
  background: {{glass-fill}};
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
  margin-top: 10px;
  padding: 14px 10px 10px 10px;
  font-weight: 600;
  color: {{text}};
}
QGroupBox::title {
  subcontrol-origin: margin;
  left: 12px;
  padding: 0 6px;
  color: {{muted}};
}
QTabWidget::pane {
  border: 1px solid {{glass-rim}};
  border-radius: 10px;
  background: {{glass-fill}};
  top: -1px;
}
QTabBar::tab {
  background: transparent;
  color: {{muted}};
  padding: 7px 14px;
  margin-right: 2px;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: {{accent}};
  border-bottom: 2px solid {{accent}};
}
QTabBar::tab:hover { color: {{text}}; }
/* @end */

/* @section publish.panel_root */
PublishPanel, QWidget#PublishPanelContent {
  background: transparent; color: {{text}};
}
/* @end */

/* @section publish.publish_once_button */
QPushButton {
  background: {{btn-bg}}; color: #FFFFFF;
  border: 1px solid {{btn-bg}}; border-radius: 10px;
  padding: 0 16px; min-height: 32px; font-weight: 700; font-size: 13px;
  outline: none;
}
QPushButton:hover { background: {{btn-hover}}; border-color: {{btn-hover}}; }
QPushButton:pressed { background: {{btn-bg}}; }
QPushButton:disabled {
  background: {{glass-deep}}; color: {{muted}}; border-color: {{glass-rim}};
}
/* @end */

/* @section publish.toolbar_combo */
QComboBox {
  background: rgba(255,255,255,0.88); color: {{text}};
  border: 1px solid {{glass-rim}}; border-radius: 10px;
  padding: 2px 8px; min-height: 28px; max-height: 32px;
  font-size: 12px;
}
QComboBox:hover { border-color: {{accent-soft}}; }
QComboBox:focus {
  border: 1.5px solid {{accent}};
  background: rgba(255,255,255,0.96);
}
QComboBox::drop-down {
  subcontrol-origin: padding; subcontrol-position: center right;
  border: none; width: 18px;
}
QComboBox QLineEdit {
  background: transparent; border: none; color: {{text}};
  padding: 0px 2px; min-height: 0px; max-height: 26px;
  selection-background-color: {{accent-a16}};
  selection-color: {{accent}};
}
QComboBox QAbstractItemView {
  background: rgba(255,255,255,0.96); color: {{text}};
  border: 1px solid {{glass-rim}};
  selection-background-color: {{accent-a16}};
  selection-color: {{accent}};
  outline: none;
}
/* @end */

/* @section publish.toolbar_spin */
QDoubleSpinBox {
  background: rgba(255,255,255,0.88); color: {{text}};
  border: 1px solid {{glass-rim}}; border-radius: 10px;
  padding: 2px 6px; min-height: 28px; max-height: 32px;
  font-size: 12px;
}
QDoubleSpinBox:focus {
  border: 1.5px solid {{accent}};
  background: rgba(255,255,255,0.96);
}
/* @end */

/* @section publish.empty_hint */
QLabel {
  color: {{muted}};
  background: {{glass-fill}};
  border: 1px solid {{glass-rim}};
  border-radius: 12px;
  padding: 14px 18px;
  font-size: 12px;
  font-weight: 500;
}
/* @end */

/* @section raw_messages.panel */
QWidget#RawMessagesPanelContent {
  background: {{panel-bg}}; color: {{panel-text}};
}
QFrame#RawMessagesToolbar {
  background: {{panel-surface}};
  border-bottom: 1px solid {{panel-border}};
}
QFrame#RawMessagesTreeCard {
  background: {{panel-surface}};
  border: none;
}
QFrame#RawMessagesFooter {
  background: {{panel-bg}};
  border-top: 1px solid {{panel-border}};
}
/* @end */

/* @section raw_messages.tree */
QTreeWidget#RawMessagesTree {
  background: {{panel-surface}}; color: {{panel-text}}; border: none; outline: none;
  font-size: 12px;
}
QTreeWidget#RawMessagesTree::item {
  padding: 2px 6px; min-height: 24px;
}
QTreeWidget#RawMessagesTree::item:selected {
  background: {{accent-a14}}; color: {{panel-text}};
}
QTreeWidget#RawMessagesTree::item:hover {
  background: rgba(15,23,42,0.04);
}
QTreeWidget#RawMessagesTree::branch {
  background: transparent;
}
QHeaderView::section {
  background: {{panel-bg}}; color: {{panel-muted}};
  border: none; border-bottom: 1px solid {{panel-border}};
  padding: 7px 8px;
  font-size: 11px; font-weight: 700;
}
/* @end */

/* @section service.call_button */
QPushButton { font-weight: 600; padding: 4px 16px; }
/* @end */

/* @section service.call_button_custom */
QPushButton {
  background: {{btn-bg}}; color: palette(button-text); border: none;
  border-radius: 4px; padding: 6px 12px; font-weight: 600;
}
QPushButton:hover { background: {{btn-hover}}; }
QPushButton:disabled { background: palette(mid); color: palette(midlight); }
/* @end */

/* @section service.call_button_palette */
QPushButton {
  background: palette(highlight); color: palette(highlighted-text);
  border: none; border-radius: 4px; padding: 6px 12px; font-weight: 600;
}
QPushButton:hover { background: palette(highlight); }
QPushButton:disabled { background: palette(mid); color: palette(midlight); }
/* @end */

/* @section service.plain_editor */
QPlainTextEdit { background: palette(alternate-base); }
/* @end */

/* @section teleop.arcade_card */
QFrame#TeleopArcadeCard {
  background: rgba(255,255,255,0.42);
  border: 1px solid {{border}};
  border-radius: 18px;
}
/* @end */

/* @section teleop.axis_combo */
QComboBox {
  background: rgba(255,255,255,0.85); color: {{text}};
  border: 1px solid {{border}}; border-radius: 8px;
  padding: 3px 6px; min-height: 22px;
}
QComboBox:focus { border-color: {{accent}}; }
/* @end */

/* @section teleop.axis_name */
color: {{accent}}; font-size: 11px; font-weight: 700;
/* @end */

/* @section teleop.axis_row */
QFrame#TeleopAxisRow {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: 8px;
}
/* @end */

/* @section teleop.axis_spin */
QDoubleSpinBox {
  background: rgba(255,255,255,0.85); color: {{text}};
  border: 1px solid {{border}}; border-radius: 8px;
  padding: 3px 6px; min-height: 22px;
}
QDoubleSpinBox:focus { border-color: {{accent}}; color: {{accent}}; }
/* @end */

/* @section teleop.control_root */
QWidget#TeleopControlContent {
  background: {{wash}}; color: {{text}};
}
/* @end */

/* @section teleop.estop */
QPushButton {
  background: #E11D48;
  border: 1px solid #E11D48;
  border-radius: 12px;
  color: white;
  font-weight: 800;
  font-size: 12px;
  letter-spacing: 1.2px;
  padding: 8px 16px;
}
QPushButton:hover { background: #BE123C; border-color: #BE123C; }
QPushButton:pressed { background: #9F1239; border-color: #9F1239; }
/* @end */

/* @section teleop.header */
QFrame#TeleopHeader {
  background: rgba(255,255,255,0.72);
  border: 1px solid {{border}};
  border-radius: 14px;
}
/* @end */

/* @section teleop.hint */
color: {{muted}}; font-size: 10px; font-weight: 600; letter-spacing: 0.2px;
/* @end */

/* @section teleop.mapping_header */
color: {{muted}}; font-size: 9px; font-weight: 700; letter-spacing: 1.0px;
/* @end */

/* @section teleop.mode_segment */
QFrame#TeleopModeSegment {
  background: rgba(241,245,249,0.95);
  border: 1px solid {{border}};
  border-radius: 10px;
}
/* @end */

/* @section teleop.mode_toggle */
QToolButton {
  background: transparent; color: {{muted}};
  border: none; border-radius: 8px;
  padding: 6px 10px; font-weight: 700; font-size: 11px;
}
QToolButton:checked {
  background: {{accent}}; color: white;
}
QToolButton:hover {
  background: {{accent-a10}}; color: {{accent}};
}
/* @end */

/* @section teleop.pad_caption */
color: {{muted}}; font-size: 11px; font-weight: 700; letter-spacing: 0.6px;
/* @end */

/* @section teleop.panel_root */
TeleopPanel, QWidget#TeleopPanelContent {
  background: {{wash}}; color: {{text}};
}
/* @end */

/* @section teleop.settings_form_check */
QCheckBox { color: {{text}}; font-size: 12px; spacing: 8px; }
QCheckBox:hover { color: {{accent}}; }
/* @end */

/* @section teleop.settings_form_label */
color: {{muted}}; font-size: 11px; font-weight: 600;
/* @end */

/* @section teleop.settings_speed_caption */
color: {{muted}}; font-size: 9px; font-weight: 700; letter-spacing: 1.2px;
/* @end */

/* @section teleop.settings_speed_card */
QFrame#TeleopSettingsSpeedCard {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: 10px;
}
/* @end */

/* @section teleop.settings_speed_spin */
QDoubleSpinBox {
  background: transparent; color: {{text}};
  border: none; padding: 0; font-weight: 600; font-size: 12px;
}
QDoubleSpinBox:focus { color: {{accent}}; }
/* @end */

/* @section teleop.smart_check */
QCheckBox {
  color: {{muted}}; font-size: 11px; font-weight: 700;
  spacing: 6px; padding: 4px 8px;
  background: {{panel-surface}};
  border: 1px solid {{border}}; border-radius: 10px;
}
QCheckBox:checked {
  color: {{accent}}; background: {{accent-soft}};
  border-color: {{accent}};
}
/* Indicator painted by ProxyStyle — QSS backgrounds hide the checkmark. */
QCheckBox:disabled { color: {{muted}}; }
/* @end */

/* @section teleop.speed_caption */
color: {{muted}}; font-size: 9px; font-weight: 700; letter-spacing: 1.6px;
/* @end */

/* @section teleop.speed_card */
QFrame#TeleopSpeedCard {
  background: {{panel-surface}};
  border: 1px solid {{border}};
  border-radius: 14px;
}
/* @end */

/* @section teleop.speed_rule */
background: {{border}}; border: none;
/* @end */

/* @section teleop.speed_spin */
QDoubleSpinBox {
  background: transparent; color: {{text}};
  border: none; padding: 0;
  font-weight: 300; font-size: 22px;
  font-family: 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif;
}
QDoubleSpinBox:focus { color: {{accent}}; }
/* @end */

/* @section teleop.speed_unit */
color: {{muted}}; font-size: 10px; font-weight: 600; letter-spacing: 0.6px;
/* @end */

/* @section teleop.step_button */
QToolButton {
  background: rgba(248,250,252,0.95); color: {{muted}};
  border: 1px solid {{border}}; border-radius: 14px;
  font-size: 15px; font-weight: 500;
}
QToolButton:hover {
  background: {{accent}}; color: white; border-color: {{accent}};
}
QToolButton:pressed {
  background: {{panel-accent-pressed}}; color: white; border-color: {{panel-accent-pressed}};
}
/* @end */

/* @section teleop.sticks_card */
QFrame#TeleopSticksCard {
  background: rgba(255,255,255,0.42);
  border: 1px solid {{border}};
  border-radius: 18px;
}
/* @end */

/* @section tf_tree.detail_body */
QWidget {
  background: {{panel-surface-raised}}; border: 1px solid {{panel-border}}; border-radius: 12px;
}
/* @end */

/* @section tf_tree.detail_panel */
QFrame {
  background: {{panel-bg}};
  border-left: 1px solid {{panel-border}};
}
/* @end */

/* @section tf_tree.detail_type_dynamic */
color: {{panel-accent}}; font-size: 12px; font-weight: 600;
/* @end */

/* @section tf_tree.detail_type_static */
color: #d97706; font-size: 12px; font-weight: 600;
/* @end */

/* @section tf_tree.frame_badge */
color: white; background: {{panel-accent}}; border-radius: 9px;
padding: 3px 8px; font-size: 10px; font-weight: 600;
/* @end */

/* @section tf_tree.panel */
TfTreePanel, QWidget#TfTreePanelContent {
  background: {{panel-bg}}; color: {{panel-text}};
}
/* @end */

/* @section tf_tree.splitter */
QSplitter { background: transparent; }
/* @end */

/* @section tf_tree.tree */
QTreeWidget {
  background: {{panel-surface}}; color: {{panel-text}}; border: none; outline: none;
}
QTreeWidget::item {
  padding: 4px 6px; border-radius: 6px;
}
QTreeWidget::item:selected {
  background: {{accent-a14}}; color: {{panel-text}};
}
QTreeWidget::item:hover {
  background: rgba(15,23,42,0.04);
}
/* @end */

/* @section tf_tree.view_tabs */
QTabWidget::pane {
  border: none; background: {{panel-bg}};
}
QTabBar::tab {
  background: transparent; color: {{panel-muted}};
  padding: 8px 16px; margin-right: 2px;
  border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
  color: {{panel-accent}}; border-bottom: 2px solid {{panel-accent}};
}
QTabBar::tab:hover { color: {{panel-text}}; }
/* @end */

/* @section views.frosted_footer */
QFrame#ViewsFrostedFooter {
  background: {{glass-fill}};
  border: none;
  border-top: 1px solid {{glass-rim}};
}
/* @end */

/* @section views.type_toolbar_label */
color: {{muted}}; font-size: 11px; font-weight: 600; background: transparent;
/* @end */

/* @section views.zero_button */
QPushButton {
  background: {{glass-fill}}; color: {{text}};
  border: 1px solid {{glass-rim}}; border-radius: 8px;
  padding: 0 10px; min-height: 22px; max-height: 22px;
  font-weight: 600; font-size: 11px;
}
QPushButton:hover {
  background: {{glass-deep}}; color: {{accent}};
  border-color: {{accent-soft}};
}
QPushButton:pressed { background: {{accent-soft}}; }
/* @end */
