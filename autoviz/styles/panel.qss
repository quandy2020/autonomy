QPushButton {
  background: {{panel-bg}}; color: {{text}};
  border: 1px solid {{panel-border}}; border-radius: {{r-sm}}px;
  padding: 0 {{space-5}}px; min-height: 22px; max-height: 22px;
  font-weight: 600; font-size: 11px;
}
QPushButton:hover {
  background: {{panel-surface}}; color: {{accent}};
  border-color: {{accent-soft}};
}
