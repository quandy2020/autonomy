/* app/panels_menu — Panels dropdown */

{{root}} {
  background: {{bg}};
  color: {{text}};
  border: 1px solid {{border}};
  border-radius: {{r-sm}}px;
  padding: {{space-3}}px {{space-3}}px;
  min-width: 280px;
  font-family: 'Inter', 'Segoe UI', 'Roboto', 'Noto Sans', sans-serif;
  font-size: 14px;
}
{{root}}::separator {
  height: 1px;
  background: {{sep}};
  margin: {{space-4}}px {{space-8}}px;
}
