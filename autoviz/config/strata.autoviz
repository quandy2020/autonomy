Displays:
  - Channel: ""
    Enabled: true
    Name: Grid
    Properties:
      alpha: 1.0
      cell_count: 20
      cell_size: 1.0
      color: 80;80;80
    Type: Grid
  - Channel: ""
    Enabled: true
    Name: Axes
    Properties:
      length: 1.0
      radius: 0.05
    Type: Axes
  - Channel: /strata/map
    Enabled: true
    Name: Strata Map
    Properties:
      alpha: 1.0
      decimate: 1
    Type: Map
  - Channel: /strata/path
    Enabled: true
    Name: Strata Path
    Properties:
      alpha: 1.0
      color: 80;220;120
      line_width: 0.05
    Type: Path
  - Channel: /strata/poi_markers
    Enabled: true
    Name: Strata POI
    Type: StrataPoi
  - Channel: /strata/robot_markers
    Enabled: true
    Name: Strata Robot
    Properties:
      axis_length: 0.4
      label_height: 0.12
      show_labels: true
      use_status_color: true
    Type: StrataRobot
  - Channel: /strata/markers
    Enabled: true
    Name: Strata Robot FOV
    Properties:
      show_fill: true
      show_outline: true
    Type: StrataFov
  - Channel: /strata/semantic_zones
    Enabled: true
    Name: Strata Semantic Zones
    Properties:
      show_fill: true
      show_labels: true
      show_outline: true
    Type: StrataSemanticZone
  - Channel: ""
    Children:
      - Channel: /strata/markers
        Enabled: true
        Name: Strata Buildings
        Properties:
          mesh_style: solid
        Type: StrataBuilding
      - Channel: /strata/label_bubbles
        Enabled: true
        Name: Strata Label Bubbles
        Type: StrataLabelBubble
      - Channel: /strata/robot_3d_layers
        Enabled: true
        Name: Strata Robot 3D
        Properties:
          axis_length: 0.5
          label_height: 0.1
          show_labels: true
        Type: StrataRobot3D
      - Channel: /strata/iot_bubbles
        Enabled: true
        Name: Strata IoT Bubbles
        Type: StrataIotBubble
      - Channel: /strata/canvas_labels
        Enabled: true
        Name: Strata Canvas Labels
        Properties:
          label_height: 0.1
        Type: StrataCanvasLabel
      - Channel: /strata/pointcloud
        Enabled: true
        Name: Strata Point Cloud
        Properties:
          color: 200;200;200
          color_mode: flat
          color_transform: Flat
          decimate: 1
          decimation: 1
          point_size: 3
          style: Squares
