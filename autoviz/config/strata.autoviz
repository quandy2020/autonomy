      - Channel: /strata/road_graph
        Enabled: true
        Name: Strata Road Graph
        Properties:
          edge_color: 51;204;102
          line_width: 0.04
          node_color: 51;230;77
        Type: StrataRoadGraph
      - Channel: /strata/markers
        Enabled: true
        Name: Strata Markers
        Properties:
          mesh_style: solid
          point_size: 4
        Type: MarkerArray
    Enabled: true
    Name: AAA
    Type: Group
Global:
  ActiveTool: Interact
  BackgroundColor: 48;48;48
  FixedFrame: map
  FrameRate: 30
  RenderBackend: OpenGL
  ShowGrid: true
  Transformer: autoviz/AutolinkTf
  ViewController: Orbit
Toolbar:
