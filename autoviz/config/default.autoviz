ChannelGraphPanels:
  - AutoRefresh: true
    ChannelArrange: 1
    Filter: ""
    HideDeadEndChannels: false
    HideLeafChannels: false
    NeighborhoodMode: true
    ObjectName: ChannelGraphDock
    PrefixFilter: ""
    ProbeEnabled: false
    QuietMode: false
    ServiceArrange: 1
    ShowChannels: true
    ShowEdgeLabels: false
    ShowServices: true
ChannelsBrowser:
  FilterText: ""
  ProbeEnabled: true
  TypeFilter: 0
CurrentView:
  Distance: 25.796239852905273
  FarClipDistance: 1e+05
  FocalShapeFixedSize: true
  FocalShapeSize: 0.05000000074505806
  FpsPitch: 0
  FpsPosition:
    X: 0
    Y: 0
    Z: 2
  FpsYaw: 3.140000104904175
  InvertZAxis: false
  Name: Current
  NearClipDistance: 0.009999999776482582
  Pitch: 1.3700000047683716
  Target:
    X: 1.494583249092102
    Y: -0.0392242930829525
    Z: 0.6067036390304565
  Type: Orbit
  Yaw: -3.094616413116455
Displays:
  - Channel: /joint_states
    Enabled: true
    Name: RobotModel
    Properties:
      alpha: 1.0
      collision_alpha: 0.35
      collision_enabled: false
      color: 180;180;180
      description_channel: /robot_description
      description_source: Topic
      inertia_enabled: false
      mass_enabled: false
      root_link: ""
      show_axes: false
      show_collision: false
      tf_prefix: ""
      update_interval: 0
      urdf_path: ""
      use_urdf_materials: true
      visual_enabled: true
      visual_style: solid
    Type: RobotModel
  - Channel: ""
    Enabled: true
    Name: TF
    Properties:
      all_enabled: true
      auto_scale: true
      filter_blacklist: ""
      filter_whitelist: ""
      frame_enabled.base_footprint: true
      frame_enabled.base_link: true
      frame_enabled.base_scan: true
      frame_enabled.camera_link: true
      frame_enabled.camera_optical_frame: true
      frame_enabled.caster_back_link: true
      frame_enabled.chase_link: true
      frame_enabled.imu_link: true
      frame_enabled.laser_link: true
      frame_enabled.map: true
      frame_enabled.odom: true
      frame_enabled.wheel_left_link: true
      frame_enabled.wheel_right_link: true
      frame_timeout: 15.0
      marker_scale: 1.0
      show_arrows: false
      show_axes: true
      show_names: false
      update_interval: 0.1
    Type: TF
  - Channel: ""
    Enabled: true
    Name: Grid
    Properties:
      alpha: 0.5
      cell_count: 10
      cell_size: 1.0
      color: 160;160;160
      line_style: Lines
      line_width: 0.03
      normal_cell_count: 0
      offset: 0;0;0
      plane: XY
      reference_frame: <Fixed Frame>
    Type: Grid
  - Channel: /points
    Enabled: true
    Name: LidarScan
    Properties:
      alpha: 0.85
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: Intensity
      decay_time: 0
      decimate: 2
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 200000
      min_color: 0;0;0
      point_size: 3
      point_world_size: 0.03
      position_transform: XYZ
      selectable: true
      style: Flat Squares
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
  - Channel: /argus/cloud_registered
    Enabled: true
    Name: ArgusCloudRegistered
    Properties:
      alpha: 0.7
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 0;200;255
      color_transform: FlatColor
      decay_time: 0
      decimate: 1
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 200000
      min_color: 0;0;0
      point_size: 3
      point_world_size: 0.04
      position_transform: XYZ
      selectable: true
      style: Flat Squares
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
  - Channel: /argus/cloud_map
    Enabled: true
    Name: ArgusCloudMap
    Properties:
      alpha: 1.0
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: RGB8
      decay_time: 0
      decimate: 1
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 5000000
      min_color: 0;0;0
      point_size: 2
      point_world_size: 0.05
      position_transform: XYZ
      selectable: true
      style: Points
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
  - Channel: /argus/trajectory
    Enabled: true
    Name: ArgusTrajectory
    Properties:
      alpha: 1.0
      arrive_distance: 0.35
      buffer_length: 1
      color: 0;255;80
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: true
      line_style: Billboards
      line_width: 0.06
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 255;85;255
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: true
    Type: Path
  - Channel: /gt/path
    Enabled: true
    Name: GroundTruthPath
    Properties:
      alpha: 0.9
      arrive_distance: 0.35
      buffer_length: 1
      color: 255;200;0
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: true
      line_style: Billboards
      line_width: 0.05
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 255;85;255
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: true
    Type: Path
  - Channel: /argus/odometry
    Enabled: true
    Name: ArgusOdometry
    Properties:
      alpha: 1.0
      angle_tolerance: 0.1
      color: 255;25;0
      keep: 100
      position_tolerance: 0.1
      shape: Arrow
      show_velocity: true
    Type: Odometry
  - Channel: /gt/odometry
    Enabled: true
    Name: GroundTruthOdometry
    Properties:
      alpha: 1.0
      angle_tolerance: 0.1
      color: 255;25;0
      keep: 100
      position_tolerance: 0.1
      shape: Arrow
      show_velocity: true
    Type: Odometry
  - Channel: /atlas/dense_map_points
    Enabled: true
    Name: dense_map_points PointCloud2
    Properties:
      alpha: 1.0
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: AxisColor
      decay_time: 0
      decimate: 1
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 200000
      min_color: 0;0;0
      point_size: 3.6
      point_world_size: 0.01
      position_transform: XYZ
      selectable: true
      style: Points
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
  - Channel: /atlas/occupancy_grid
    Enabled: false
    Name: occupancy_grid Map
    Properties:
      alpha: 0.85
      color_scheme: map
      decimate: 1
      draw_behind: true
      use_timestamp: false
    Type: Map
  - Channel: /overall/map
    Enabled: true
    Name: map PointCloud2
    Properties:
      alpha: 1.0
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: Intensity
      decay_time: 0
      decimate: 1
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 200000
      min_color: 0;0;0
      point_size: 3
      point_world_size: 0.01
      position_transform: XYZ
      selectable: true
      style: Points
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
