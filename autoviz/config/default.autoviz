Global:
  FixedFrame: map
  ShowGrid: true
  BackgroundColor: 48;48;48
  FrameRate: 30
  ViewController: Orbit
  RenderBackend: OpenGL
Displays:
  - Type: Grid
    Name: Grid
    Channel: ""
    Enabled: true
    Properties:
      reference_frame: "<Fixed Frame>"
      cell_count: "10"
      normal_cell_count: "0"
      cell_size: "1.0"
      line_style: "Lines"
      line_width: "0.03"
      color: "160;160;160"
      alpha: "0.5"
      plane: "XY"
      offset: "0;0;0"
