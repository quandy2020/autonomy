    Y: 0
    Z: 0
  Type: Orbit
  Yaw: 1.5749996900558472
Displays:
  - Channel: /mppi_controller/transformed_global_plan
    Enabled: false
    Name: TransformedPlan
    Properties:
      alpha: 0.55
      arrive_distance: 0.35
      buffer_length: 1
      color: 255;217;61
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: true
      line_style: Billboards
      line_width: 0.04
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 255;217;61
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: false
    Type: Path
  - Channel: /mppi_controller/optimal_path
    Enabled: true
    Name: OptimalTrajectory
    Properties:
      alpha: 0.95
      arrive_distance: 0.35
      buffer_length: 1
      color: 94;240;176
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: true
      line_style: Billboards
      line_width: 0.1
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 94;240;176
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: false
    Type: Path
  - Channel: /joint_states
    Enabled: true
    Name: RobotModel
    Properties:
      alpha: 1.0
      collision_alpha: 0.35
      collision_enabled: false
      color: 180;180;180
      description_channel: /robot_description
      description_source: Topic
      inertia_enabled: false
      mass_enabled: false
      root_link: ""
      show_axes: false
      show_collision: false
      tf_prefix: ""
      update_interval: 0
      urdf_path: ""
      use_urdf_materials: true
      visual_enabled: true
      visual_style: solid
    Type: RobotModel
  - Channel: /camera/depth/points
    Enabled: true
    Name: points PointCloud2
    Properties:
      alpha: 1.0
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: AxisColor
      decay_time: 0
      decimate: 1
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 200000
      min_color: 0;0;0
      point_size: 3
      point_world_size: 0.01
      position_transform: XYZ
      selectable: true
      style: Points
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
  - Channel: ""
    Enabled: true
    Name: Grid
    Properties:
      alpha: 0.12
      cell_count: 50
      cell_size: 1.0
      color: 70;78;98
      line_style: Lines
      line_width: 0.015
      normal_cell_count: 0
      offset: 0;0;0
