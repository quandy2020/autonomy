    YMax: 1
    YMaxRight: 1
    YMin: -1
    YMinRight: -1
RawMessages:
  Channel: ""
  DiffHighlight: true
  Freeze: false
  MessagePath: ""
TeleopPanels:
  - Down:
      Field: 0
      Value: -0.5
    Left:
      Field: 5
      Value: 0.5
    MaxAngularSpeed: 0.5
    MaxLinearSpeed: 0.5
    ObjectName: TeleopDock
    PublishRateHz: 20
    Right:
      Field: 5
      Value: -0.5
    SettingsVisible: false
    SmartTeleop: false
    StickMode: 0
    Stop:
      Field: 0
      Value: 0
    StopOnRelease: true
    Title: Teleop
    Topic: /cmd_vel
    Up:
      Field: 0
      Value: 0.5
TfTreePanels:
  - Filter: ""
    MaxAgeSec: 1
    ObjectName: TfTreeDock
    StaleOnly: false
    TabIndex: 0
Toolbar:
  - Interact
  - MoveCamera
  - Select
  - FocusCamera
  - Measure
  - PoseEstimate
  - NavGoal
  - PublishPoint
Tools:
  - Id: Interact
    Properties:
      client_id: autoviz
      hide_inactive: true
  - Id: Measure
    Properties:
      color: 255;0;0
  - Id: PoseEstimate
    Properties:
      covariance_x: 0.25
      covariance_y: 0.25
      covariance_yaw: 0.0685385
      topic: /initialpose
  - Id: NavGoal
    Properties:
      topic: /goal_pose
  - Id: PublishPoint
    Properties:
      single_click: true
      topic: /clicked_point
  - Id: ScreenshotListener
    Properties:
      screenshot_path: /tmp/autoviz_screenshot.png
Views: ~
