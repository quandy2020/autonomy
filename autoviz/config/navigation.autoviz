  - BackgroundColor: "#0a0a12"
    CalibrationChannel: ""
    ClickPublishChannel: ""
    ColorMax: 255
    ColorMin: 0
    ColorMode: 0
    EnableUndistort: false
    FlipHorizontal: false
    FlipVertical: false
    HoverPublishChannel: ""
    ImageChannel: /camera/depth/image_raw
    LabelScale: 1
    ObjectName: ImageDock_2
    Rotation: 0
    SettingsVisible: false
    StrictTimeSync: false
    Title: Camera
PlotPanels:
  - KeepRatioXy: true
    LockAxisScales: false
    MaxPointsPerSeries: 20000
    MessagePathMode: 1
    ObjectName: PlotDock
    ReferenceTrackerSec: 0
    ReferenceY: 0
    Series:
      - BinaryMaxDtSec: 0.1
        BinaryOp: 0
        Channel: /cmd_vel
        ChannelPattern: ""
        Color: "#3DD6F5"
        CurveStyle: 0
        CustomTimestampPath: ""
        Enabled: true
        FieldPath: twist.linear.x
        Label: cmd vx
        LineSize: auto
        PointSize: 3
        SecondaryChannel: ""
        SecondaryFieldPath: ""
        ShowLine: true
        ShowPoints: false
        TimestampMode: 0
        UseRightY: false
        XChannel: ""
        XFieldPath: ""
        YOffset: 0
        YScale: 1
      - BinaryMaxDtSec: 0.1
        BinaryOp: 0
        Channel: /odom
        ChannelPattern: ""
        Color: "#FF5A5A"
        CurveStyle: 0
        CustomTimestampPath: ""
        Enabled: true
        FieldPath: twist.twist.linear.x
        Label: odom vx
        LineSize: auto
        PointSize: 3
        SecondaryChannel: ""
        SecondaryFieldPath: ""
        ShowLine: true
        ShowPoints: false
        TimestampMode: 0
        UseRightY: false
        XChannel: ""
        XFieldPath: ""
        YOffset: 0
        YScale: 1
    SettingsVisible: false
    SettingsWidth: 280
    ShowGrid: true
    ShowLegend: true
    ShowLegendValues: true
    ShowReferenceTracker: false
    ShowReferenceY: false
    SyncCursor: true
    SyncGroup: default
    SyncWithOtherPlots: true
    SyncYAxis: false
    Title: Linear X
    XAxisMode: 0
    XWindowSec: 12
    YAutoScale: true
    YAutoScaleRight: true
    YMax: 1
    YMaxRight: 1
    YMin: 0
    YMinRight: 0
  # Yaw rate lives on angular.z — planar robots keep linear.z == 0.
  - KeepRatioXy: true
    LockAxisScales: false
    MaxPointsPerSeries: 20000
    MessagePathMode: 1
    ObjectName: PlotDock_2
    ReferenceTrackerSec: 0
    ReferenceY: 0
    Series:
      - BinaryMaxDtSec: 0.1
        BinaryOp: 0
        Channel: /cmd_vel
        ChannelPattern: ""
        Color: "#3DD6F5"
        CurveStyle: 0
        CustomTimestampPath: ""
        Enabled: true
        FieldPath: twist.angular.z
        Label: cmd wz
        LineSize: auto
        PointSize: 3
        SecondaryChannel: ""
        SecondaryFieldPath: ""
        ShowLine: true
        ShowPoints: false
        TimestampMode: 0
        UseRightY: false
        XChannel: ""
        XFieldPath: ""
        YOffset: 0
        YScale: 1
      - BinaryMaxDtSec: 0.1
        BinaryOp: 0
        Channel: /odom
        ChannelPattern: ""
        Color: "#FFB454"
        CurveStyle: 0
        CustomTimestampPath: ""
        Enabled: true
        FieldPath: twist.twist.angular.z
        Label: odom wz
        LineSize: auto
        PointSize: 3
        SecondaryChannel: ""
        SecondaryFieldPath: ""
        ShowLine: true
        ShowPoints: false
        TimestampMode: 0
        UseRightY: false
        XChannel: ""
        XFieldPath: ""
        YOffset: 0
        YScale: 1
    SettingsVisible: false
    SettingsWidth: 300
    ShowGrid: true
    ShowLegend: true
    ShowLegendValues: true
    ShowReferenceTracker: false
    ShowReferenceY: false
    SyncCursor: true
    SyncGroup: default
    SyncWithOtherPlots: true
    SyncYAxis: false
    Title: Angular Z
    XAxisMode: 0
    XWindowSec: 12
    YAutoScale: true
