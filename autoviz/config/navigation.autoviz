ChannelGraphPanels:
  - AutoRefresh: true
    ChannelArrange: 1
    Filter: ""
    HideDeadEndChannels: false
    HideLeafChannels: false
    NeighborhoodMode: true
    ObjectName: ChannelGraphDock
    PrefixFilter: ""
    ProbeEnabled: false
    QuietMode: false
    ServiceArrange: 1
    ShowChannels: true
    ShowEdgeLabels: false
    ShowServices: true
ChannelsBrowser:
  FilterText: ""
  ProbeEnabled: true
  TypeFilter: 0
CurrentView:
  Distance: 14.269590377807617
  FarClipDistance: 1e+05
  FocalShapeFixedSize: true
  FocalShapeSize: 0.05000000074505806
  FpsPitch: 0
  FpsPosition:
    X: 0
    Y: 2
    Z: 8
  FpsYaw: 3.140000104904175
  InvertZAxis: false
  Name: Current
  NearClipDistance: 0.009999999776482582
  Pitch: 1.399999976158142
  Target:
    X: -3.6294054985046387
    Y: 1.5186899900436401
    Z: 0.4550795555114746
  Type: Orbit
  Yaw: 7.855011463165283
Displays:
  - Channel: ""
    Enabled: true
    Name: Grid
    Properties:
      alpha: 0.12
      cell_count: 50
      cell_size: 1.0
      color: 70;78;98
      line_style: Lines
      line_width: 0.015
      normal_cell_count: 0
      offset: 0;0;0
      plane: XY
      reference_frame: <Fixed Frame>
    Type: Grid
  - Channel: /map
    Enabled: true
    Name: OccupancyMap
    Properties:
      alpha: 0.55
      color_scheme: map
      decimate: 1
      draw_behind: true
      use_timestamp: false
    Type: Map
  - Channel: /global_costmap
    Enabled: false
    Name: GlobalCostmap
    Properties:
      alpha: 0.25
      color_scheme: costmap
      decimate: 2
      draw_behind: true
      use_timestamp: false
    Type: Map
  - Channel: /local_costmap
    Enabled: true
    Name: LocalCostmap
    Properties:
      alpha: 0.20
      color_scheme: costmap
      decimate: 1
      draw_behind: false
      use_timestamp: false
    Type: Map
  - Channel: /points
    Enabled: false
    Name: LidarCloud
    Properties:
      alpha: 0.55
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: Axis
      decay_time: 0
      decimate: 4
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 60000
      min_color: 0;0;0
      point_size: 2
      point_world_size: 0.02
      position_transform: XYZ
      selectable: true
      style: Points
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
  - Channel: /plan
    Enabled: true
    Name: GlobalPlan
    Properties:
      alpha: 0.96
      arrive_distance: 0.35
      buffer_length: 1
      color: 61;214;245
      dash_length: 0.26
      flow_arrow_size: 0.16
      flow_arrow_spacing: 0.48
      flow_speed: 1.05
      gap_length: 0.11
      hide_when_arrived: true
      line_style: Billboards
      line_width: 0.11
      offset: 0;0;0
      path_pattern: FlowDashed
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 61;214;245
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: true
    Type: Path
  - Channel: /mppi_controller/transformed_global_plan
    Enabled: true
    Name: TransformedPlan
    Properties:
      alpha: 0.28
      arrive_distance: 0.35
      buffer_length: 1
      color: 140;190;220
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: true
      line_style: Lines
      line_width: 0.025
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 255;85;255
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: true
    Type: Path
  - Channel: /mppi_controller/candidate_trajectories
    Enabled: true
    Name: MppiCandidates
    Properties:
      color: 200;200;200
      mesh_style: solid
      point_size: 1.8
      use_custom_color: false
    Type: MarkerArray
  - Channel: /mppi_controller/optimal_path
    Enabled: true
    Name: OptimalTrajectory
    Properties:
      alpha: 0.90
      arrive_distance: 0.35
      buffer_length: 1
      color: 94;240;176
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: true
      line_style: Billboards
      line_width: 0.08
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 255;85;255
      pose_style: None
      prune_behind_robot: true
      robot_frame: base_link
      show_flow_arrows: true
    Type: Path
  - Channel: /joint_states
    Enabled: true
    Name: RobotModel
    Properties:
      alpha: 1.0
      collision_alpha: 0.35
      collision_enabled: false
      color: 180;180;180
      description_channel: /robot_description
      description_source: Topic
      inertia_enabled: false
      mass_enabled: false
      root_link: ""
      show_axes: false
      show_collision: false
      tf_prefix: ""
      update_interval: 0
      urdf_path: ""
      use_urdf_materials: true
      visual_enabled: true
      visual_style: solid
    Type: RobotModel
  - Channel: /odom
    Enabled: true
    Name: RobotPose
    Properties:
      alpha: 1.0
      angle_tolerance: 0.1
      color: 107;168;255
      keep: 1
      position_tolerance: 0.1
      shape: Arrow
      show_velocity: true
    Type: Odometry
  - Channel: /scan
    Enabled: true
    Name: SensorFov
    Properties:
      alpha: 0.10
      color: 120;175;230
      color_transform: Flat
      decay_time: 0
      point_size: 1.5
      style: Points
    Type: LaserScan
  - Channel: /odom
    Enabled: true
    Name: MotionTrail
    Properties:
      alpha: 0.95
      duration: 12.0
      frame: base_link
      glow_layers: 2
      glow_width: 0.20
      line_color: 140;120;255
      line_width: 0.065
      min_distance: 0.025
      z_lift: 0.10
    Type: TFTrajectory
  - Channel: /odom
    Enabled: false
    Name: OdomHistory
    Properties:
      alpha: 0.55
      angle_tolerance: 0.1
      color: 94;240;176
      keep: 40
      position_tolerance: 0.1
      shape: Arrow
      show_velocity: true
    Type: Odometry
  - Channel: /goal_pose
    Enabled: true
    Name: NavGoalRings
    Properties:
      alpha: 1.0
      arrive_morph_sec: 0.85
      auto_clear: true
      auto_clear_distance: 0.30
      axis_length: 0.25
      color: 255;180;84
      heading_length: 0.40
      inner_radius: 0.32
      inner_width: 0.12
      outer_color: 255;210;140
      outer_radius: 0.72
      outer_width: 0.085
      rings: 72
      robot_frame: base_link
      show_axes: false
      show_heading: true
      success_color: 80;220;120
      success_hold_sec: 1.40
      z_lift: 0.16
    Type: TargetVisualizer
  - Channel: ""
    Enabled: false
    Name: TF
    Properties:
      all_enabled: true
      auto_scale: true
      filter_blacklist: ""
      filter_whitelist: ""
      frame_timeout: 15.0
      marker_scale: 1.0
      show_arrows: false
      show_axes: true
      show_names: false
      update_interval: 0
    Type: TF
  - Channel: /camera/depth/points
    Enabled: true
    Name: points PointCloud2
    Properties:
      alpha: 1.0
      autocompute_intensity_bounds: true
      autocompute_value_bounds: true
      axis: Z
      axis_max: 10
      axis_min: -10
      channel_name: intensity
      color: 255;255;255
      color_transform: AxisColor
      decay_time: 0
      decimate: 1
      intensity_max: 4096
      intensity_min: 0
      invert_rainbow: false
      max_color: 255;255;255
      max_points: 200000
      min_color: 0;0;0
      point_size: 5
      point_world_size: 0.01
      position_transform: XYZ
      selectable: true
      style: Points
      use_fixed_frame: true
      use_rainbow: true
    Type: PointCloud2
Global:
  ActiveTool: Interact
  BackgroundColor: 22;26;36
  FixedFrame: map
  FrameRate: 30
  RenderBackend: Ogre
  TimeSyncMode: 0
  TimeSyncSource: ""
  Transformer: autoviz/AutolinkTf
  ViewController: Orbit
ImagePanels:
  - BackgroundColor: "#0a0a12"
    CalibrationChannel: ""
    ClickPublishChannel: ""
    ColorMax: 255
    ColorMin: 0
