ChannelGraphPanels:
  - AutoRefresh: true
    ChannelArrange: 1
    Filter: ""
    HideDeadEndChannels: false
    HideLeafChannels: false
    NeighborhoodMode: true
    ObjectName: ChannelGraphDock
    PrefixFilter: ""
    ProbeEnabled: false
    QuietMode: false
    ServiceArrange: 1
    ShowChannels: true
    ShowEdgeLabels: false
    ShowServices: true
ChannelsBrowser:
  FilterText: ""
  ProbeEnabled: true
  TypeFilter: 0
CurrentView:
  Distance: 29.657014846801758
  FarClipDistance: 1e+05
  FocalShapeFixedSize: true
  FocalShapeSize: 0.05000000074505806
  FpsPitch: 0
  FpsPosition:
    X: -4.579870223999023
    Y: 3.181950569152832
    Z: 8.129056930541992
  FpsYaw: 3.140000104904175
  InvertZAxis: false
  Name: Current
  NearClipDistance: 0.009999999776482582
  Pitch: 1.399999976158142
  Target:
    X: -3.6391327381134033
    Y: 2.165369749069214
    Z: 0
  TargetFrame: map
  Type: Orbit
  Yaw: 0.5500002503395081
Displays:
  - Channel: ""
    Enabled: true
    Name: TF
    Properties:
      all_enabled: true
      auto_scale: false
      filter_blacklist: ""
      filter_whitelist: ""
      frame_enabled.base_link: true
      frame_enabled.horizontal_laser_link: true
      frame_enabled.imu_link: true
      frame_enabled.map: true
      frame_enabled.odom: true
      frame_enabled.vertical_laser_link: true
      frame_timeout: 15.0
      marker_scale: 12.0
      show_arrows: false
      show_axes: true
      show_names: true
      update_interval: 0.1
    Type: TF
  - Channel: ""
    Enabled: true
    Name: Grid
    Properties:
      alpha: 0.35
      cell_count: 20
      cell_size: 5.0
      color: 160;160;160
      line_style: Lines
      line_width: 0.03
      normal_cell_count: 0
      offset: 0;0;0
      plane: XY
      reference_frame: <Fixed Frame>
    Type: Grid
  - Channel: /map
    Enabled: true
    Name: OccupancyMap
    Properties:
      alpha: 0.7
      color_scheme: map
      decimate: 1
      draw_behind: true
      use_timestamp: false
    Type: Map
  - Channel: /submap_list
    Enabled: false
    Name: Submaps
    Properties:
      submap_query_service: /submap_query
      tracking_frame: base_link
      high_resolution: true
      low_resolution: false
      show_axes: true
      show_ids: true
      trajectory_id: -1
      alpha: 1.0
      fade_distance: 1.0
    Type: Submaps
  - Channel: /echoes_1
    Enabled: true
    Name: LaserScan
    Properties:
      alpha: 1.0
      color: 0;220;255
      color_transform: Flat
      decay_time: 0
      point_size: 8
      style: Flat Squares
    Type: LaserScan
  - Channel: /tracked_pose
    Enabled: true
    Name: TrackedPose
    Properties:
      alpha: 1.0
      axis_length: 0.3
      axis_radius: 0.03
      color: 255;100;0
      head_diameter: 0.16
      head_length: 0.2
      shaft_diameter: 0.08
      shaft_length: 0.6
      shape: Arrow
    Type: Pose
  - Channel: /trajectory
    Enabled: true
    Name: Trajectory
    Properties:
      alpha: 1.0
      arrive_distance: 0.35
      buffer_length: 1
      color: 0;255;80
      dash_length: 0.28
      flow_arrow_size: 0.12
      flow_arrow_spacing: 0.55
      flow_speed: 0.9
      gap_length: 0.18
      hide_when_arrived: false
      line_style: Lines
      line_width: 0.12
      offset: 0;0;0
      path_pattern: Solid
      pose_arrow_head_diameter: 0.3
      pose_arrow_head_length: 0.2
      pose_arrow_shaft_diameter: 0.1
      pose_arrow_shaft_length: 0.1
      pose_axes_length: 0.3
      pose_axes_radius: 0.03
      pose_color: 255;85;255
      pose_style: None
      prune_behind_robot: false
      robot_frame: base_link
      show_flow_arrows: true
    Type: Path
Global:
  ActiveTool: Interact
  BackgroundColor: 48;48;48
  FixedFrame: map
  FrameRate: 30
  RenderBackend: Ogre
  TimeSyncMode: 0
  TimeSyncSource: ""
  Transformer: autoviz/AutolinkTf
  ViewController: Orbit
