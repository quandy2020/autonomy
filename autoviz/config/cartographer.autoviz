    Properties:
      client_id: autoviz
      hide_inactive: true
  - Id: Measure
    Properties:
      color: 255;0;0
  - Id: PoseEstimate
    Properties:
      covariance_x: 0.25
      covariance_y: 0.25
      covariance_yaw: 0.0685385
