#!/bin/bash
# AppRun for Autoviz Linux bundles (AppImage / relocatable AppDir).
set -euo pipefail

if [ -z "${APPDIR:-}" ]; then
  if command -v readlink >/dev/null 2>&1 && readlink -f / >/dev/null 2>&1; then
    APPDIR="$(dirname "$(readlink -f "$0")")"
  else
    APPDIR="$(cd "$(dirname "$0")" && pwd -P)"
  fi
fi
export APPDIR

# Prefer the staged wrapper (sets Ogre/media + private lib path).
if [ -x "${APPDIR}/bin/autoviz" ]; then
  exec "${APPDIR}/bin/autoviz" "$@"
fi

# Legacy layout fallback.
ARCH=$(uname -m)
case "$ARCH" in
  x86_64)  MULTIARCH="x86_64-linux-gnu" ;;
  aarch64) MULTIARCH="aarch64-linux-gnu" ;;
  *)       MULTIARCH="" ;;
esac

if [ -n "$MULTIARCH" ]; then
  export LD_LIBRARY_PATH="${APPDIR}/lib/autoviz:${APPDIR}/lib:${APPDIR}/lib/${MULTIARCH}:/usr/lib/${MULTIARCH}:/lib/${MULTIARCH}:${LD_LIBRARY_PATH:-}"
else
  export LD_LIBRARY_PATH="${APPDIR}/lib/autoviz:${APPDIR}/lib:/usr/lib64:/usr/lib:${LD_LIBRARY_PATH:-}"
fi

export AUTOVIZ_RESOURCE_PATH="${AUTOVIZ_RESOURCE_PATH:-${APPDIR}/share/autonomy:${APPDIR}/share}"
export AUTOVIZ_OGRE_MEDIA_PATH="${AUTOVIZ_OGRE_MEDIA_PATH:-${APPDIR}/share/autonomy/autoviz/ogre_media}"
export AUTOVIZ_OGRE_PLUGIN_DIR="${AUTOVIZ_OGRE_PLUGIN_DIR:-${APPDIR}/lib/autoviz/ogre}"
export AUTOVIZ_PLUGIN_PATH="${AUTOVIZ_PLUGIN_PATH:-${APPDIR}/lib/autoviz_plugins}"

AUTOVIZ_BIN="${APPDIR}/lib/autoviz/autoviz"
if [ ! -x "$AUTOVIZ_BIN" ]; then
  AUTOVIZ_BIN="${APPDIR}/bin/autoviz"
fi
if [ ! -x "$AUTOVIZ_BIN" ]; then
  echo "Error: autoviz binary not found under ${APPDIR}" >&2
  exit 1
fi

if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
  export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
fi

exec "$AUTOVIZ_BIN" "$@"
