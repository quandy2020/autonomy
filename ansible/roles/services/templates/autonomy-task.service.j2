[Unit]
Description=Autonomy task server (scheduler + behavior trees)
Documentation=https://github.com/quandy2020/autonomy
After=network-online.target{{ ' autonomy-localization.service' if 'localization' in autonomy_services else '' }}
Wants=network-online.target{{ ' autonomy-localization.service' if 'localization' in autonomy_services else '' }}

[Service]
Type=simple
User={{ autonomy_user }}
Group={{ autonomy_user }}
Environment=GLOG_log_dir={{ autonomy_log_dir }}
Environment=AUTONOMY_PATH={{ autonomy_install_prefix }}
Environment=AUTOLINK_DISTRIBUTION_HOME={{ autonomy_install_prefix }}
Environment=AUTOLINK_PATH={{ autonomy_install_prefix }}/share/autolink
Environment=AUTONOMY_BT_PLUGIN_PATH={{ autonomy_install_prefix }}/lib
Environment=LD_LIBRARY_PATH={{ autonomy_install_prefix }}/lib:/usr/local/lib
WorkingDirectory={{ autonomy_data_dir }}
ExecStart={{ autonomy_install_prefix }}/bin/autonomy.task \
  --config_directory={{ autonomy_task_config_directory }}
Restart=on-failure
RestartSec=5
TimeoutStopSec={{ autonomy_service_timeout_stop_sec }}
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autonomy-task

[Install]
WantedBy=multi-user.target
