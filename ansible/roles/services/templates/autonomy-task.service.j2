[Unit]
Description=Autonomy task server (scheduler + behavior trees)
Documentation=https://github.com/quandy2020/autonomy
After=network-online.target autonomy-localization.service
Wants=network-online.target autonomy-localization.service

[Service]
Type=simple
User={{ autonomy_user }}
Group={{ autonomy_user }}
Environment=AUTOLINK_PATH={{ autonomy_install_prefix }}/share/autolink
Environment=LD_LIBRARY_PATH={{ autonomy_install_prefix }}/lib:/usr/local/lib
WorkingDirectory={{ autonomy_data_dir }}
ExecStart={{ autonomy_install_prefix }}/bin/task \
  --config_directory={{ autonomy_task_config_directory }}
Restart=on-failure
RestartSec=5
StandardOutput=append:{{ autonomy_log_dir }}/task.log
StandardError=append:{{ autonomy_log_dir }}/task.log

[Install]
WantedBy=multi-user.target
