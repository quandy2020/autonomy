[Unit]
Description=Autonomy localization (Cartographer SLAM)
Documentation=https://github.com/quandy2020/autonomy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ autonomy_user }}
Group={{ autonomy_user }}
Environment=AUTOLINK_PATH={{ autonomy_install_prefix }}/share/autolink
Environment=LD_LIBRARY_PATH={{ autonomy_install_prefix }}/lib:/usr/local/lib
WorkingDirectory={{ autonomy_data_dir }}
ExecStart={{ autonomy_install_prefix }}/bin/localization \
  --configuration_directory={{ autonomy_localization_configuration_directory }} \
  --configuration_basename={{ autonomy_localization_configuration_basename }}
Restart=on-failure
RestartSec=5
TimeoutStopSec={{ autonomy_service_timeout_stop_sec }}
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autonomy-localization

[Install]
WantedBy=multi-user.target
