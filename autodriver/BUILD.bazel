"""Standalone Bazel build for autodriver."""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/bazel:chassis.bzl", "chassis_plugin")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Generated conf.hpp  (#include "autodriver/conf/conf.hpp")
# ---------------------------------------------------------------------------

genrule(
    name = "generate_conf",
    srcs = [
        "config/conf.hpp.in",
        "version.json",
    ],
    outs = ["conf/conf.hpp"],
    cmd = "python3 $(location //tools/bazel:gen_conf.py) $(location config/conf.hpp.in) $(location version.json) $@",
    tools = ["//tools/bazel:gen_conf.py"],
)

cc_library(
    name = "conf",
    hdrs = [":generate_conf"],
    include_prefix = "autodriver",
)

filegroup(
    name = "runtime_files",
    srcs = glob(
        [
            "config/**/*.yaml",
            "config/**/*.yml",
            "config/**/*.json",
            "dag/**",
            "launch/**",
        ],
        allow_empty = True,
    ),
)

# ---------------------------------------------------------------------------
# Core library
# ---------------------------------------------------------------------------

CORE_EXCLUDES = [
    # Optional RealSense stream drivers (need librealsense2).
    "autodriver/camera/realsense/imu_driver.cpp",
    "autodriver/camera/realsense/camera_driver.cpp",
    "autodriver/camera/realsense/pointcloud_driver.cpp",
    # Chassis plugins are separate shared objects.
    "chassis/jetauto/**",
    "chassis/l1w/**",
    "**/test/**",
    "**/testing/**",
]

cc_library(
    name = "autodriver",
    srcs = glob(
        [
            "autodriver/**/*.cpp",
            "chassis/*.cpp",
            "chassis/stub/*.cpp",
        ],
        exclude = CORE_EXCLUDES,
    ),
    hdrs = glob(
        [
            "autodriver/**/*.hpp",
            "autodriver/**/*.h",
            "chassis/*.hpp",
            "chassis/stub/*.hpp",
            "chassis/jetauto/*.hpp",
            "chassis/l1w/*.hpp",
        ],
        exclude = ["**/test/**"],
        allow_empty = True,
    ),
    deps = [
        ":conf",
        "//tools/bazel:eigen",
        "//tools/bazel:fkYAML",
        "//tools/bazel:glog",
        "//tools/bazel:protobuf",
        "//tools/bazel:pthread",
        "//tools/bazel:udev",
        "@autolink//:autolink",
        "@prefix//:automsgs",
    ],
)

# ---------------------------------------------------------------------------
# Binary
# ---------------------------------------------------------------------------

cc_binary(
    name = "autodriver_bin",
    srcs = [
        "main.cpp",
        "options.cpp",
        "options.hpp",
    ],
    data = [":runtime_files"],
    deps = [
        ":autodriver",
        "@cli11//:cli11",
    ],
)

# CMake OUTPUT_NAME is "autodriver"; keep a friendly alias.
alias(
    name = "autodriver_main",
    actual = ":autodriver_bin",
)

# ---------------------------------------------------------------------------
# Chassis plugins  (libautodriver_{jetauto,l1w}.so)
# ---------------------------------------------------------------------------

chassis_plugin(
    name = "jetauto",
    srcs = [
        "chassis/jetauto/driver.cpp",
        "chassis/jetauto/jetauto_component.cpp",
        "chassis/jetauto/kinematics.cpp",
        "chassis/jetauto/rrc_protocol.cpp",
    ],
    hdrs = glob(["chassis/jetauto/*.hpp"], allow_empty = True),
)

chassis_plugin(
    name = "l1w",
    srcs = [
        "chassis/l1w/driver.cpp",
        "chassis/l1w/l1w_component.cpp",
    ],
    hdrs = glob(["chassis/l1w/*.hpp"], allow_empty = True),
)

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

cc_test(
    name = "test_joy_mapper",
    size = "small",
    srcs = ["test/test_joy_mapper.cpp"],
    deps = [
        ":autodriver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_chassis_abstractions",
    size = "small",
    srcs = ["test/test_chassis_abstractions.cpp"],
    deps = [
        ":autodriver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_chassis_backend_registry",
    size = "small",
    srcs = ["test/test_chassis_backend_registry.cpp"],
    deps = [
        ":autodriver",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_jetauto_kinematics",
    size = "small",
    srcs = ["test/test_jetauto_kinematics.cpp"],
    deps = [
        ":autodriver",
        ":jetauto_lib",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_l1w_driver",
    size = "small",
    srcs = ["test/test_l1w_driver.cpp"],
    deps = [
        ":autodriver",
        ":l1w_lib",
        "@googletest//:gtest_main",
    ],
)
