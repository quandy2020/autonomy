load("//tools/bazel:system_libs.bzl", "system_library")

package(default_visibility = ["//visibility:public"])

# ---------------------------------------------------------------------------
# Scripts + repo BUILD templates (read by //tools/bazel:deps.bzl)
# ---------------------------------------------------------------------------

exports_files([
    "gen_conf.py",
    "prefix.BUILD",
    "autolink.BUILD",
    "cli11.BUILD",
    "fkyaml.BUILD",
    "deps.bzl",
])

# ---------------------------------------------------------------------------
# BCR / vendored / system libraries
# ---------------------------------------------------------------------------

alias(
    name = "eigen",
    actual = "@eigen//:eigen",
)

alias(
    name = "fkYAML",
    actual = "@fkYAML//:fkYAML",
)

# Prefer /usr/local (docker SDKs) over older distro libraries.
system_library(
    name = "glog",
    linkopts = [
        "/usr/local/lib/libglog.so",
        "-Wl,-rpath,/usr/local/lib",
    ],
)

system_library(
    name = "protobuf",
    linkopts = [
        "/usr/local/lib/libprotobuf.so",
        "-Wl,-rpath,/usr/local/lib",
    ],
)

system_library(
    name = "pthread",
    linkopts = ["-lpthread"],
)

system_library(
    name = "udev",
    linkopts = ["-ludev"],
    defines = ["AUTODRIVER_HAVE_UDEV"],
)
