# @fkYAML — header-only fkYAML (sibling autolink/thirdparty/fkYAML/include).

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fkYAML",
    hdrs = glob(["include/**/*.hpp"], allow_empty = True),
    includes = ["include"],
)
