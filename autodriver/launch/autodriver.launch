<!--
  Autodriver hardware driver launch file.

  Starts the autodriver binary which loads sensors from
  autodriver_hardware.yaml, creates Autolink writers and manages sensor
  lifecycle (hotplug).

  Prerequisites:
    - AUTODRIVER_PATH must point to the autodriver package root
      (the directory that contains config/autodriver_hardware.yaml)
    - libautodriver.so (and Autolink deps) must be on LD_LIBRARY_PATH
      Built-in sensor modules live inside libautodriver; no per-modality
      plugin .so is required unless YAML sets library=.

  Usage (from the autonomy workspace):
    export AUTODRIVER_PATH=$PWD/autodriver
    export AUTOLINK_LAUNCH_PATH=$PWD/autodriver/launch
    export LD_LIBRARY_PATH=$PWD/build/lib:$LD_LIBRARY_PATH
    export PATH=$PWD/build/bin:$PATH
    autolink launch start autodriver.launch

  To stop:
    autolink launch stop autodriver.launch
-->
<autolink>
    <environment>
        <!--
          Set AUTODRIVER_PATH to the autodriver package root so that
          autodriver can find config/autodriver_hardware.yaml.
          Adjust this path to match your deployment layout.
        -->
        <!-- <AUTODRIVER_PATH>/opt/autodriver</AUTODRIVER_PATH> -->
    </environment>

    <module>
        <name>autodriver</name>
        <type>binary</type>
        <!--
          Arguments: autodriver <config_dir> <config_file>

          When AUTODRIVER_PATH is set in the environment (either exported
          before calling autolink launch, or via <environment> below),
          autodriver reads it automatically — no extra arguments needed.

          To hard-code the config location instead, uncomment and edit:
            <process_name>autodriver /opt/autodriver autodriver_hardware.yaml</process_name>
        -->
        <process_name>autodriver</process_name>
        <!--
          Respawn up to 3 times on unexpected exit so transient hardware
          errors (e.g. USB disconnect) don't take the whole stack down.
        -->
        <exception_handler>respawn</exception_handler>
        <respawn_limit>3</respawn_limit>
    </module>
</autolink>
