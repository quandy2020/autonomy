"""Standalone Bazel module for autodriver (sensor + chassis HAL)."""

module(
    name = "autodriver",
    version = "0.2.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "googletest", version = "1.15.2")

# Sibling autolink headers + CMake prefix (.so / generated automsgs) + Eigen.
# Override prefix: bazel build --repo_env=AUTONOMY_PREFIX=/path/to/prefix ...
autodriver_deps = use_extension("//tools:autodriver_deps.bzl", "autodriver_deps")
use_repo(
    autodriver_deps,
    "autonomy_prefix",
    "local_autolink",
    "local_cli11",
    "system_eigen",
)
