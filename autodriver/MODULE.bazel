"""Standalone Bazel module for autodriver (sensor + chassis HAL)."""

module(
    name = "autodriver",
    version = "0.2.0",
    compatibility_level = 1,
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "googletest", version = "1.15.2")

# Local CMake prefix + sibling headers. Override with AUTONOMY_PREFIX.
deps = use_extension("//tools:deps.bzl", "deps")
use_repo(deps, "prefix", "autolink", "cli11", "eigen")
