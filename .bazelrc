# Common flags for the autonomy workspace (src/autonomy).

common --enable_bzlmod

# Shared flags (Bzlmod, C++20, AUTONOMY_PREFIX / OPENCV_ROOT).
# Canonical C++ standard lives in tools/bazel.rc — do not re-declare -std= here.
try-import %workspace%/tools/bazel.rc

# Sibling shared libs must be findable at runtime / test time.
test --test_env=LD_LIBRARY_PATH
build --action_env=LD_LIBRARY_PATH

# Faster local iteration.
build --incompatible_strict_action_env=false

try-import %workspace%/user.bazelrc
