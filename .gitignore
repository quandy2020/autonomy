.vscode
*.DS_Store
.gitee
__pycache__/
*.py[cod]
*.pyc
*.logs
*.log
*.log.*

# glog / INFO dumps (often huge; never commit)
*.INFO
*.INFO.*
*.WARNING
*.WARNING.*
*.ERROR
*.ERROR.*
*.FATAL
*.FATAL.*
autoviz/*.INFO
autoviz/*.WARNING
autoviz/*.ERROR
autoviz/autoviz*.log*

# clangd / IDE index caches
.cache/
**/.cache/

# https://github.com/github/gitignore/blob/main/ROS.gitignore
devel/
logs/
build/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# eclipse stuff
.project
.cproject

# qcreator stuff
CMakeLists.txt.user

# Generated at configure/build time (see cmake/autonomy_version.cmake)
autonomy/common/version.cpp
# Generated into the build tree; never commit a source-tree copy.
autonomy/common/config.hpp

srv/_*.py
*.pcd
*.pyc
qtcreator-*
*.user

/planning/cfg
/planning/docs
/planning/src

*~

# Catkin custom files
CATKIN_IGNORE

3rdparty/

# Ansible
ansible/.vault_pass
ansible/*.retry
dist/
*.egg-info/

# bag_convert runtime protobuf generation
autonomy/tools/bag_convert/.proto_gen/

# Repo-root runtime/data dumps only (not autonomy/**/data source trees)
/data/

# Large demo/test assets (keep out of git; atlas data/*.cpp sources must remain tracked)
autonomy/map/grid_map/grid_map_demos/data/
autonomy/map/grid_map/grid_map_pcl/test_data/

# Local feature worktrees
.worktrees/

# OrbisView frontend install / build artifacts (never commit)
autonomy/orbisview/frontend/node_modules/
autonomy/orbisview/frontend/dist/
autonomy/orbisview/**/node_modules/
autonomy/orbisview/thirdparty/**/node_modules/
autonomy/orbisview/thirdparty/**/dist/

# Large local inference artifacts (copy into place; do not commit).
config/perception/base/*.engine
config/perception/base/*.plan
config/perception/base/*.onnx
config/perception/base/moge_ckpt/
config/perception/fathom/*.engine
config/perception/fathom/*.plan
config/perception/fathom/*.onnx
