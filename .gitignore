.vscode
*.DS_Store
.gitee
__pycache__/
*.py[cod]
*.pyc
*.logs
*.log
*.log.*

# glog / INFO dumps (often huge; never commit)
*.INFO
*.INFO.*
*.WARNING
*.WARNING.*
*.ERROR
*.ERROR.*
*.FATAL
*.FATAL.*
autoviz/*.INFO
autoviz/*.WARNING
autoviz/*.ERROR
autoviz/autoviz*.log*

# clangd / IDE index caches
.cache/
**/.cache/

# https://github.com/github/gitignore/blob/main/ROS.gitignore
devel/
logs/
build/
bin/
lib/
msg_gen/
srv_gen/
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
build_isolated/
devel_isolated/

# Generated by dynamic reconfigure
*.cfgc
/cfg/cpp/
/cfg/*.py

# Ignore generated docs
*.dox
*.wikidoc

# eclipse stuff
.project
.cproject

# qcreator stuff
CMakeLists.txt.user

# Generated at configure/build time (see cmake/generate_version_definitions.cmake)
autonomy/common/version.cpp

srv/_*.py
*.pcd
*.pyc
qtcreator-*
*.user

/planning/cfg
/planning/docs
/planning/src

*~

# Catkin custom files
CATKIN_IGNORE

3rdparty/

# Ansible
ansible/.vault_pass
ansible/*.retry
dist/

# bag_convert runtime protobuf generation
autonomy/tools/bag_convert/.proto_gen/

# data
data/