<package format="3">
  <name>autonomy</name>
  <version>0.2.0</version>
  <description>Autonomy framework: domain libraries, proto, and process entrypoints.</description>
  <maintainer email="quandy2020@126.com">Du YongQuan</maintainer>
  <license>Apache-2.0</license>

  <url>https://github.com/AibotBeginer/autonomy</url>
  <author email="quandy2020@126.com">Du YongQuan</author>

  <buildtool_depend>autocmake</buildtool_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Workspace peers (automsgs / autolink / autodriver) are embedded by the
       root CMakeLists, same pattern as autodriver finding autolink/automsgs. -->
  <build_depend>Eigen3</build_depend>
  <build_depend>nlohmann_json</build_depend>
  <build_depend>gflags</build_depend>
  <build_depend>glog</build_depend>
  <build_depend>yaml-cpp</build_depend>
  <build_depend>Threads</build_depend>
  <build_depend>Ceres</build_depend>
  <build_depend>OSQP</build_depend>

  <export>
    <build_type>autocmake</build_type>
    <build_type>ament_cmake</build_type>
  </export>
</package>
