load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "generate_messages.sh",
    "automsgs_generate_factory.py",
    "automsgs_msgs_generate.py",
    "cli/rpc-cli.py",
])

# Prefer BCR protobuf (aligned with root MODULE.bazel) over /usr/local 3.19.
alias(
    name = "protobuf",
    actual = "@com_google_protobuf//:protobuf",
)

alias(
    name = "protoc_lib",
    actual = "@com_google_protobuf//:protoc_lib",
)

cc_library(
    name = "pthread",
    linkopts = ["-lpthread"],
    linkstatic = True,
)
