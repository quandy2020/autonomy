@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Protobuf REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/automsgsTargets.cmake")

set(AUTOMSGS_LIBRARIES automsgs::automsgs)

if(TARGET automsgs::automsgs)
  get_target_property(_AUTOMSGS_INCLUDE_DIRS automsgs::automsgs INTERFACE_INCLUDE_DIRECTORIES)
  if(_AUTOMSGS_INCLUDE_DIRS)
    set(AUTOMSGS_INCLUDE_DIRS "${_AUTOMSGS_INCLUDE_DIRS}")
  endif()
endif()

check_required_components(automsgs)

